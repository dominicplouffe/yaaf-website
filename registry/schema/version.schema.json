{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaf.dplouffe.ca/marketplace/schema/version.schema.json",
  "title": "yaaf listing version",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "published_at", "changes", "needs"],
  "properties": {
    "id": { "type": "string", "pattern": "^@[a-z0-9][a-z0-9-]{0,38}/[a-z0-9-]{2,64}$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["role", "project"] },
    "published_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "changes": { "type": "string", "minLength": 3, "maxLength": 2000 },
    "role": { "$ref": "#/$defs/role" },
    "bundle": { "$ref": "#/$defs/bundle" },
    "uses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version", "slug"],
        "properties": {
          "id": { "type": "string", "pattern": "^@[a-z0-9][a-z0-9-]{0,38}/[a-z0-9-]{2,64}$" },
          "version": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }
        }
      }
    },
    "needs": { "$ref": "#/$defs/needs" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" }, "maxItems": 20 },
    "receipt": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "role" } } },
      "then": { "required": ["role"], "not": { "anyOf": [{ "required": ["bundle"] }, { "required": ["inputs"] }, { "required": ["receipt"] }, { "required": ["uses"] }] } } },
    { "if": { "properties": { "kind": { "const": "project" } } },
      "then": { "required": ["bundle"], "not": { "required": ["role"] } } }
  ],
  "$defs": {
    "role": {
      "type": "object",
      "required": ["slug", "name", "description", "system_prompt"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
        "name": { "type": "string" },
        "is_ceo_role": { "type": "boolean" },
        "category": { "type": ["string", "null"] },
        "domains": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "system_prompt": { "type": "string", "minLength": 20 },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "harness": { "type": ["string", "null"] },
        "tool_permissions": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "secret_scopes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["yaaf_bundle", "kind", "project", "roles"],
      "properties": {
        "yaaf_bundle": { "const": 1 },
        "kind": { "const": "project_setup" },
        "values_included": { "const": false },
        "project": { "type": "object", "required": ["name", "goal", "teams"] },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "secrets": {
          "type": "array",
          "items": { "type": "object", "not": { "anyOf": [{ "required": ["value"] }, { "required": ["ciphertext"] }] } }
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "data_sources", "mailbox", "github_repo"],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "label", "roles", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
              "label": { "type": "string", "minLength": 3, "maxLength": 120 },
              "format": { "type": "string", "maxLength": 120 },
              "file": { "type": "boolean" },
              "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "required": { "type": "boolean" },
              "help": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "serves", "address", "auth", "access", "tools", "roles", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
              "serves": { "type": "string", "minLength": 3, "maxLength": 160 },
              "address": { "type": "string", "pattern": "^(bring-your-own|https://[^\\s]+)$" },
              "auth": { "enum": ["none", "bearer", "oauth"] },
              "access": { "enum": ["inline", "bulk"] },
              "tools": { "type": "array", "items": { "type": "string" } },
              "roles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "required": { "type": "boolean" }
            }
          }
        },
        "mailbox": { "type": "boolean" },
        "github_repo": { "type": "boolean" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "type", "example", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
        "question": { "type": "string", "minLength": 5, "maxLength": 200 },
        "type": { "enum": ["text", "url", "domain", "number", "money", "choice", "list"] },
        "choices": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "example": {},
        "required": { "type": "boolean" }
      }
    }
  }
}
