---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import manifest from "../content/manifest.json";

const roles = await getCollection("roles");
const critics = roles.filter((r) => r.data.category === "challenge");

const GROUPS = [
  {
    id: "work",
    title: "Work that gets finished",
    items: [
      ["Verified completion", "Only the platform can mark work done. It runs the tests and checks the evidence.", null],
      ["Goals with an end", "Every task serves a requirement: something that must be true when you're done.", null],
      ["No busywork", "Only the CEO creates work, and every task needs a test that can fail.", null],
      ["Honest deadlines", "The date comes from measured pace. If it slips, new scope freezes.", null],
      ["Regular reviews", "A review opens on schedule, with the numbers and six levers for you.", null],
      ["Spot checks", "A random sample of finished work is sent to you to check.", null],
    ],
  },
  {
    id: "money",
    title: "Money and limits",
    items: [
      ["Metered runs", "Every run is priced, including failed ones.", "/docs/providers/#prices"],
      ["Budget and wall", "A budget the CEO plans against, and a hard limit that pauses the project.", "/how-it-works/#money"],
      ["Loop brakes", "Caps on wakes and runs. Two agents talking in circles get frozen.", null],
      ["Approvals with a clock", "Big spends wait for you. Unanswered ones expire as a no.", null],
    ],
  },
  {
    id: "team",
    title: "The team and the people",
    items: [
      ["Role library", `${roles.length} roles with their own prompt, model class and tools. Edits never change a running project.`, "/org/"],
      ["Built-in critics", `${critics.length} roles exist to disagree. The CEO can't remove the last one.`, "/org/#challenge"],
      ["The CEO hires", "It adds and removes teams as the work changes, within your limits, and says why on the chart.", null],
      ["Solo mode", "One agent under the same rules, if you just want the guardrails.", null],
      ["Co-chairs", "Invite people as co-chairs or observers. Every action is recorded as theirs.", null],
      ["Autonomy dial", "Five switches decide what you approve and what the CEO handles.", null],
    ],
  },
  {
    id: "start",
    title: "Getting started safely",
    items: [
      ["Describe it", "Write a paragraph. The Founder interviews you until nothing is assumed, with its own answer already picked.", null],
      ["Goal grading", "Your goal is checked against ten things a good goal needs.", null],
      ["A $0 rehearsal", "Run the full company on scripted agents before any model is called.", "/docs/cli/#projects"],
      ["Health checks", "Bad keys and broken setups are flagged before the first run.", "/docs/install/#if-something-goes-wrong"],
      ["A setup checklist", "A new project's Inbox lists what's left to connect, each ticked off by the project's own state.", null],
    ],
  },
  {
    id: "surfaces",
    title: "Where you work",
    items: [
      ["The Inbox", "A project opens on what waits on you, soonest consequence first. Decide in one click, snooze, or undo.", null],
      ["The Team page", "A live org chart: what each person is doing, the model they run on and their cost this month.", null],
      ["Results", "Every deliverable with who made it and who checked it, and the chain back to your goal.", null],
      ["A status sentence", "Every project says in one line whether it's fine, and which page fixes it if not.", "/docs/cli/"],
      ["Claude via MCP", "32 tools in four scopes. Irreversible actions need a confirm.", "/docs/install/#after-you-install"],
      ["Chat with the CEO", "In the app or in Slack. Every answer shows what the team did to get there.", null],
      ["Daily letter", "What waits on you, then what happened, in your own time zone. Costs no tokens.", null],
      ["Deliverables", "Every file the agents make, by day, with previews.", null],
      ["Full record", "Every message, run, cost, decision and refusal.", null],
      ["Pins", "Pin the pages you open every day under the project's five. Deliverables comes pinned.", null],
    ],
  },
  {
    id: "running",
    title: "Running it",
    items: [
      ["Any harness, any model", `${manifest.harnesses} harnesses and ${manifest.providers} providers, under one budget. Roles name a class, not a vendor.`, "/runtimes/"],
      ["One command to start", "<code>yaaf up</code> takes a checkout to a running dashboard on your own machine.", "/docs/install/"],
      ["The terminal", "<code>yaaf status</code> says every project in sentences, and what waits on you.", "/docs/cli/"],
      ["Sandboxed runs", "A fresh container per run, with only that role's secrets.", "/docs/architecture/#sandboxes"],
      ["Integrations", "Slack, GitHub, webhooks, email, S3 and any MCP server.", null],
      ["Tested rules", `${manifest.tests.toLocaleString("en-US")} tests attack the rules the way an agent would.`, null],
    ],
  },
];

const NOT_BUILT = [
  ["Hosted service", "There is none. You run it."],
  ["Multi-tenant orgs", "One machine, many projects, many people."],
  ["A model router", "A seat runs on what it was hired on. Only a named fallback moves class seats, and only while a provider is down."],
  ["Network allowlist", "Tried and removed. It hid failures."],
];

const total = GROUPS.reduce((n, g) => n + g.items.length, 0);
---
<BaseLayout title="Features" description={`${total} yaaf features: verified work, honest deadlines, budgets that stop, a role library with built-in critics, a $0 rehearsal, the Inbox and live org chart, Claude via MCP and any harness or model.`}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Features</p>
      <h1>Everything that keeps your AI company honest.</h1>
      <p class="lede">{total} features. Each one is backed by a test that tries to break it.</p>
      <nav class="toc" aria-label="On this page">
        {GROUPS.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
    </div>
  </section>

  {GROUPS.map((g) => (
    <Section id={g.id} eyebrow={`${g.items.length} features`} title={g.title}>
      <div class:list={["cells", "hued", { c3: g.items.length % 4 !== 0 && g.items.length % 3 === 0 }]}>
        {g.items.map(([k, v, href]) => href ? (
          <a class="cell" href={href}>
            <h3>{k}</h3>
            <p set:html={v} />
            <span class="go">Learn more →</span>
          </a>
        ) : (
          <div class="cell">
            <h3>{k}</h3>
            <p set:html={v} />
          </div>
        ))}
      </div>
    </Section>
  ))}

  <Section eyebrow="Not built, on purpose" title="What yaaf doesn't do.">
    <div class="cells">
      {NOT_BUILT.map(([k, v]) => (
        <div class="cell">
          <h3>{k}</h3>
          <p>{v}</p>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>
