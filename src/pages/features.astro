---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import manifest from "../content/manifest.json";

const roles = await getCollection("roles");
const critics = roles.filter((r) => r.data.category === "challenge");
const F = "/docs/features/#";

const GROUPS = [
  {
    id: "work",
    title: "Work that gets finished",
    items: [
      ["Verified completion", "Only the platform can mark work done. It runs the tests and checks the evidence.", `${F}6-done-means-verified`],
      ["Goals with an end", "Every task serves a requirement: something that must be true when you're done.", `${F}2-work-that-has-a-terminus`],
      ["No busywork", "Only the CEO creates work, and every task needs a test that can fail.", `${F}5-work-that-cant-be-invented`],
      ["Honest deadlines", "The date comes from measured pace. If it slips, new scope freezes.", `${F}3-a-delivery-date-the-project-cannot-quietly-break`],
      ["Regular reviews", "A review opens on schedule, with the numbers and six levers for you.", `${F}4-a-rhythm-and-a-standing-meeting`],
      ["Spot checks", "A random sample of finished work is sent to you to check.", `${F}6-done-means-verified`],
    ],
  },
  {
    id: "money",
    title: "Money and limits",
    items: [
      ["Metered runs", "Every run is priced, including failed ones.", `${F}7-money-that-cant-run-away`],
      ["Budget and wall", "A budget the CEO plans against, and a hard limit that pauses the project.", "/how-it-works/#money"],
      ["Loop brakes", "Caps on wakes and runs. Two agents talking in circles get frozen.", `${F}8-loops-that-cant-burn-a-night`],
      ["Approvals with a clock", "Big spends wait for you. Unanswered ones expire as a no.", `${F}7-money-that-cant-run-away`],
    ],
  },
  {
    id: "team",
    title: "The team and the people",
    items: [
      ["Role library", `${roles.length} roles with their own prompt, model and tools. Edits never change a running project.`, "/org/"],
      ["Built-in critics", `${critics.length} roles exist to disagree. The CEO can't remove the last one.`, "/org/#challenge"],
      ["The CEO hires", "It adds and removes roles as the work changes, within your limits.", `${F}1-the-org`],
      ["Solo mode", "One agent under the same rules, if you just want the guardrails.", `${F}1-the-org`],
      ["Co-chairs", "Invite people as co-chairs or observers. Every action is recorded as theirs.", "/docs/auth/"],
      ["Autonomy dial", "Five switches decide what you approve and what the CEO handles.", "/docs/autonomy/"],
    ],
  },
  {
    id: "start",
    title: "Getting started safely",
    items: [
      ["Describe it", "Write a paragraph. yaaf drafts the whole project and lists its assumptions.", `${F}18-the-founding-conversation`],
      ["Goal grading", "Your goal is checked against ten things a good goal needs.", "/docs/goal-grammar/"],
      ["Free rehearsal", "Run the full project on scripted agents before spending anything.", `${F}13-a-fire-drill-before-you-spend-a-cent`],
      ["Health checks", "Bad keys and broken setups are flagged before the first run.", `${F}16-setup-that-cant-silently-fail`],
    ],
  },
  {
    id: "surfaces",
    title: "Where you work",
    items: [
      ["Dashboard", "Desk, overview, boardroom, plan, work, review, deliverables and records.", "/docs/dashboard/"],
      ["Claude via MCP", "32 tools in four scopes. Irreversible actions need a confirm.", "/docs/mcp-server/"],
      ["Boardroom chat", "Talk to the CEO in the app or in Slack. It replies in seconds.", `${F}14-talking-to-your-project`],
      ["Daily briefing", "What happened while you were away, in your inbox. Costs no tokens.", `${F}12-three-tenses-not-one`],
      ["Deliverables", "Every file the agents make, by day, with previews.", `${F}15-deliverables-and-files`],
      ["Full record", "Every message, run, cost, decision and refusal.", `${F}11-everything-on-the-record`],
    ],
  },
  {
    id: "running",
    title: "Running it",
    items: [
      ["Any model", `${manifest.harnesses} harnesses and ${manifest.providers} providers, under one budget.`, "/runtimes/"],
      ["Sandboxed runs", "A fresh container per run, with only that role's secrets.", `${F}9-containment`],
      ["Integrations", "Slack, GitHub, webhooks, email, S3 and any MCP server.", "/docs/integrations/"],
      ["Tested rules", `${manifest.tests.toLocaleString("en-US")} tests attack the rules the way an agent would.`, `${F}17-proving-it-works`],
    ],
  },
];

const NOT_BUILT = [
  ["Hosted service", "There is none. You run it."],
  ["Multi-tenant orgs", "One machine, many projects, many people."],
  ["Model fallback", "A seat runs on the model it was hired on."],
  ["Network allowlist", "Tried and removed. It hid failures."],
];

const total = GROUPS.reduce((n, g) => n + g.items.length, 0);
---
<BaseLayout title="Features" description={`${total} yaaf features: verified work, honest deadlines, budgets that stop, a role library with built-in critics, a free rehearsal, Claude via MCP and any model provider.`}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Features</p>
      <h1>Everything that keeps your AI team honest.</h1>
      <p class="lede">{total} features. Each one is backed by a test that tries to break it.</p>
      <nav class="toc" aria-label="On this page">
        {GROUPS.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
    </div>
  </section>

  {GROUPS.map((g) => (
    <Section id={g.id} eyebrow={`${g.items.length} features`} title={g.title}>
      <div class:list={["cells", { c3: g.items.length % 4 !== 0 && g.items.length % 3 === 0 }]}>
        {g.items.map(([k, v, href]) => (
          <a class="cell" href={href}>
            <h3>{k}</h3>
            <p>{v}</p>
            <span class="go">Learn more →</span>
          </a>
        ))}
      </div>
    </Section>
  ))}

  <Section eyebrow="Not built, on purpose" title="What yaaf doesn't do.">
    <div class="cells">
      {NOT_BUILT.map(([k, v]) => (
        <div class="cell">
          <h3>{k}</h3>
          <p>{v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/docs/plan/#deliberately-not-built">The reasons, in the plan →</a></p>
  </Section>
</BaseLayout>
