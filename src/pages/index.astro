---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Cmd from "../components/Cmd.astro";
import Term from "../components/Term.astro";
import Shot from "../components/Shot.astro";
import Drill from "../components/Drill.astro";
import { SITE, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import manifest from "../content/manifest.json";
import autonomous from "../content/drills/autonomous.txt?raw";

import review from "../assets/screenshots/review.png";
import boardroom from "../assets/screenshots/boardroom.png";
import work from "../assets/screenshots/work-and-proof.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const critics = roles.filter((r) => r.data.category === "challenge");
const tests = manifest.tests.toLocaleString("en-US");

const RULES = [
  { k: "Done means verified", v: "Only the platform can mark work done. It runs the tests itself." },
  { k: "No busywork", v: "Every task must serve a goal and carry a test that can fail." },
  { k: "Budgets that stop", v: "Every run is metered. At the limit, the project pauses." },
  { k: "Honest deadlines", v: "Dates come from real pace. If one slips, new work stops." },
];

const STEPS = [
  { n: "01", k: "Describe", v: "Write what you want in a paragraph. yaaf drafts the goal, team and budget." },
  { n: "02", k: "Review", v: "The draft is graded against ten things a good goal needs." },
  { n: "03", k: "Rehearse", v: "Run it free on scripted agents. Fix what breaks." },
  { n: "04", k: "Run", v: "Hire the team for real. It works for weeks and reports back." },
];

const CLAUDE = [
  { k: "Its own key", v: "Claude never uses your login, and every action is marked as Claude's." },
  { k: "Two steps for big moves", v: "Anything you can't undo needs a preview, then a confirm." },
  { k: "Agents can't instruct it", v: "Text written by agents is labeled untrusted and never obeyed." },
  { k: "No secrets out", v: "No tool returns an API key, at any permission level." },
];

const VS = [
  { who: "vs. Paperclip", v: "Paperclip coordinates agents wherever they run. yaaf runs them in its own sandbox, so only the platform decides what's done.", href: "/compare/#paperclip" },
  { who: "vs. agent frameworks", v: "LangGraph and CrewAI help you build agent flows. yaaf enforces the rules around them.", href: "/compare/#frameworks" },
  { who: "vs. a Claude skill", v: "A skill does one task while you watch. yaaf runs work for weeks while you don't.", href: "/compare/#skill" },
];

const KNOW = [
  { k: "You run a server", v: "Docker, Postgres and one machine. A skill is just a file." },
  { k: "It's early", v: "Pre-1.0. First commit August 2026. One maintainer." },
  { k: "No outside security review", v: "Agents can reach the network. Read the threat model first." },
  { k: "No published costs", v: "Nobody has shared a real bill yet. The rehearsal shows break-even." },
];

const PROVIDERS = ["Claude", "GPT", "Gemini", "DeepSeek", "Kimi", "Qwen", "Mistral", "Grok", "OpenRouter", "Your own models"];

const DEPLOY = `<b>$</b> git clone ${SOURCE_IS_PUBLIC ? "https://github.com/dominicplouffe/yaaf.git" : "&lt;your-yaaf-remote&gt;"} yaaf &amp;&amp; cd yaaf
<b>$</b> ./deploy_single_server.sh --admin-email you@example.com`;

const CONNECT = `<b>$</b> yaaf login
<b>$</b> yaaf mcp-token mint my-laptop --scopes read
<b>$</b> claude mcp add --transport http yaaf http://localhost:8080/mcp \\
    --header <u>"Authorization: Bearer ymt_…"</u>`;
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="shell">
      <p class="tags"><span>Open source</span><span>Self-hosted</span><span>Pre-1.0</span></p>
      <h1>Rules your AI agents can't argue&nbsp;with.</h1>
      <div class="hero-row">
        <p class="sub">
          yaaf runs a team of AI agents on one goal for weeks. The server checks their work,
          caps their spend and keeps the deadline honest. You stay in charge.
        </p>
        <div class="hero-act">
          <div class="btns">
            <Button href="/docs/creating-a-project/" primary>Get started</Button>
            <Button href="/how-it-works/">How it works</Button>
          </div>
          <Cmd cmd="yaaf rehearse examples/01-your-first-hour.json" />
          <p class="hint">Try a full project for $0. No API key needed.</p>
        </div>
      </div>
    </div>
    <div class="shell shotwrap">
      <Shot src={review} crop={640} priority={true}
        alt="The Review screen: pace, requirements met, the delivery date at risk with its promised and projected dates, budget and audit coverage, with the CEO's notes and the chairman's six levers below"
        caption="The weekly review. Cost against estimate, a date that re-projected itself, and six levers you can pull." />
    </div>
  </section>

  <!-- ============ RUNS ON ============ -->
  <section class="runs">
    <div class="shell">
      <div class="runs-in">
        <p class="eyebrow">Runs on</p>
        <ul>{PROVIDERS.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ============ RULES ============ -->
  <Section eyebrow="Why yaaf" title="Prompts are suggestions. yaaf makes them rules."
    lede="Left alone, agents mark their own work done, invent busywork and burn money. A better prompt won't fix that. A server that says no will.">
    <div class="cells">
      {RULES.map((r, i) => (
        <div class="cell">
          <span class="eyebrow">0{i + 1}</span>
          <h3>{r.k}</h3>
          <p>{r.v}</p>
        </div>
      ))}
    </div>
    <p class="note">Every rule is enforced by the server and attacked by a test. {tests} tests, free to run. <a href="/features/">All features →</a></p>
  </Section>

  <!-- ============ DRILL ============ -->
  <Section eyebrow="Try before you spend" title="Rehearse the whole project for $0."
    lede="yaaf runs your exact setup on scripted agents with every rule switched on. You see where it stalls, what it costs and how often it needs you.">
    <div class="rehearse">
      <div class="cells c2 drill-l">
        <div class="cell"><h3>Where it breaks</h3><p>A missing role, an empty schedule, a plan over budget. Each one named, with the fix.</p></div>
        <div class="cell"><h3>How often it waits</h3><p>This example never waits for you. With approvals turned on, it stops 7 times.</p></div>
        <div class="cell"><h3>What it costs</h3><p>The most a run can cost before the plan stops fitting your budget.</p></div>
        <div class="cell"><h3>What it can't tell you</h3><p>Whether a real model does good work. The rehearsal tests your setup, not the AI.</p></div>
      </div>
      <Drill report={autonomous} only={["The walk", "It never", "What it still needs"]} label="yaaf rehearse · real output" />
    </div>
  </Section>

  <!-- ============ STEPS ============ -->
  <Section eyebrow="How it works" title="From one paragraph to a working team.">
    <div class="cells">
      {STEPS.map((s, i) => (
        <div class:list={["cell", { free: i < 3 }]}>
          <span class="eyebrow">{s.n}{i < 3 && " · free"}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/how-it-works/">See every step →</a></p>
  </Section>

  <!-- ============ COCKPIT ============ -->
  <Section eyebrow="The cockpit" title="See everything. Decide what matters.">
    <div class="shots">
      <Shot src={work} crop={460}
        alt="The Work screen: a randomly sampled finished task waiting for the chairman to check, the board, and every piece of evidence with its verification status"
        caption="A random sample of finished work, dealt to you to check. AI reviewers approve almost everything. You won't." />
      <Shot src={boardroom} crop={460}
        alt="The Boardroom: the chairman asks the CEO how confident it is in the deadline, and the CEO answers with its estimate-to-actual ratio and re-projection"
        caption="Ask the CEO anything. It answers with numbers, not reassurance." />
    </div>
  </Section>

  <!-- ============ TEAM ============ -->
  <Section eyebrow="The team" title="Hire from a library, not a blank prompt."
    lede="A CEO plans and assigns the work. Specialists do it. Critics, like a red team or a risk manager, can block it.">
    <div class="cells">
      <a class="cell" href="/org/#roles"><p class="num">{roles.length}</p><p>Roles, each with its own prompt, model and tools</p></a>
      <a class="cell" href="/org/#crews"><p class="num">{crews.length}</p><p>Ready-made teams you can hire whole</p></a>
      <a class="cell warm" href="/org/#challenge"><p class="num">{critics.length}</p><p>Roles paid to disagree. The CEO can't fire the last one.</p></a>
      <a class="cell" href="/runtimes/"><p class="num">{manifest.providers}</p><p>Model providers, mixed freely under one budget</p></a>
    </div>
  </Section>

  <!-- ============ CLAUDE ============ -->
  <Section eyebrow="Chair it from Claude" title="Run your projects from the Claude window you already use."
    lede="yaaf is an MCP server. Claude can check status, talk to the CEO and approve decisions, with guardrails.">
    <div class="cells">
      {CLAUDE.map((c) => (
        <div class="cell">
          <h3>{c.k}</h3>
          <p>{c.v}</p>
        </div>
      ))}
    </div>
    <p class="note">32 tools in four scopes: read, steer, create and configure. Start with read. <a href="/docs/mcp-server/">MCP docs →</a></p>
  </Section>

  <!-- ============ COMPARE ============ -->
  <Section eyebrow="Compared" title="How yaaf is different.">
    <div class="cells c3">
      {VS.map((x) => (
        <a class="cell" href={x.href}>
          <span class="eyebrow">{x.who}</span>
          <p class="vs">{x.v}</p>
          <span class="go">Read more →</span>
        </a>
      ))}
    </div>
  </Section>

  <!-- ============ KNOW ============ -->
  <Section eyebrow="Before you install" title="What you should know.">
    <div class="cells">
      {KNOW.map((k) => (
        <div class="cell">
          <h3>{k.k}</h3>
          <p>{k.v}</p>
        </div>
      ))}
    </div>
    <p class="note">
      The open question: does a team of agents beat one good agent? Nobody knows yet. Solo mode runs one
      agent under the same rules so you can compare. <a href="/docs/plan/">Read the plan →</a>
    </p>
  </Section>

  <!-- ============ INSTALL ============ -->
  <Section id="install" eyebrow="Install" title="One script. One machine.">
    <div class="install">
      <Term label="1 · Deploy" code={DEPLOY} />
      <Term label="2 · Connect Claude" code={CONNECT} />
    </div>
    <p class="note">Needs Linux and Docker. The dashboard stays on localhost; reach it over SSH. <a href="/docs/deployment/">Deployment guide →</a></p>
  </Section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; padding-top: 7.5rem; }
  .glow {
    position: absolute;
    inset: -10% 0 auto 0;
    height: 120%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 38% at 78% 18%, color-mix(in srgb, var(--color-accent) 55%, transparent), transparent 70%),
      radial-gradient(ellipse 30% 26% at 92% 40%, color-mix(in srgb, var(--color-accent-2) 30%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 30% at 60% 45%, rgba(120, 90, 255, 0.18), transparent 70%);
    filter: blur(10px);
    opacity: 0.9;
  }
  /* Scanlines over the glow, and a fade to black under it. */
  .glow::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0 1px, transparent 1px 3px);
  }
  .glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, #000 72%);
  }
  .hero .shell { position: relative; }
  .tags { display: flex; gap: 0; margin: 0 0 2.2rem var(--inset); }
  .tags span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border: 1px solid var(--color-line);
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.4);
  }
  .tags span + span { border-left: 0; }
  h1 {
    margin: 0;
    font-size: var(--text-hero);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 500;
    max-width: 12ch;
    padding-left: var(--inset);
  }
  .hero-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 0;
    margin-top: 3rem;
    align-items: start;
  }
  .hero-row > * { padding-inline: var(--inset); }
  .sub { grid-column: 1 / span 2; margin: 0; font-size: 1.3rem; line-height: 1.45; color: var(--color-ink-2); max-width: 34ch; }
  .hero-act { grid-column: 3 / span 2; display: grid; gap: 14px; }
  .hint { margin: 0; font-size: 13.5px; color: var(--color-muted); }
  .shotwrap { margin-top: 5rem; padding-bottom: 6rem; }

  /* ---------- runs on ---------- */
  .runs-in { border-top: 1px solid var(--color-line); padding-block: 2.2rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 0; align-items: center; }
  .runs-in > * { padding-inline: var(--inset); }
  .runs-in .eyebrow { margin: 0; }
  .runs-in ul { grid-column: 2 / span 3; list-style: none; margin: 0; padding-block: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .runs-in li { font-size: 1.15rem; letter-spacing: -0.02em; color: var(--color-ink-2); }

  /* ---------- drill ---------- */
  .rehearse { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .drill-l { grid-column: 1 / span 2; grid-template-columns: 1fr; }
  .rehearse :global(.drill) { grid-column: 3 / span 2; border-left: 0; }

  /* ---------- steps ---------- */
  .free .eyebrow { color: var(--color-good); }

  /* ---------- shots ---------- */
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

  .vs { font-size: 1.05rem !important; color: var(--color-ink) !important; line-height: 1.45 !important; }

  /* ---------- install ---------- */
  .install { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }

  @media (max-width: 1024px) {
    .hero { padding-top: 5rem; }
    .sub, .hero-act { grid-column: 1 / -1; }
    .runs-in .eyebrow, .runs-in ul { grid-column: 1 / -1; }
    .rehearse { grid-template-columns: 1fr; }
    .drill-l, .rehearse :global(.drill) { grid-column: 1 / -1; }
    .rehearse :global(.drill) { border-left: 1px solid var(--color-line); border-top: 0; }
    .shots, .install { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .shotwrap { margin-top: 3.5rem; padding-bottom: 4rem; }
  }
</style>
