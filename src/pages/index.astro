---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import OrgChart from "../components/OrgChart.astro";
import Term from "../components/Term.astro";
import Shot from "../components/Shot.astro";
import Drill from "../components/Drill.astro";
import { SITE, REPO_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import manifest from "../content/manifest.json";
import runtimes from "../content/runtimes.json";
import autonomous from "../content/drills/autonomous.txt?raw";

import review from "../assets/screenshots/review.png";
import cockpit from "../assets/screenshots/cockpit-overview.png";
import boardroom from "../assets/screenshots/boardroom.png";
import work from "../assets/screenshots/work-and-proof.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const challengers = roles.filter((r) => r.data.category === "challenge");
const tests = manifest.tests.toLocaleString("en-US");
const h = manifest.history;
const firstCommit = new Date(h.firstCommit).toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: "UTC" });

const REHEARSE = `<i># try the whole project before you pay for any of it</i>
<b>$</b> yaaf rehearse examples/01-your-first-hour.json`;

const DEPLOY = `<i># secrets, images, Postgres, migrations, the role library —</i>
<i># and a one-time link to choose your password. Safe to re-run.</i>
<b>$</b> git clone ${SOURCE_IS_PUBLIC ? "https://github.com/dominicplouffe/yaaf.git" : "&lt;your-yaaf-remote&gt;"} yaaf &amp;&amp; cd yaaf
<b>$</b> ./deploy_single_server.sh --admin-email you@example.com`;

const CONNECT = `<i># the dashboard binds to localhost; tunnel to it</i>
<b>$</b> ssh -N -L 8080:localhost:8080 you@your-server

<b>$</b> yaaf login
<b>$</b> yaaf mcp-token mint my-laptop --scopes read
<i>→ ymt_…</i>
<b>$</b> claude mcp add --transport http yaaf http://localhost:8080/mcp \\
    --header <u>"Authorization: Bearer ymt_…"</u>`;

/** The hero org. Illustrative, but every seat is a legal hire under R1–R7. */
const HERO_TEAMS = [
  { name: "Research", role: "Equity Analyst", employees: ["Maya", "Tobias"], lead: "Maya", runsOn: "Claude · SDK" },
  { name: "Macro", role: "Macro Analyst", employees: ["Ines"], lead: null, runsOn: "Gemini CLI" },
  { name: "Risk", role: "Risk Manager", employees: ["Owen"], lead: null, challenge: true, runsOn: "GPT · Codex" },
  { name: "Editorial", role: "Market Writer", employees: ["Ada"], lead: null, runsOn: "Claude · CLI" },
];

const RULES = [
  { k: "“Done” means verified", v: "Tests run in a sandbox, by the platform, not by the agent that wants them to pass. There is no agent verb that writes “met.”" },
  { k: "Work that makes nothing true is refused", v: "Every task has to serve a requirement — something that must be true at the end, carrying its own test." },
  { k: "The date can't quietly slip", v: "The platform stamps the date from measured pace and re-projects it every tick. Past the promise, new scope freezes." },
  { k: "Money that can't run away", v: "Every run metered, killed ones included. A budget the CEO must account for, and a wall where the project pauses itself." },
  { k: "Loops that can't burn a night", v: "Wake ceilings, run ceilings and a pair breaker. Two agents talking in circles freeze; they don't bill." },
  { k: "Everything on the record", v: "Every message, run, dollar, decision and refusal — plus random samples of “completed” work dealt to you to spot-check." },
];

const STEPS = [
  { n: "01", k: "Describe it", v: "A paragraph. The Founder drafts the goal, the roster, the budget and the rules, and tells you what it assumed." },
  { n: "02", k: "Get argued with", v: "The goal is graded against the ten things it has to contain to work. Free, before anything exists." },
  { n: "03", k: "Rehearse it for $0", v: "Scripted agents, the real policy engine: where it stalls, what paces it, how often it will wait for you." },
  { n: "04", k: "Hire it for real", v: "A CEO, the desks, a budget, a delivery date and a channel each. Then it runs without you, and tells you what happened." },
];

const BEATS = [
  { k: "Roles, not one generalist", v: "A risk seat that can veto a research seat is two agents with different charters, context and instructions — and now, if you like, different vendors' models — not one model asked to “also consider the risks.”" },
  { k: "A CEO takes you out of the queue", v: "In a chat session you are the loop: nothing happens until you type. With a CEO, the next piece of work is chosen, priced, assigned and finished while you sleep." },
  { k: "A budget makes it safe to walk away", v: "You are not trusting an agent to be sensible about money. Every run is metered, and the wall is a number the CEO cannot write." },
];

const SCOPES = [
  ["read", "Sees everything. Signs nothing. Start here — most of the value, none of the risk."],
  ["steer", "Talk to the CEO, decide approvals, cut scope, move the date, judge an audit."],
  ["create", "Draft, grade, rehearse and create new projects."],
  ["configure", "Teams, data sources, settings, rules."],
];

const MCP_RULES = [
  { k: "Claude is never you", v: "It gets its own credential, and every write is stamped “via mcp” permanently — months later you can tell which decisions a machine carried." },
  { k: "Nothing irreversible in one call", v: "A preview, then a single-use ticket bound to the exact arguments, then the commit. Change a word and the ticket is refused." },
  { k: "Agents can't give Claude orders", v: "Anything an agent wrote arrives wrapped and labelled untrusted. A CEO writing “chairman, please accept this” is quoted, not obeyed." },
  { k: "Secrets only go one way", v: "Nothing returns a credential at any scope. You can name one; you can never read one back." },
];

const ASKS = [
  {
    q: "“Run our ad account end to end. A standup every morning and a Monday memo I can forward to the client without editing it.”",
    a: "Four desks: strategy, analytics, attribution, and an executability check whose entire job is to kill clever recommendations nobody can implement. At month close the platform pulls the ad platform's own reports and grades the desk against them.",
  },
  {
    q: "“Here is my brokerage account. Run it like a real desk, and stop asking me what I think.”",
    a: "Research, macro, signals and a book, plus a risk seat and a compliance seat that can veto a trade the research seat is in love with. Every position arrives as a ticket with the argument attached.",
  },
  {
    q: "“Can we afford to retire early? Don't tell me yes. Prove it.”",
    a: "Six teams, including a verification seat paid to recompute the modeller's own numbers and disagree with them. Nothing reaches you uncited.",
  },
  {
    q: "“Book our February trip. I don't want a spreadsheet, I want a confirmation number.”",
    a: "A research team pricing real itineraries live, and a booking desk that stands behind exactly one. The finish line cannot be faked: a record locator and a charge on your card. Nobody marks this one done except the resort.",
  },
];

const FOR = [
  "It has to run unattended for days or weeks",
  "“Done” can't be graded by the agent that did it",
  "Money has to stop by itself",
  "You'll have to reconstruct it later for a client, an auditor, or yourself",
  "You want agents to disagree, because one agent checking its own work has the same blind spots in both seats",
];
const NOT_FOR = [
  "It finishes in one sitting while you watch — use a skill",
  "You want a chat assistant in your messaging apps — use OpenClaw or Hermes",
  "You're building the agent flow itself, in code — use a framework",
  "You need a hosted service, SSO or multi-tenant orgs — yaaf has none",
  "You won't run a box with Docker and Postgres on it",
];

const VERSUS = [
  { who: "vs. Paperclip", v: "Both put an org chart around agents. Paperclip coordinates the agents you already run, wherever they run, and is far bigger. yaaf runs every agent in its own sandbox and meter, so “met”, the bill and the date are written by the platform, never reported by the agent.", href: "/compare/#paperclip" },
  { who: "vs. agent frameworks", v: "LangGraph, CrewAI and friends give you coordination as code and rules as prompts. yaaf is the layer underneath — the one that refuses, meters and verifies.", href: "/compare/#frameworks" },
  { who: "vs. OpenClaw & Hermes", v: "They make one agent more present and more capable. yaaf makes many agents accountable over weeks — and it's an MCP server, so any of them can be its front end.", href: "/compare/#assistants" },
  { who: "vs. a good skill", v: "yaaf runs your skills. It decides which to point at what, checks it got done, pays from a capped budget and keeps the receipt. The difference is governance and duration.", href: "/compare/#skill" },
];

const FAQ = [
  { q: "Is there a hosted version, or a paid plan?", a: "No. It's open source and only that: self-hosted, Apache-2.0, no account and no telemetry. You pay your model provider directly.", href: "/faq/#hosted" },
  { q: "Which models does it run?", a: `Claude, GPT through Codex, Gemini, DeepSeek, Kimi, Qwen, Mistral, Grok, OpenRouter, or your own server — ${manifest.harnesses} harnesses, ${manifest.providers} providers, one cap.`, href: "/faq/#models" },
  { q: "What does a project cost?", a: "Nobody has published a bill yet, and this site won't invent one. The drill gives you the break-even per run before you spend anything.", href: "/faq/#cost" },
  { q: "Is it safe?", a: "Read the threat model first. The container, scoped secrets, the budget and the audit contain an agent; the network does not.", href: "/faq/#secure" },
];

const harnessNames = runtimes.harnesses.map((x) => x.label.replace(/ \(.*\)$/, ""));
const providerNames = runtimes.providers.map((x) => x.label.replace(/ \(([^)]*)\)$/, (_m, p) => (p.length < 8 ? ` (${p})` : "")).replace("Custom endpoint", "Your own server"));
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="blueprint bp" aria-hidden="true"></div>
    <div class="shell inner">
      <div class="copy">
        <p class="tags">
          <span>Open source · {`Apache-2.0`}</span>
          <span>Self-hosted · no telemetry</span>
          <span class="wip"><i aria-hidden="true"></i>Pre-1.0 · actively developed</span>
        </p>
        <h1 class="balance">Agents don't need a better&nbsp;prompt. They need rules they can't argue&nbsp;with.</h1>
        <p class="lede pretty">
          yaaf runs a crew of agents on one goal for weeks — a CEO that picks the next piece of
          work, specialists, and critics paid to disagree — on Claude, GPT, Gemini, DeepSeek or your
          own server. The rules live in the server, where no agent's token can reach them: work counts
          only when the platform has verified it, the budget stops itself, and the delivery date is
          arithmetic. <strong>You're the chairman.</strong>
        </p>
        <p class="ctas">
          <a class="btn primary" href="/how-it-works/">How it works</a>
          <a class="btn" href="/compare/">Compare</a>
          {SOURCE_IS_PUBLIC && <a class="btn ghost" href={REPO_URL}>GitHub ↗</a>}
        </p>
        <Term class="cmd" code={REHEARSE} note="Runs your spec as a real project on the real platform — every rule, every refusal — with scripted agents standing in for models. No API key. No dollars. About ten seconds." />
      </div>

      <div class="chartwrap">
        <p class="eyebrow ct">One project, as the platform sees it</p>
        <OrgChart ceo="CEO" ceoRole="picks, prices and assigns the next piece of work" ceoRunsOn="Opus 5.5 · Agent SDK" teams={HERO_TEAMS} />
        <p class="legend">
          <span class="k chair"></span> you <span class="k ceo"></span> executive
          <span class="k chal"></span> hired to disagree
        </p>
        <p class="chartnote">
          Illustrative, and every seat a legal hire: the writer stays on Claude because its role grants
          web search, and a seat on a provider with none is refused at the door.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= RUNS ON ================= -->
  <section class="runson" aria-label="What a seat can run on">
    <div class="shell ro">
      <div class="ro-k">
        <p class="eyebrow">Any seat, any of</p>
        <p class="ro-big"><strong>{manifest.harnesses}</strong> harnesses · <strong>{manifest.providers}</strong> providers · <strong>1</strong> cap</p>
        <a href="/runtimes/">Runtimes →</a>
      </div>
      <div class="ro-lists">
        <p class="pills">{providerNames.map((n) => <span class="pill">{n}</span>)}</p>
        <p class="pills">{harnessNames.map((n) => <span class="pill blue">{n}</span>)}</p>
      </div>
    </div>
  </section>

  <!-- ================= RULES ================= -->
  <Section eyebrow="Layer one · the part that isn't a bet" title="A prompt is a suggestion. A 403 is not.">
    <p class="big pretty">
      Leave an agent running for an afternoon and you meet the failure modes. It marks its own work
      done. It invents busywork and calls it progress. It loops with another agent at full price. The
      usual fix is a better prompt, but a clever model talks itself around one.{" "}
      <strong>So in yaaf the rules live in the server.</strong> Agents act only through an authenticated
      API on per-run tokens, and every rule is a refusal or an automatic state change. An agent can't be
      argued out of a rule it never held.
    </p>
    <div class="tiles">
      {RULES.map((r) => (
        <div class="tile rule">
          <h3>{r.k}</h3>
          <p>{r.v}</p>
        </div>
      ))}
    </div>
    <p class="note">
      Each of those is a test, not a paragraph. <strong>{tests} of them</strong>, offline and free, and the
      invariant suite drives the real app over HTTP the way an agent would: forged tokens, wrong roles,
      rephrased requests. They test <strong>the rules, not the models</strong> — the rules are the part an agent
      argues with.{" "}
      <a href="/features/">Every feature →</a>{" · "}
      <a href="/docs/security/">What contains an agent, and what doesn't →</a>
    </p>
    <div class="callout layers">
      <p>
        <strong>This layer does not depend on the next one.</strong> Solo mode runs a single agent under
        byte-identical governance: same queues, same requirements, same verification, same budget, same audit.
        If you think one good agent beats a team, take this floor and skip the org chart. It was built to stand
        on its own, because it might have to.
      </p>
    </div>
  </Section>

  <!-- ================= DRILL ================= -->
  <Section grid={true} eyebrow="Before you spend a cent" title="Rehearse the whole project before it exists."
    lede="The riskiest moment is the one before the first real run. So yaaf runs your exact configuration as a real project — the real dispatcher, janitor and policy engine, every refusal in force — with scripted agents standing in for models. It costs nothing and needs no key.">
    <div class="drillgrid">
      <Drill report={autonomous} only={["This project", "The walk", "It never", "It stopped", "Walls it hit", "What it will cost", "What it still needs"]}
        label={`yaaf rehearse · printed on ${manifest.syncedAt}`}
        note="Real output, uncut within each section: example 06, a build team and a red team that can block. Look at the last section — it names the one thing this configuration still needs before it can run." />
      <div class="drillside">
        <div class="tile">
          <h3>Where it stopped, in the platform's own words</h3>
          <p>A role your library can't resolve, a schedule attached to nobody, a plan that won't fit the money — each named, with what to do about it.</p>
        </div>
        <div class="tile">
          <h3>How often it will wait for you</h3>
          <p>The drill plays the chairman and counts every time it had to. This crew as shipped: never. The same crew with the five authority switches handed back: seven times. <a href="/how-it-works/#dial">Both reports →</a></p>
        </div>
        <div class="tile">
          <h3>What it can't tell you</h3>
          <p>Whether a real model does the job well. The crew is competent and dull by construction, so a clean drill is evidence about your configuration and none at all about your project — and the report says so.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ================= LIFECYCLE ================= -->
  <Section eyebrow="From a paragraph to a payroll" title="One sitting, four steps. The first three are free.">
    <ol class="steps">
      {STEPS.map((s) => (
        <li>
          <span class="sn">{s.n}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </li>
      ))}
    </ol>
    <p class="note"><a href="/how-it-works/#lifecycle">All eight steps, from the paragraph to the standing review →</a></p>
  </Section>

  <!-- ================= COCKPIT ================= -->
  <Section eyebrow="The standing meeting" title="The CEO brings the numbers. You decide." grid={true}
    lede="This is the screen the whole thing is for: what it cost against what it estimated, a date that re-projected itself, and the levers a human can pull — each one recorded with your reason and shown at the next review beside what it bought.">
    <div class="shots">
      <Shot src={review} crop={600} priority={true}
        alt="The Review tab: pace, requirements met since last review, the commitment at risk with its promised and projected dates, budget, audit coverage and worst offender; below them the CEO's variance narrative and the chairman's six levers"
        caption="The CEO closes a stage 28 runs against 23 estimated, moves its own bias multiplier to 1.21, and applies it to the rest of the plan. Then it tells you the one thing it will not do without you: buy a licensed data feed. It proposes the free route instead." />
      <Shot src={work} crop={620}
        alt="The Work tab: the platform's sampled close waiting on the chairman, the read-only board, and every piece of evidence with its verification status including a failed check"
        caption="The platform picked a finished claim at random and dealt it to you, because AI reviewers approve nearly everything and you don't. One task sits blocked on a licence nobody will buy without asking." />
      <Shot src={boardroom} crop={500}
        alt="The Boardroom tab: the chairman asks the CEO how confident it is in the 30th; the CEO answers with the estimate-to-actual ratio, its re-projection, and what would move it"
        caption="Boardroom. Ask the CEO how confident it is in the 30th. It answers with the estimate-to-actual ratio, its re-projection, and what would move it." />
    </div>
    <p class="note">
      Real screens from a real desk — $16.39 of real spend, model-written reasoning — captured on a build from 22 August,
      before the September redesign. <a href="/docs/dashboard/">Every screen, and what you do there →</a>
    </p>
  </Section>

  <!-- ================= MCP ================= -->
  <Section eyebrow="Chair it from Claude" title="The Claude window you already have open is the front end."
    lede="yaaf is an MCP server, so Claude Code, Claude Desktop, Cursor or any MCP client can design a project, read its cockpit, talk to the CEO, decide approvals and move the date — with your files, repos and email open beside it. Thirty-two tools, four scopes, chosen when you connect.">
    <div class="mcp">
      <div class="kit-table">
        <table>
          <thead><tr><th>Scope</th><th>What it holds</th></tr></thead>
          <tbody>
            {SCOPES.map(([k, v]) => <tr><th scope="row"><code>{k}</code></th><td>{v}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="tiles c2">
        {MCP_RULES.map((r) => (
          <div class="tile">
            <h3>{r.k}</h3>
            <p>{r.v}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="note">
      A six-team research project has been designed and launched from a Claude window, and every write in its
      audit trail is signed <code>user:… via mcp:Claude</code>. <a href="/docs/mcp-server/">Every tool and every scope →</a>
    </p>
  </Section>

  <!-- ================= THE BET ================= -->
  <Section eyebrow="Layer two · the bet" title="You build agents the way you build a company." grid={true}
    lede="Multiple roles doing one thing each beat one role doing many. That is a hypothesis, not a finding. It is the same one that makes a company work, and the argument against it is good: every boundary between agents is a place context gets summarised and lost.">
    <div class="tiles">
      {BEATS.map((b) => (
        <div class="tile">
          <h3>{b.k}</h3>
          <p>{b.v}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ================= THE ORG ================= -->
  <Section eyebrow="The library" title="Hired, not invented."
    lede="A project doesn't start from a blank prompt. It hires from a library: each role a system prompt, a model, an effort level and tool permissions somebody already argued about.">
    <div class="counts">
      <a class="n" href="/org/#roles"><strong>{roles.length}</strong><span>job descriptions</span></a>
      <a class="n" href="/org/#crews"><strong>{crews.length}</strong><span>pre-built crews</span></a>
      <a class="n hi" href="/org/#challenge"><strong>{challengers.length}</strong><span>hired to disagree</span></a>
      <a class="n" href="/examples/"><strong>{manifest.examples}</strong><span>importable examples</span></a>
    </div>
    <p class="note">
      That third number is the one that matters. A large share of the library exists to attack the rest of
      its work: a red team, a plan adversary, an executability checker, a data skeptic, a risk seat that can veto.{" "}
      <strong>One agent checking its own work has the same blind spots in both seats</strong> — and the CEO cannot
      fire its own last critic. <a href="/org/">Read the staff directory →</a>
    </p>
  </Section>

  <!-- ================= ASKS ================= -->
  <Section eyebrow="What it is built to be handed" title="None of these is a prompt you re-run." grid={true}
    lede="These are the shapes the crews and examples are designed around. Each one has to survive weeks, wake up without you, and be graded by something that isn't itself.">
    <div class="tiles c2">
      {ASKS.map((a) => (
        <article class="tile ask">
          <p class="q">{a.q}</p>
          <p>{a.a}</p>
        </article>
      ))}
    </div>
    <p class="note"><a href="/examples/">Twelve projects you can import and rehearse →</a></p>
  </Section>

  <!-- ================= FOR YOU ================= -->
  <Section eyebrow="Is it for you?" title="Believe yourself if the answer is no.">
    <div class="tiles c2">
      <div class="tile hi">
        <h3>Reach for yaaf when</h3>
        <ul>{FOR.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="tile">
        <h3>Use something else when</h3>
        <ul>{NOT_FOR.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </Section>

  <!-- ================= COMPARE ================= -->
  <Section eyebrow="Different how?" title="Others coordinate agents. yaaf governs them." grid={true}>
    <div class="tiles c4 vs">
      {VERSUS.map((x) => (
        <a class="tile vsc" href={x.href}>
          <span class="eyebrow">{x.who}</span>
          <p>{x.v}</p>
          <span class="go">Read →</span>
        </a>
      ))}
    </div>
    <p class="note"><a href="/compare/">The full comparison, with the tables — including where the others are ahead →</a></p>
  </Section>

  <!-- ================= HONEST ================= -->
  <Section eyebrow="What you give up" title="Read this before you install anything.">
    <div class="honest">
      <ul>
        <li><strong>You deploy and run a thing.</strong> Postgres, two containers, a box. A skill is a file.</li>
        <li><strong>Setup is minutes, not seconds.</strong> A goal worth planning from takes longer to write than a prompt, on purpose.</li>
        <li><strong>The floor is higher than the ceiling is high.</strong> Planning, review and verification cost tokens. On a one-sitting task that buys you nothing.</li>
        <li><strong>Nobody has published what it costs.</strong> Not even the maintainer. The caps in the examples are budgets you set, not bills anyone paid, and the drill refuses to invent a price rather than print a plausible one. <code>yaaf receipt</code> will make the number a receipt rather than a claim.</li>
        <li><strong>Other vendors' seats are proven offline, not yet live.</strong> Every harness passes its contract suite at $0; a live seat on each is the line only a deployment can tick.</li>
        <li><strong>It is pre-1.0.</strong> APIs move, and there are sharp edges.</li>
      </ul>
      <div class="kill">
        <p class="eyebrow">The bet, and what would kill it</p>
        <p>Nobody has shown that a CEO plus a team beats one good agent on the same budget and rules, and yaaf doesn't claim to have. <strong>Solo mode</strong> runs a single agent under byte-identical governance, so the same goal can go to a hierarchy and to one brain and the bills compared.</p>
        <p>The repository publishes its own kill condition: if the org arm doesn't win on the pre-registered rubric — blind-judged quality, verified external evidence, cost, wall-clock — yaaf-as-an-org-framework is shelved and layer one stands on its own.</p>
        <p class="lk"><a href="/docs/plan/">The plan, the kill conditions, and what is deliberately not built →</a></p>
      </div>
    </div>

    <div class="failshot">
      <Shot src={cockpit} crop={498}
        alt="The cockpit of a project that is not working: nothing working now, one run in five ended early, no deliverable published, and CEO judgment at 20 per cent"
        caption="And this is one that is not working. Nothing published, one run in five dead, the CEO's judgement running at 20% — one of its five bets ever produced real-world proof. The dashboard's first job is to tell you that on the way past, in red, rather than after the invoice. A screen that only looks good is a screen that is lying to you." />
    </div>
  </Section>

  <!-- ================= PROVENANCE ================= -->
  <Section eyebrow="Before you go looking" title="Two months old, built in the open with Claude Code." grid={true}
    lede="You would find all of this in one click, so here it is up front, with what follows from each half.">
    <div class="prov">
      <div class="prov-nums">
        <div><strong>{firstCommit}</strong><span>first commit, {h.firstCommit.slice(0, 4)}</span></div>
        <div><strong>{h.commits}</strong><span>commits over {h.activeDays} days</span></div>
        <div><strong>{h.claudeShare}%</strong><span>co-authored with Claude Code</span></div>
        <div><strong>0</strong><span>outside security reviews</span></div>
      </div>
      <div class="prov-txt">
        <p>
          It was built fast and in the open with Claude Code, and nearly every commit says so in its
          trailer. That is the method, not a disclaimer. The design is much older than the code: years of
          running teams, written down first and then built quickly, and held to by a suite that attacks
          every rule.
        </p>
        <p>
          <strong>What that bought:</strong> a policy engine with {tests} offline tests, a role library that is
          data rather than prose, runtimes on {manifest.providers} providers, and a suite that runs for $0.
          <strong> What it has not bought:</strong> a project anyone but the maintainer has run for a month, a
          published bill, or a security review by someone who did not write it. Both halves are true at the same
          time, and the second half is the one that matters.
        </p>
      </div>
    </div>

    <div class="asks-q">
      <p class="eyebrow qh">Three things the maintainer would rather have torn apart than praised</p>
      <ol>
        <li>
          <strong>Does the org layer earn its tokens?</strong> Every boundary between agents is a place context
          gets summarised and lost, and the case that one well-contexted agent beats a hierarchy is a good one.
          Solo mode exists so this is measurable rather than arguable. <em>What would you put in the rubric?</em>
        </li>
        <li>
          <strong>Is a server-side refusal actually enough?</strong> An agent holds the credentials its role was
          granted, has a shell and a network, and there is no egress control — that allowlist was removed on
          purpose, and the reasoning is published. A prompt-injected agent can send what it holds anywhere.{" "}
          <em>Is the container boundary plus a scoped grant plus an audit trail a defensible place to stop?</em>{" "}
          <a href="/docs/security/">The threat model →</a>
        </li>
        <li>
          <strong>Is the requirement the right root object?</strong> Every task must serve something that has to
          be true at the end and carries its own test. It works beautifully for artifacts and badly for objectives:
          a rank, a revenue number, a deficit resist being a test, and the honest failure mode is that every
          requirement quietly becomes a grep over the workspace. <em>What is the better shape?</em>
        </li>
      </ol>
      <p class="note">
        Issues and pull requests are the fastest way in. If you break one of the invariant tests, that is the
        contribution this project wants most.
      </p>
    </div>
  </Section>

  <!-- ================= INSTALL ================= -->
  <Section id="install" eyebrow="Install" title="One script, one box.">
    <div class="install">
      <Term label="Deploy" code={DEPLOY} />
      <Term label="Then connect Claude" code={CONNECT} />
    </div>
    <p class="note">
      A Linux box with Docker. Start on the <code>read</code> scope: sees everything, signs nothing. claude.ai
      connects through an OAuth consent screen on a public hostname instead of a pasted token.{" "}
      <a href="/docs/deployment/">Deployment →</a>{" · "}
      <a href="/docs/creating-a-project/">Your first project →</a>
    </p>
  </Section>

