---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Shot from "../components/Shot.astro";
import { SITE } from "../site.config.mjs";

import overview from "../assets/screenshots/cockpit-overview.png";
import inbox from "../assets/screenshots/inbox.png";
import chat from "../assets/screenshots/boardroom.png";
import team from "../assets/screenshots/team.png";
import roadmap from "../assets/screenshots/plan-and-promise.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const examples = await getCollection("examples");

const WHY = [
  { k: "Work that's really done", v: "Nothing counts as finished until yaaf checks it. An agent saying so isn't enough." },
  { k: "No surprise bills", v: "Every dollar is tracked. At the limit you set, work pauses." },
  { k: "A date you can trust", v: "The finish date comes from real progress. If it slips, you know." },
  { k: "No busywork", v: "Every task ties back to your goal. Nothing is invented to look busy." },
];

const STEPS = [
  { n: "01", k: "Describe it", v: "Write what you want in a paragraph. yaaf drafts the plan, the team, the budget and the deadline." },
  { n: "02", k: "Try it free", v: "Watch the whole project play out with practice agents first. No AI costs." },
  { n: "03", k: "Let it run", v: "The team works for days or weeks. You get a daily summary and only the decisions that need you." },
];

const USES = [
  { k: "Fix your code overnight", v: "Each night, a crew picks the most useful fix in your repo and opens a pull request.", slug: "04-an-overnight-crew" },
  { k: "Research you can defend", v: "Analysts read a company's filings and write the report. Every claim links to its source.", slug: "10-read-the-filings" },
  { k: "Test a business idea", v: "Thirty days to prove real people want it, or a clear reason to stop.", slug: "09-one-idea-thirty-days" },
  { k: "Run a content engine", v: "Writers and an editor publish on your topic and learn what readers respond to.", slug: "12-a-content-engine" },
  { k: "Build a small app or game", v: "A developer, a designer and a tester build it together. You can read how they decided.", slug: "08-a-game-you-can-play" },
  { k: "Get a weekly briefing", v: "What changed in the things you depend on. Nothing you already know.", slug: "07-tell-me-what-changed" },
];

const TOUR = [
  {
    k: "Only what needs you.",
    v: "Your inbox holds the calls only you can make. Each one comes with a recommendation and says what happens if you do nothing.",
    src: inbox,
    alt: "The Inbox: four decisions waiting, with a $180 data purchase open on the right showing the case for it, the CEO's recommendation, and that it is denied automatically in three hours if nobody answers",
  },
  {
    k: "One manager to talk to.",
    v: "Ask your AI lead anything. Why did the date move? What's blocked? Say “from now on…” and it becomes a rule.",
    src: chat,
    alt: "Chat with Iris, the project's CEO agent: the user asks how confident she is in the deadline and tells her not to buy anything yet, and she answers with the numbers and a free alternative",
  },
  {
    k: "See who's doing what.",
    v: "Every agent has a name, a job and a running tab. Open one to see what it's working on and what it has cost today.",
    src: team,
    alt: "The Team page: an org chart of named agents with their status, and a drawer open on Maya, a research lead, showing her current task, runs today and $1.80 spent",
  },
  {
    k: "Know if you'll make the date.",
    v: "Progress is measured, not guessed. You see what's proven done, what's left, and when it will really finish.",
    src: roadmap,
    alt: "The Roadmap: 2 of 6 requirements settled, the promised date of Oct 30 and a projected finish of Oct 13, then each requirement in stages with its status",
  },
];

const OPEN = [
  { k: "Free", v: "No subscription, no account. You pay your AI provider directly, at their prices." },
  { k: "Yours", v: "It runs on your own server. Your projects, files and keys stay with you." },
  { k: "Any AI", v: "Claude, GPT, Gemini, DeepSeek and more. Mix them on one team." },
  { k: "Open", v: "Apache-2.0. Read every line and change anything." },
];

const VS = [
  { who: "A chatbot", v: "You ask, it answers, you check. Great for one task, but you're the project manager." },
  { who: "An agent framework", v: "You write the code that runs the agents. Great if you're building a product." },
  { who: "yaaf", v: "You describe the project. A managed AI team delivers it, checked and on budget.", us: true },
];
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="shell">
      <p class="tags"><span>Free</span><span>Open source</span><span>Self-hosted</span></p>
      <h1>Hire an AI team.<br /> Get the project&nbsp;done.</h1>
      <div class="hero-row">
        <p class="sub">
          Describe what you want in plain English. yaaf builds a team of AI agents, manages them for days or
          weeks, and checks every result. You step in only for the big decisions.
        </p>
        <div class="hero-act">
          <div class="btns">
            <Button href="#try" primary>Try it free</Button>
            <Button href="#tour">See it in action</Button>
          </div>
          <p class="hint">No account. No API key to try it. Pay only for the AI you use.</p>
        </div>
      </div>
    </div>
    <div class="shell shotwrap">
      <Shot src={overview} ratio="16 / 10" priority={true}
        alt="A project's Overview: on track for its Oct 30 date, 2 of 6 requirements met, $130 of a $400 budget spent, 3 agents working, three decisions waiting for you, and a message from the CEO agent"
        caption="One screen tells you if you're on track: progress, spend, who's working, and what needs you." />
    </div>
  </section>

  <!-- ============ WORKS WITH ============ -->
  <section class="runs">
    <div class="shell">
      <div class="runs-in">
        <p class="eyebrow">Works with</p>
        <ul>{["Claude", "GPT", "Gemini", "DeepSeek", "Kimi", "Qwen", "Mistral", "Grok", "Your own models"].map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ============ WHY ============ -->
  <Section eyebrow="Why yaaf" title="AI agents start strong. yaaf makes them finish."
    lede="Left alone, agents say they're done when they aren't, wander off task and run up the bill. yaaf manages them like a good boss would.">
    <div class="cells">
      {WHY.map((r, i) => (
        <div class="cell">
          <span class="eyebrow">0{i + 1}</span>
          <h3>{r.k}</h3>
          <p>{r.v}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============ STEPS ============ -->
  <Section eyebrow="How it works" title="Three steps. Then it runs without you.">
    <div class="cells c3">
      {STEPS.map((s) => (
        <div class="cell">
          <span class="eyebrow">{s.n}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/how-it-works/">How it works, in detail →</a></p>
  </Section>

  <!-- ============ USE CASES ============ -->
  <Section eyebrow="Use cases" title="What will you hand off?"
    lede={`Start from one of ${crews.length} ready-made teams, or describe your own.`}>
    <div class="cells c3">
      {USES.map((u) => (
        <a class="cell" href={`/examples/${u.slug}/`}>
          <h3>{u.k}</h3>
          <p>{u.v}</p>
          <span class="go">See the example →</span>
        </a>
      ))}
    </div>
    <p class="note">
      <a href="/examples/">All {examples.length} examples →</a>
      <span class="sep">·</span>
      <a href="/org/">{roles.length} roles to hire from →</a>
    </p>
  </Section>

  <!-- ============ TOUR ============ -->
  <Section id="tour" eyebrow="See it in action" title="You're the boss. Without the busywork."
    lede="Check in when you want. Approve what matters. The team handles the rest.">
    <div class="tour">
      {TOUR.map((t, i) => (
        <div class:list={["row", { flip: i % 2 === 1 }]}>
          <div class="copy">
            <span class="eyebrow">0{i + 1}</span>
            <h3>{t.k}</h3>
            <p>{t.v}</p>
          </div>
          <div class="pic"><Shot src={t.src} ratio="16 / 10" alt={t.alt} /></div>
        </div>
      ))}
    </div>
    <p class="note">Check in from the app, Slack, a daily email or <a href="/docs/mcp-server/">Claude</a>.</p>
  </Section>

  <!-- ============ COMPARE ============ -->
  <Section eyebrow="Compared" title="Why not just use ChatGPT?">
    <div class="cells c3">
      {VS.map((x) => (
        <div class:list={["cell", { us: x.us }]}>
          <span class="eyebrow">{x.who}</span>
          <p class="vs">{x.v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/compare/">Full comparison, including Paperclip →</a></p>
  </Section>

  <!-- ============ OPEN ============ -->
  <Section eyebrow="Free and open source" title="No subscription. No lock-in.">
    <div class="cells">
      {OPEN.map((k) => (
        <div class="cell">
          <h3>{k.k}</h3>
          <p>{k.v}</p>
        </div>
      ))}
    </div>
    <p class="note">
      Early days: yaaf is pre-1.0 with one maintainer. <a href="/docs/plan/">What's done and what isn't →</a>
    </p>
  </Section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; padding-top: 7.5rem; }
  .glow {
    position: absolute;
    inset: -10% 0 auto 0;
    height: 120%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 45% 38% at 78% 18%, color-mix(in srgb, var(--color-accent) 55%, transparent), transparent 70%),
      radial-gradient(ellipse 30% 26% at 92% 40%, color-mix(in srgb, var(--color-accent-2) 30%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 30% at 60% 45%, rgba(120, 90, 255, 0.18), transparent 70%);
    filter: blur(10px);
    opacity: 0.9;
  }
  /* Scanlines over the glow, and a fade to black under it. */
  .glow::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0 1px, transparent 1px 3px);
  }
  .glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, #000 72%);
  }
  .hero .shell { position: relative; }
  .tags { display: flex; flex-wrap: wrap; gap: 0; margin: 0 0 2.2rem var(--inset); }
  .tags span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border: 1px solid var(--color-line);
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.4);
  }
  .tags span + span { border-left: 0; }
  h1 {
    margin: 0;
    font-size: var(--text-hero);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 500;
    padding-left: var(--inset);
  }
  .hero-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 0;
    margin-top: 3rem;
    align-items: start;
  }
  .hero-row > * { padding-inline: var(--inset); }
  .sub { grid-column: 1 / span 2; margin: 0; font-size: 1.3rem; line-height: 1.45; color: var(--color-ink-2); max-width: 36ch; }
  .hero-act { grid-column: 3 / span 2; display: grid; gap: 14px; }
  .hint { margin: 0; font-size: 13.5px; color: var(--color-muted); }
  .shotwrap { margin-top: 5rem; padding-bottom: 6rem; }

  /* ---------- works with ---------- */
  .runs-in { border-top: 1px solid var(--color-line); padding-block: 2.2rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 0; align-items: center; }
  .runs-in > * { padding-inline: var(--inset); }
  .runs-in .eyebrow { margin: 0; }
  .runs-in ul { grid-column: 2 / span 3; list-style: none; margin: 0; padding-block: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .runs-in li { font-size: 1.15rem; letter-spacing: -0.02em; color: var(--color-ink-2); }

  /* ---------- tour ---------- */
  .tour { border-top: 1px solid var(--color-line); }
  .row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-line);
    align-items: center;
  }
  .copy { grid-column: 1; padding: 2.5rem var(--inset); }
  .copy h3 { margin: 1rem 0 0; font-size: 1.6rem; line-height: 1.15; letter-spacing: -0.035em; font-weight: 500; }
  .copy p { margin: 0.9rem 0 0; color: var(--color-ink-2); font-size: 16px; line-height: 1.55; }
  .pic { grid-column: 2 / span 3; padding: 2.5rem var(--inset); }
  .flip .copy { grid-column: 4; grid-row: 1; }
  .flip .pic { grid-column: 1 / span 3; grid-row: 1; }

  /* ---------- compare ---------- */
  .vs { font-size: 1.15rem !important; color: var(--color-ink) !important; line-height: 1.45 !important; letter-spacing: -0.015em; }
  .us { background: var(--color-surface-2) !important; }
  .us .eyebrow { color: var(--color-accent-hi); }

  .sep { margin: 0 10px; color: var(--color-muted); }

  @media (max-width: 1024px) {
    .hero { padding-top: 5rem; }
    .sub, .hero-act { grid-column: 1 / -1; }
    .runs-in .eyebrow, .runs-in ul { grid-column: 1 / -1; }
    .row, .flip { grid-template-columns: 1fr; }
    .copy, .pic, .flip .copy, .flip .pic { grid-column: 1; grid-row: auto; }
    .copy { padding-bottom: 0; }
  }
  @media (max-width: 640px) {
    .shotwrap { margin-top: 3.5rem; padding-bottom: 4rem; }
    .copy { padding-top: 2rem; }
    .pic { padding-block: 1.5rem 2rem; }
  }
</style>
