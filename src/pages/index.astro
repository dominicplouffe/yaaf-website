---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import OrgChart from "../components/OrgChart.astro";
import Term from "../components/Term.astro";
import Shot from "../components/Shot.astro";
import { SITE, REPO_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";

import review from "../assets/screenshots/review.png";
import cockpit from "../assets/screenshots/cockpit-overview.png";
import boardroom from "../assets/screenshots/boardroom.png";
import work from "../assets/screenshots/work-and-proof.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const challengers = roles.filter((r) => r.data.category === "challenge");

/** The hero org: the thesis, drawn. */
const REHEARSE = `<i># try the whole thing before you pay for any of it</i>
<b>$</b> yaaf rehearse examples/01-your-first-hour.json`;

const DEPLOY = `<i># secrets, images, Postgres, migrations, the role library,</i>
<i># and your login token printed at the end. Safe to re-run.</i>
<b>$</b> git clone ${SOURCE_IS_PUBLIC ? "https://github.com/dominicplouffe/yaaf.git" : "&lt;your-yaaf-remote&gt;"} yaaf &amp;&amp; cd yaaf
<b>$</b> ./deploy_single_server.sh`;

const CONNECT = `<b>$</b> yaaf mcp-token mint my-laptop --chairman you@example.com --scopes read
<i>→ ymt_…</i>

<b>$</b> claude mcp add --transport http yaaf http://localhost:8080/mcp \\
    --header <u>"Authorization: Bearer ymt_…"</u>`;

const HERO_TEAMS = [
  { name: "Research", role: "Equity Analyst", employees: ["Maya", "Tobias"], lead: "Maya" },
  { name: "Macro", role: "Macro Analyst", employees: ["Ines"], lead: null },
  { name: "Risk", role: "Risk Manager", employees: ["Owen"], lead: null, challenge: true },
  { name: "Editorial", role: "Market Writer", employees: ["Ada"], lead: null },
];

const BEATS = [
  {
    k: "Roles, not one generalist",
    v: "A risk seat that can veto a research seat is two agents with different charters, different context and different instructions, not one model asked to “also consider the risks.”",
  },
  {
    k: "A CEO takes you out of the queue",
    v: "In a chat session you are the loop: nothing happens until you type. With a CEO, the next piece of work is chosen, priced, assigned and finished while you sleep.",
  },
  {
    k: "A budget makes it safe to walk away",
    v: "You are not trusting an agent to be sensible about money. Every run is metered, killed ones included. At 80% the CEO is warned; at the cap the project pauses itself.",
  },
];

const STEPS = [
  { n: "01", k: "Draft the crew", v: "Goal, teams, budget, deadline, hired from a library of job descriptions rather than invented." },
  { n: "02", k: "Get argued with", v: "The platform grades the goal against the ten things it has to contain to work. Free, before anything exists." },
  { n: "03", k: "Rehearse it for $0", v: "The whole project simulated on scripted agents: where it stalls, what it costs, how often it stops and waits for you." },
  { n: "04", k: "Hire it for real", v: "A CEO, the desks, a budget, a delivery date and a channel each. Then it runs without you, and emails you what happened." },
];

const RULES = [
  { k: "“Done” means verified", v: "Tests run in a sandbox, by the platform, not by the agent that wants them to pass. There is no agent verb that writes “met.”" },
  { k: "Work that makes nothing true is refused", v: "Every task has to serve a requirement: something that must be true at the end, carrying its own test." },
  { k: "The date can't quietly slip", v: "The platform stamps the date from measured pace and re-projects every tick. Past the promise, new scope freezes." },
  { k: "Money that can't run away", v: "Every run metered against a cap that pauses the project by itself. Real-world spending has its own separate envelope." },
  { k: "Loops that can't burn a night", v: "Two agents talking to each other at full price is a failure mode with a brake, not a surprise on the invoice." },
  { k: "Everything on the record", v: "Every message, run, dollar, decision and refusal, plus random samples of “completed” work dealt to you to spot-check." },
];

const ASKS = [
  {
    q: "“Run our ad account end to end. A standup every morning and a Monday memo I can forward to the client without editing it.”",
    a: "Four desks: strategy, analytics, attribution, and an executability check whose entire job is to kill clever recommendations nobody can implement. At month close the platform pulls the platform's own reports and grades the desk against them.",
  },
  {
    q: "“Here is my brokerage account. Run it like a real desk, and stop asking me what I think.”",
    a: "Research, macro, signals and a book, plus a risk seat and a compliance seat that can veto a trade the research seat is in love with. Every position arrives as a ticket with the argument attached.",
  },
  {
    q: "“Can we afford to retire early? Don't tell me yes. Prove it.”",
    a: "Six teams, including a verification seat paid to recompute the modeller's own numbers and disagree with them. Nothing reaches you uncited.",
  },
  {
    q: "“Book our February trip. I don't want a spreadsheet, I want a confirmation number.”",
    a: "A research team pricing five real itineraries live, and a booking desk that stands behind exactly one. The finish line cannot be faked: a record locator and a charge on your card. Nobody marks this one done except the resort.",
  },
];
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="blueprint bp" aria-hidden="true"></div>
    <div class="shell inner">
      <div class="copy">
        <p class="tags">
          <span>Multi-agent platform</span>
          <span>Apache-2.0</span>
          <span class="wip"><i aria-hidden="true"></i>Pre-1.0 · actively developed</span>
        </p>
        <h1 class="balance">Agents don't need a better&nbsp;prompt.<br />They need an org&nbsp;chart.</h1>
        <p class="lede pretty">
          yaaf hires a crew: roles with their own charters, a CEO that picks the next
          piece of work, a budget that stops itself, a delivery date nobody can quietly
          move. The rules live in the server, where an agent's token can't reach them.{" "}
          <strong>You're the chairman.</strong>
        </p>
        <p class="ctas">
          <a class="btn primary" href="/why/">Why it's different</a>
          <a class="btn" href="/examples/">See twelve projects</a>
          {SOURCE_IS_PUBLIC && <a class="btn ghost" href={REPO_URL}>GitHub ↗</a>}
        </p>
        <Term class="cmd" code={REHEARSE} note="Runs your spec as a real project on the real platform, every rule and every refusal, with scripted agents standing in for models. No API key. No dollars." />
      </div>

      <div class="chartwrap">
        <p class="eyebrow ct">One project, as the platform sees it</p>
        <OrgChart ceo="CEO" ceoRole="picks, prices and assigns the next piece of work" teams={HERO_TEAMS} />
        <p class="legend">
          <span class="k chair"></span> you <span class="k ceo"></span> executive
          <span class="k chal"></span> hired to disagree
        </p>
      </div>
    </div>
  </section>

  <!-- ================= RULES ================= -->
  <Section eyebrow="Layer one · the part that isn't a bet" title="A prompt is a suggestion. A 403 is not.">
    <p class="big pretty">
      Leave an agent running for an afternoon and you meet the failure modes. It marks
      its own work done. It invents busywork and calls it progress. It loops with
      another agent at full price. The usual fix is a better prompt, but a clever
      model talks itself around one. <strong>So in yaaf the rules live in the server.</strong>{" "}
      Agents act only through an authenticated API on short-lived tokens, and every
      rule is a refusal or an automatic state change. An agent can't be argued out of
      a rule it never held.
    </p>
    <div class="rules">
      {RULES.map((r) => (
        <div class="rule-c">
          <h3>{r.k}</h3>
          <p>{r.v}</p>
        </div>
      ))}
    </div>
    <p class="foot-note">
      Each of those is a test, not a paragraph. <strong>1,347 of them</strong> drive the
      real app over HTTP the way an agent would: forged tokens, wrong roles, rephrased
      requests. They are free, offline, and they test <strong>the rules, not the models</strong>.
      The rules are the part an agent argues with.{" "}
      <a href="/docs/governance/">Every rule and its default →</a>{" · "}
      <a href="/docs/security/">What contains an agent, and what doesn't →</a>
    </p>
    <div class="layers">
      <p>
        <strong>This layer does not depend on the next one.</strong> Solo mode runs a
        single agent under byte-identical governance: same queues, same requirements,
        same verification, same cap, same audit. If you think one good agent beats a
        team, take this floor and skip the org chart. It was built to stand on its own,
        because it might have to.
      </p>
    </div>
  </Section>

  <!-- ================= THREE BEATS ================= -->
  <Section eyebrow="Layer two · the bet" title="You build agents the way you build a company." lede="Multiple roles doing one thing each beat one role doing many. That is a hypothesis, not a finding. It is the same one that makes a company work, and the argument against it is good: every boundary between agents is a place context gets summarised and lost." grid={true}>
    <div class="beats">
      {BEATS.map((b) => (
        <div class="beat">
          <h3>{b.k}</h3>
          <p>{b.v}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ================= LIFECYCLE ================= -->
  <Section eyebrow="From a paragraph to a payroll" title="One sitting, four steps." grid={true}>
    <ol class="steps">
      {STEPS.map((s) => (
        <li>
          <span class="sn">{s.n}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ================= COCKPIT ================= -->
  <Section eyebrow="The standing meeting" title="The CEO brings the numbers. You decide." grid={true}
    lede="This is the screen the whole thing is for: what it cost against what it estimated, a date that re-projected itself, and the levers a human can pull — each one recorded with your reason and shown at the next review beside what it bought.">
    <div class="shots">
      <Shot src={review} crop={600} priority={true}
        alt="The Review tab: pace, requirements met since last review, the commitment at risk with its promised and projected dates, budget, audit coverage and worst offender; below them the CEO's variance narrative and the chairman's six levers"
        caption="The CEO closes a stage 28 runs against 23 estimated, moves its own bias multiplier to 1.21, and applies it to the rest of the plan. Then it tells you the one thing it will not do without you: buy a licensed data feed. It proposes the free route instead." />
      <Shot src={work} crop={620}
        alt="The Work tab: the platform's sampled close waiting on the chairman, the read-only board, and every piece of evidence with its verification status including a failed check"
        caption="The platform picked a finished claim at random and dealt it to you, because AI reviewers approve nearly everything and you don't. One task sits blocked on a licence nobody will buy without asking." />
      <Shot src={boardroom} crop={500}
        alt="The Boardroom tab: the chairman asks the CEO how confident it is in the 30th; the CEO answers with the estimate-to-actual ratio, its re-projection, and what would move it"
        caption="Boardroom. Ask the CEO how confident it is in the 30th. It answers with the estimate-to-actual ratio, its re-projection, and what would move it." />
    </div>
    <p class="foot-note"><a href="/docs/dashboard/">Every screen, and what you do there →</a></p>
  </Section>

  <!-- ================= THE ORG ================= -->
  <Section eyebrow="The library" title="Hired, not invented."
    lede="A project doesn't start from a blank prompt. It hires from a library: each role a system prompt, a model, an effort level and tool permissions somebody already argued about.">
    <div class="counts">
      <a class="n" href="/org/#roles"><strong>{roles.length}</strong><span>job descriptions</span></a>
      <a class="n" href="/org/#crews"><strong>{crews.length}</strong><span>pre-built crews</span></a>
      <a class="n hi" href="/org/#challenge"><strong>{challengers.length}</strong><span>hired to disagree</span></a>
      <a class="n" href="/docs/mcp-server/"><strong>32</strong><span>MCP tools</span></a>
    </div>
    <p class="foot-note">
      That third number is the one that matters. A quarter of the library exists to
      attack the other three quarters' work: a red team, a plan adversary, an
      executability checker, a data skeptic, a risk seat that can veto.{" "}
      <strong>One agent checking its own work has the same blind spots in both seats.</strong>{" "}
      <a href="/org/">Read the staff directory →</a>
    </p>
  </Section>

  <!-- ================= WHAT PEOPLE HAND IT ================= -->
  <Section eyebrow="What it is built to be handed" title="None of these is a prompt you re-run." grid={true}
    lede="These are the shapes the crews and examples are designed around. Each one has to survive weeks, wake up without you, and be graded by something that isn't itself.">
    <div class="asks">
      {ASKS.map((a) => (
        <article class="ask">
          <p class="q">{a.q}</p>
          <p class="a">{a.a}</p>
        </article>
      ))}
    </div>
    <p class="foot-note"><a href="/examples/">Twelve projects you can import and run →</a></p>
  </Section>

  <!-- ================= DIFFERENT HOW ================= -->
  <Section eyebrow="Different how?" title="A framework composes agents. yaaf governs them.">
    <div class="diff">
      <div>
        <p class="eyebrow">vs. agent frameworks</p>
        <p>LangGraph, CrewAI and friends give you a library: coordination you write as code, rules expressed as prompts, “done” when the graph returns. yaaf is the layer underneath that — the one that refuses, meters and verifies.</p>
      </div>
      <div>
        <p class="eyebrow">vs. OpenClaw &amp; Hermes</p>
        <p>They make <em>one agent</em> more present and more capable over time. yaaf makes <em>many agents</em> accountable over weeks. And they're not competitors: yaaf is an MCP server, so anything that speaks MCP is a front end for it.</p>
      </div>
      <div>
        <p class="eyebrow">vs. a good skill</p>
        <p>yaaf runs your skills. A skill is a capability; yaaf decides which capability to point at what, checks it got done, pays for it from a capped budget and keeps the receipt. The difference isn't capability — it's governance and duration.</p>
      </div>
    </div>
    <p class="foot-note"><a href="/why/">The full comparison, with the table →</a></p>
  </Section>

  <!-- ================= HONEST ================= -->
  <Section eyebrow="What you give up" title="Read this before you install anything." grid={true}>
    <div class="honest">
      <ul>
        <li><strong>You deploy and run a thing.</strong> Postgres, two containers, a box. A skill is a file.</li>
        <li><strong>Setup is minutes, not seconds.</strong> A goal worth planning from takes longer to write than a prompt, on purpose.</li>
        <li><strong>The floor is higher than the ceiling is high.</strong> Planning, review and verification cost tokens. On a one-sitting task that buys you nothing.</li>
        <li><strong>Nobody has published what it costs.</strong> Not even me. The caps in the examples are budgets you set, not bills anyone paid, and the fire drill refuses to invent a price rather than print a plausible one. <code>yaaf receipt</code> prints a project's whole life — spend on one side, and on the other only what the platform itself verified — so the number will be a receipt rather than a claim. A guess would be worse than the silence.</li>
        <li><strong>It is pre-1.0.</strong> APIs move, and there are sharp edges.</li>
      </ul>
      <div class="kill">
        <p class="eyebrow">The bet, and what would kill it</p>
        <p>Nobody has shown that a CEO plus a team beats one good agent on the same budget and rules, and yaaf doesn't claim to have. <strong>Solo mode</strong> runs a single agent under byte-identical governance, so the same goal can go to a hierarchy and to one brain and the bills compared.</p>
        <p>The repository publishes its own kill condition: if the org arm doesn't win on the pre-registered rubric (blind-judged quality, verified external evidence, cost, wall-clock), then yaaf-as-an-org-framework is shelved and layer one stands on its own.</p>
        <p class="lk"><a href="/docs/plan/">The plan, the kill conditions, and what is deliberately not built →</a></p>
      </div>
    </div>

    <div class="failshot">
      <Shot src={cockpit} crop={498}
        alt="The cockpit of a project that is not working: nothing working now, one run in five ended early, no deliverable published, and CEO judgment at 20 per cent"
        caption="And this is one that is not working. Nothing published, one run in five dead, the CEO's judgement running at 20% — one of its five bets ever produced real-world proof. The dashboard's first job is to tell you that on the way past, in red, rather than after the invoice. A screen that only looks good is a screen that is lying to you." />
    </div>
  </Section>

  <!-- ================= PROVENANCE + OPEN QUESTIONS ================= -->
  <Section eyebrow="Before you go looking" title="This git history is two weeks old. The project is not." grid={true}
    lede="You would find the first half in one click, so here is both halves, with what follows from each.">
    <div class="prov">
      <div class="prov-nums">
        <div><strong>13</strong><span>days of git history</span></div>
        <div><strong>135</strong><span>commits</span></div>
        <div><strong>~49%</strong><span>authored by Claude Code</span></div>
        <div><strong>0</strong><span>outside security reviews</span></div>
      </div>
      <div class="prov-txt">
        <p>
          The history was restarted on 30 August, so the repository is younger than the
          thing it holds. The screenshots further up this page are from a desk that was
          already running a week before that first commit, and the build stamp in the
          corner of each one says so.
        </p>
        <p>
          It was built fast and in the open with Claude Code, and roughly half the
          commits are authored by it. That is the method, not a disclaimer. The design
          is much older than either: years of running teams, written down first and
          then built quickly.
        </p>
        <p>
          <strong>What that bought:</strong> a policy engine with 1,347 tests attacking
          it over HTTP, a role library that is data rather than prose, and a suite that
          runs offline for $0.
          <strong> What it has not bought:</strong> a project anyone but me has run for
          a month, a published bill, or a security review by someone who did not write
          the thing. Both halves are true at the same time, and the second half is the
          one that matters.
        </p>
      </div>
    </div>

    <div class="asks-q">
      <p class="eyebrow qh">Three things I would rather have torn apart than praised</p>
      <ol>
        <li>
          <strong>Does the org layer earn its tokens?</strong> Every boundary between
          agents is a place context gets summarised and lost, and the case that one
          well-contexted agent beats a hierarchy is a good one. Solo mode exists so
          this is measurable rather than arguable. <em>What would you put in the
          rubric?</em>
        </li>
        <li>
          <strong>Is a server-side refusal actually enough?</strong> An agent holds the
          credentials its role was granted, has a shell and a network, and there is no
          egress control, and that allowlist was removed on purpose, and the reasoning is
          published. A prompt-injected agent can send what it holds anywhere.{" "}
          <em>Is the container boundary plus a scoped grant plus an audit trail a
          defensible place to stop?</em> <a href="/docs/security/">The threat model →</a>
        </li>
        <li>
          <strong>Is the requirement the right root object?</strong> Every task must
          serve something that has to be true at the end and carries its own test. It
          works beautifully for artifacts and badly for objectives: a rank, a revenue
          number, a deficit resist being a test, and the honest failure mode is that
          every requirement quietly becomes a grep over the workspace.{" "}
          <em>What is the better shape?</em>
        </li>
      </ol>
      <p class="foot-note">
        Issues and pull requests are the fastest way in. If you break one of the
        invariant tests, that is the contribution this project wants most.
      </p>
    </div>
  </Section>

  <!-- ================= INSTALL ================= -->
  <Section eyebrow="Install" title="One script, one box.">
    <div class="install">
      <Term label="Deploy" code={DEPLOY} />
      <Term label="Then connect Claude" code={CONNECT} />
    </div>
    <p class="foot-note">
      Start on the <code>read</code> scope: sees everything, signs nothing. Most of the
      value, none of the risk.{" "}
      <a href="/docs/deployment/">Deployment →</a>{" · "}
      <a href="/docs/mcp-server/">Every tool and scope →</a>
    </p>
  </Section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; padding-block: 64px 88px; border-bottom: 1px solid var(--color-line); overflow: hidden; }
  .bp { position: absolute; inset: 0; opacity: 0.6; pointer-events: none; }
  .hero .inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: 48px; align-items: center; }
  /* Grid items default to min-width:auto, so the terminal block's longest
     line would set the column width and push the copy out of the shell. */
  .copy, .chartwrap { min-width: 0; }

  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 22px; }
  .tags span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .tags .wip { color: var(--color-ink-2); }
  .tags .wip i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-warning); display: block; }

  h1 {
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.042em;
    font-weight: 650;
    margin: 0;
  }
  .lede { color: var(--color-ink-2); font-size: 1.1875rem; line-height: 1.6; margin: 22px 0 0; max-width: 52ch; }
  .lede strong { color: var(--color-ink); font-weight: 620; }

  .ctas { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 26px; }
  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 10px 17px;
    transition: background 0.15s, border-color 0.15s, filter 0.15s;
  }
  .btn:hover { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.2); }
  .btn.primary { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .btn.primary:hover { filter: brightness(1.1); background: var(--color-accent); }
  .btn.ghost { color: var(--color-ink-2); }

  .cmd { max-width: 560px; }

  .chartwrap {
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 22px 20px 18px;
  }
  .ct { text-align: center; margin: 0 0 20px; }
  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .legend .k { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-left: 10px; }
  .legend .k:first-child { margin-left: 0; }
  .legend .chair { background: var(--color-accent-2); }
  .legend .ceo { background: var(--color-accent); }
  .legend .chal { background: transparent; border: 1px solid var(--color-accent-2); }

  /* ---------- beats ---------- */
  .beats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .beat { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 20px; }
  .beat h3 { margin: 0; font-size: 16px; font-weight: 640; letter-spacing: -0.015em; }
  .beat p { margin: 10px 0 0; font-size: 14px; line-height: 1.65; color: var(--color-ink-2); }

  /* ---------- steps ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .steps li { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 18px; position: relative; }
  .sn { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.1px; color: var(--color-accent-hi); }
  .steps h3 { margin: 10px 0 0; font-size: 15px; font-weight: 640; }
  .steps p { margin: 8px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--color-ink-2); }

  /* ---------- rules ---------- */
  .big { font-size: 1.1875rem; line-height: 1.65; color: var(--color-ink-2); max-width: 68ch; margin: 0 0 36px; }
  .big strong { color: var(--color-ink); font-weight: 620; }
  .rules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .rule-c {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-accent);
    border-radius: var(--radius-card);
