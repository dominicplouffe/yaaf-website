---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Shot from "../components/Shot.astro";
import Cmd from "../components/Cmd.astro";
import CompanyChart from "../components/CompanyChart.astro";
import TeamDiagram from "../components/TeamDiagram.astro";
import AutonomyDial from "../components/AutonomyDial.astro";
import { SITE, REPO_URL, SHOW_COMPARE } from "../site.config.mjs";
import manifest from "../content/manifest.json";
import runtimes from "../content/runtimes.json";

import inbox from "../assets/screenshots/cockpit-overview.png";
import team from "../assets/screenshots/team.png";
import chat from "../assets/screenshots/boardroom.png";
import results from "../assets/screenshots/results.png";
import person from "../assets/screenshots/person.png";
import roadmap from "../assets/screenshots/plan-and-promise.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const examples = await getCollection("examples");

const providers = runtimes.providers.map((p) => p.label.replace(/ \(.*\)$/, ""));
const harnesses = runtimes.harnesses.map((h) => h.label.replace(/ \(.*\)$/, ""));
const SHOWN = 12;

const SHIFT = [
  { k: "Models", v: "Answer questions." },
  { k: "Agents", v: "Complete tasks." },
  { k: "Teams", v: "Pursue outcomes." },
];

const TRAIL = [
  { k: "Source", q: "Where did it come from?", v: "External evidence is fetched, hashed and snapshotted by the server, never taken at the agent's word." },
  { k: "Work", q: "How was it used?", v: "Nothing closes without observed evidence. “Done” on its own is refused." },
  { k: "Review", q: "Was it challenged?", v: "Critic seats can veto. A random sample of finished work is dealt to you to check." },
  { k: "Decision", q: "What can we defend?", v: "Every decision, yours or the CEO's, is on the record with its reason and can be reversed." },
];

const HORIZON = [
  { k: "A task", v: "A project that delivers one result and stops: a question answered with sources, a fix, a report.", when: "Today", slug: "02-settle-an-argument", ex: "Settle an argument, with sources" },
  { k: "An operation", v: "A project that keeps running: woken by the world at 3am, a standup each morning, a register that stays current.", when: "Today", slug: "03-a-desk-the-world-wakes", ex: "A desk the world wakes up" },
  { k: "A business", v: "Today a crew can test one idea for thirty days. Organizations that run a business with extensive autonomy, inside the boundaries their owner sets, are where this is going. We aren't there yet.", when: "The long view", slug: "09-one-idea-thirty-days", ex: "One idea, thirty days" },
];

const YESTERDAY = [
  "You type, it answers, you check. You are the loop.",
  "It says “done”. You find out it isn't.",
  "Two agents argue in circles all night, at full price.",
  "Nobody can tell you when it will be finished.",
  "Every morning starts from an empty chat.",
];
const TODAY = [
  "A CEO picks, prices and assigns the next piece of work while you sleep.",
  "Only the platform marks work done. It runs the test itself.",
  "Every run is metered live. At the wall, the company pauses itself.",
  "The date comes from measured pace. If it slips, new scope freezes.",
  "Each morning, a letter: what happened, and what waits on you.",
];

const LAYERS = [
  {
    k: "The model",
    v: `The weights. Claude, GPT, Gemini, DeepSeek, Mistral, Kimi, a local model. ${providers.length} providers.`,
    hue: "sky",
  },
  {
    k: "The agent harness",
    v: `Drives one model: its loop, its tools, its context. ${harnesses.join(", ")}. Every person on the chart runs in one.`,
    hue: "violet",
  },
  {
    k: "yaaf, the team harness",
    v: "Drives the company: who's hired, what's next, what it costs, when it's due, and whether it's really done. The rules live in the server, not the prompt.",
    hue: "dawn",
  },
];

const FOUND = [
  { k: "Describe it", v: `Tell the Founder what you want. It interviews you until nothing is assumed, then drafts the goal, the teams, the budget and the date, hiring from ${roles.length} job descriptions.` },
  { k: "Get argued with", v: "The goal is graded against the ten things a goal needs to work: a finish line, who it's for, what doesn't count. Before anything exists." },
  { k: "Rehearse it for $0", v: "The whole company runs on scripted agents first: where it would stall, what it would cost, how often it would stop and wait for you." },
  { k: "Hire it", v: "A CEO, its teams, a budget, a delivery date and a Slack channel each. Then it works for weeks." },
];

const TOUR = [
  {
    k: "Your company, live.",
    v: "The org chart shows who reports to whom, what each person is doing right now, the model they run on and what they've cost this month. When the work needs a new team, the CEO hires one and says why.",
    src: team,
    hue: "var(--color-gold)",
    alt: "A project's Team page: the chairman at the top, the CEO beneath, and each team — a newly hired Risk team drawn dashed with the CEO's reason — with what every person is doing, the model they run on, and what they have cost",
  },
  {
    k: "Your desk is the Inbox.",
    v: "A project opens on what waits on you, soonest consequence first. Each item says what happens if you do nothing. Decide in one click, snooze it, or undo it.",
    src: inbox,
    hue: "var(--color-rose)",
    alt: "A project's Inbox: the header with its status and a one-line scoreboard, then the three things waiting on the chairman with the selected one opened, and below it the CEO's latest word, what the CEO is watching and the calendar",
  },
  {
    k: "One person to talk to: the CEO.",
    v: "Ask why the date moved. Tell it to stop buying data and find the free route. Every answer shows what the team did to get there.",
    src: chat,
    hue: "var(--color-violet)",
    alt: "Chat with the CEO: the chairman asks for the free route; the CEO answers that Ines can rebuild the vintages from filing dates and has still filed the licence as a decision — with What they did open under the answer",
  },
  {
    k: "Results, with the receipts.",
    v: "Every deliverable says who made it and who checked it. Verified by yaaf, not graded by the agent that wrote it, with the chain from your goal down to the task.",
    src: results,
    hue: "var(--color-mint)",
    alt: "Results: each published deliverable with who made it and who checked it — verified by YAAF, read by Juno — and the selected one's evidence: the check, the goal-to-requirement-to-task chain, and what the run that made it did",
  },
  {
    k: "Every employee has a page.",
    v: "What they're working on and the requirement it serves, their week, what they made and who read it, the model they run on and what they cost.",
    src: person,
    hue: "var(--color-sky)",
    alt: "One person's page: what Maya is working on now and the requirement it serves, her run in flight, her week, what she has made and who read it, the model she runs on and her month's cost, and her recent runs",
  },
  {
    k: "A date nobody can quietly move.",
    v: "The date you signed sits next to the platform's own projection. Requirements are proven true one stage at a time.",
    src: roadmap,
    hue: "var(--color-sun)",
    alt: "Details › Roadmap: the commitment with its pace and spend, the date you signed against the platform's projection, and requirements in stages — two proven true, two in progress, one waiting for you to accept",
  },
];

const WHY = [
  { k: "Work that's really done", v: "Nothing counts as finished until yaaf checks it. An agent saying so isn't enough." },
  { k: "Money that stops itself", v: "Every run is metered, killed ones included. At the wall you set, the company pauses and tells you." },
  { k: "A date you can trust", v: "The finish date comes from real progress. If it slips, you know, and new scope waits." },
  { k: "Critics with teeth", v: "Risk and review seats can veto the work they check. The CEO can't fire the last one." },
];

const USES = [
  { k: "Fix your code overnight", v: "Each night, a crew picks the most useful fix in your repo and opens a pull request.", slug: "04-an-overnight-crew" },
  { k: "Research you can defend", v: "Analysts read a company's filings and write the report. Every claim links to its source.", slug: "10-read-the-filings" },
  { k: "Test a business idea", v: "Thirty days to prove real people want it, or a clear reason to stop.", slug: "09-one-idea-thirty-days" },
  { k: "Run a content engine", v: "Writers and an editor publish on your topic and learn what readers respond to.", slug: "12-a-content-engine" },
  { k: "Build a small app or game", v: "A developer, a designer and a tester build it together. You can read how they decided.", slug: "08-a-game-you-can-play" },
  { k: "Get a weekly briefing", v: "What changed in the things you depend on. Nothing you already know.", slug: "07-tell-me-what-changed" },
];

const OPEN = [
  { k: "Apache-2.0", v: "Read every line. Fork it. Change anything." },
  { k: "Your machine", v: "One command starts it on your laptop; one script puts it on a server. Projects, files and keys stay with you." },
  { k: "Your model keys", v: "Agents pay your provider directly, at their prices. yaaf has nothing to sell you." },
  { k: "Nobody watching", v: "No account to make, no hosted version, no telemetry." },
];

const VS = [
  { who: "A chatbot", v: "You ask, it answers, you check. Great for one question. You're the project manager." },
  { who: "An agent harness", v: "Claude Code or Codex drives one agent well. You're still its manager, and the loop." },
  { who: "An agent framework", v: "You write the code that runs the agents. Great if you're building a product." },
  { who: "yaaf", v: "You found a company. A CEO runs the team; the platform checks the work, the money and the date.", us: true },
];
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="sky" aria-hidden="true"><div class="sun"></div></div>
    <div class="shell">
      <p class="tags">
        <span class="t1">Open source</span><span class="t2">Apache-2.0</span><span class="t3">Runs on your machine</span><span class="t4">Any model</span>
      </p>
      <p class="belief">Great ideas deserve <span class="dawn-text">great teams.</span></p>
      <h1>
        <span class="l1">Build a company.</span>
        <span class="l2">Hire a CEO.</span>
        <span class="l3 dawn-text">Let the team work.</span>
      </h1>
      <div class="hero-row">
        <div class="sub">
          <p>
            Tell yaaf what you want to accomplish. An AI CEO assembles specialists and manages the work, the platform
            checks every result, and the company remembers what it learns. <strong>You decide how much control to keep.</strong>
          </p>
          <p class="sub-2">
            yaaf is <strong>the harness for teams of harnesses</strong>. Claude Code, Codex and Gemini CLI each drive one
            agent; yaaf gives each of them a job, a CEO to answer to, a budget and a deadline, under rules no agent can
            talk its way around.
          </p>
        </div>
        <div class="hero-act">
          <div class="btns">
            <Button href="#how" primary>See how it works</Button>
            <Button href="#start">Rehearse a company for $0</Button>
          </div>
          <p class="hint"><a href={REPO_URL}>Get yaaf on GitHub</a>. Apache-2.0. No account, no hosted tier, no telemetry. Your agents pay your model provider, at their prices.</p>
        </div>
      </div>
    </div>
    <div class="shell chartwrap">
      <CompanyChart />
    </div>
  </section>

  <!-- ============ WORKS WITH ============ -->
  <section class="runs">
    <div class="shell">
      <div class="runs-in">
        <p class="eyebrow">Each seat on its own model</p>
        <ul>
          {providers.slice(0, SHOWN).map((p) => <li>{p}</li>)}
          <li class="more"><a href="/runtimes/">+ {providers.length - SHOWN} more →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 1. WHY YAAF EXISTS ============ -->
  <Section id="why" eyebrow="Why yaaf exists" title="Great ideas deserve great teams."
    lede="The world is full of people with ideas they cannot pursue. Not because the ideas aren't good enough, but because bringing one to life takes specialists, leadership and coordination. <strong>Building that team has always been the barrier.</strong>">
    <div class="shift">
      {SHIFT.map((x, i) => (
        <div class:list={["step", { last: i === SHIFT.length - 1 }]}>
          <span class="eyebrow">0{i + 1}</span>
          <h3>{x.k}</h3>
          <p>{x.v}</p>
        </div>
      ))}
    </div>
    <div class="belief-2">
      <p class="b-l">Intelligence is not enough.<br /><span class="dawn-text">Organization makes it useful.</span></p>
      <p class="b-r">
        A researcher finds evidence. A builder executes. A critic challenges the result. A CEO brings it together, and
        you decide what success means. No single seat needs to know everything. Click a seat to see what it owns and
        the rule that binds it.
      </p>
    </div>
    <TeamDiagram />
    <p class="note"><a href="/manifesto/">Why we built it: read the manifesto →</a></p>
  </Section>

  <!-- ============ YESTERDAY / TODAY ============ -->
  <Section eyebrow="Yesterday → today" title="Yesterday you babysat an agent. Today you run a company.">
    <div class="eras">
      <div class="era old">
        <p class="era-tag">Yesterday</p>
        <h3>One agent, one chat, and you.</h3>
        <ul>{YESTERDAY.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="era new">
        <p class="era-tag">Today, with yaaf</p>
        <h3>A company that answers to you.</h3>
        <ul>{TODAY.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </Section>

  <!-- ============ FOUNDING ============ -->
  <!-- ============ 2. HOW IT WORKS ============ -->
  <Section id="how" eyebrow="How it works" title="From one paragraph to a staffed company."
    lede="Say it in the dashboard, or in the Claude window you already have open.">
    <div class="cells hued">
      {FOUND.map((s, i) => (
        <div class="cell">
          <span class="eyebrow">0{i + 1}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/how-it-works/">How it works, in detail →</a></p>
  </Section>

  <!-- ============ THE HARNESS ============ -->
  <Section id="harness" eyebrow="The harness, one level up" title="A harness drives one agent. yaaf harnesses the whole team."
    lede="Claude Code, Codex, Gemini CLI and OpenCode give one model a loop and tools. yaaf is what's around them: <strong>the company they work for.</strong>">
    <div class="layers">
      {LAYERS.map((l, i) => (
        <div class={`layer-row lv${i} h-${l.hue}`}>
          <span class="lnum">0{i + 1}</span>
          <h3>{l.k}</h3>
          <p>{l.v}</p>
        </div>
      ))}
    </div>
    <div class="quote">
      <blockquote>
        <p>“A harness is transport. It decides how a model is driven, never what the model may do.”</p>
      </blockquote>
      <p class="qr">
        That line is from yaaf's own design. What a model <em>may</em> do is decided in one place, the server, and
        every rule is a refusal. Break one and an agent gets a 403, not a stern reminder.{" "}
        <a href="/runtimes/">Every harness and provider →</a>
      </p>
    </div>
  </Section>

  <!-- ============ TOUR ============ -->
  <Section id="tour" eyebrow="The real thing" title="Then you chair the board."
    lede="Check in when you want. The company keeps working when you don't.">
    <div class="tour">
      {TOUR.map((t, i) => (
        <div class:list={["row", { flip: i % 2 === 1 }]} style={`--hue:${t.hue}`}>
          <div class="copy">
            <span class="eyebrow">0{i + 1}</span>
            <h3>{t.k}</h3>
            <p>{t.v}</p>
          </div>
          <div class="pic"><Shot src={t.src} ratio="16 / 10" alt={t.alt} glow={t.hue} priority={i === 0} /></div>
        </div>
      ))}
    </div>
    <p class="note">Check in from the app, the terminal (<code>yaaf status</code>), Slack, a daily letter, or <a href="/docs/mcp-server/">Claude over MCP</a>.</p>
  </Section>

  <!-- ============ 3. YOUR LEVEL OF CONTROL ============ -->
  <Section id="control" eyebrow="Your level of control" title="You decide how much authority to delegate."
    lede="Some chairmen approve every important decision. Others set a goal and a budget and let the CEO run. Both belong in yaaf. <strong>Move the dial.</strong>">
    <AutonomyDial />
    <p class="note">The dial is five real switches in the project's constitution, which no agent can edit. <a href="/docs/autonomy/">How autonomy works →</a></p>
  </Section>

  <!-- ============ 4. WHY TRUST YAAF ============ -->
  <Section id="trust" eyebrow="Why trust yaaf" title="Trust is earned through evidence."
    lede="A confident answer is not a correct one, and one agent agreeing with another proves nothing. Left alone, agents say they're done when they aren't. yaaf gives them checks and balances.">
    <div class="trail">
      {TRAIL.map((t, i) => (
        <div class="tr">
          <span class="eyebrow">0{i + 1} · {t.k}</span>
          <h3>{t.q}</h3>
          <p>{t.v}</p>
        </div>
      ))}
    </div>
    <div class="cells hued">
      {WHY.map((r, i) => (
        <div class="cell">
          <span class="eyebrow">0{i + 1}</span>
          <h3>{r.k}</h3>
          <p>{r.v}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============ USE CASES ============ -->
  <!-- ============ 5. WHAT BECOMES POSSIBLE ============ -->
  <Section id="possible" eyebrow="What becomes possible" title="From a task, to an operation, to one day a business."
    lede="Some companies exist for an afternoon. Others run continuously. The last column is a direction, not a feature.">
    <div class="horizon">
      {HORIZON.map((h, i) => (
        <a class:list={["hz-c", { far: i === HORIZON.length - 1 }]} href={`/examples/${h.slug}/`}>
          <span class="when">{h.when}</span>
          <h3>{h.k}</h3>
          <p>{h.v}</p>
          <span class="go">{h.ex} →</span>
        </a>
      ))}
    </div>
    <h3 class="uses-h">What will your company do? Start from one of {crews.length} ready-made teams, or describe your own.</h3>
    <div class="cells c3 hued">
      {USES.map((u) => (
        <a class="cell" href={`/examples/${u.slug}/`}>
          <h3>{u.k}</h3>
          <p>{u.v}</p>
          <span class="go">See the example →</span>
        </a>
      ))}
    </div>
    <p class="note">
      <a href="/examples/">All {examples.length} examples →</a>
      <span class="sep">·</span>
      <a href="/org/">{roles.length} roles to hire from →</a>
    </p>
  </Section>

  <!-- ============ COMPARE (hidden while SHOW_COMPARE is off) ============ -->
  {SHOW_COMPARE && <Section eyebrow="Compared" title="Why not just use Claude Code?">
    <div class="cells vsg">
      {VS.map((x) => (
        <div class:list={["cell", { us: x.us }]}>
          <span class="eyebrow">{x.who}</span>
          <p class="vs">{x.v}</p>
        </div>
      ))}
    </div>
    <p class="note">yaaf runs Claude Code and Codex. It doesn't replace them; it gives them a company. <a href="/compare/">Full comparison, including Paperclip →</a></p>
  </Section>}

  <!-- ============ OPEN SOURCE ============ -->
  <Section id="start" eyebrow="Open source" title="Not a service. Software you own.">
    <div class="cells hued">
      {OPEN.map((k) => (
        <div class="cell">
          <h3>{k.k}</h3>
          <p>{k.v}</p>
        </div>
      ))}
    </div>
    <div class="start">
      <div class="start-l">
        <h3>Run a whole company in three lines.</h3>
        <p>The last one rehearses an example project end to end on scripted agents. No key, no Docker, $0. When you're ready for real agents, <code>yaaf up</code> starts everything and prints the address.</p>
        <p class="note"><a href="/docs/deployment/">Install guide →</a><span class="sep">·</span><a href="/docs/creating-a-project/">Your first project →</a></p>
      </div>
      <div class="start-r">
        <Cmd cmd={`git clone ${REPO_URL} && cd yaaf`} />
        <Cmd cmd="pip install -e ." />
        <Cmd cmd="yaaf rehearse examples/01-your-first-hour.json" />
      </div>
    </div>
    <p class="note">
      Early days: pre-1.0, {manifest.history.commits} commits since {new Date(manifest.history.firstCommit).toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: "UTC" })}, built in the open with Claude Code. <a href="/docs/plan/">What's done and what isn't →</a>
    </p>
  </Section>
</BaseLayout>

<style>
  /* ---------- hero: the sun coming up ---------- */
  .hero { position: relative; overflow: hidden; padding-top: 7rem; }
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 15% 10%, color-mix(in srgb, var(--color-violet) 30%, transparent), transparent 70%),
      radial-gradient(50% 35% at 90% 15%, color-mix(in srgb, var(--color-sky) 22%, transparent), transparent 70%);
  }
  .sun {
    position: absolute;
    left: 50%;
    top: 27rem;
    width: min(1500px, 160vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%,
      color-mix(in srgb, var(--color-gold) 80%, transparent) 0%,
      color-mix(in srgb, var(--color-sun) 65%, transparent) 13%,
      color-mix(in srgb, var(--color-rose) 50%, transparent) 26%,
      color-mix(in srgb, var(--color-violet) 34%, transparent) 40%,
      transparent 60%);
    filter: blur(30px);
    animation: rise 2.4s var(--ease) both;
  }
  @keyframes rise {
    from { transform: translate(-50%, 18%); opacity: 0; }
    to { transform: translate(-50%, 0); opacity: 1; }
  }
  .hero .shell { position: relative; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 2.2rem var(--inset); }
  .tags span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 1px solid;
    background: color-mix(in srgb, var(--color-page) 60%, transparent);
  }
  .t1 { color: var(--color-gold); border-color: color-mix(in srgb, var(--color-gold) 50%, transparent); }
  .t2 { color: var(--color-rose); border-color: color-mix(in srgb, var(--color-rose) 50%, transparent); }
  .t3 { color: var(--color-sky); border-color: color-mix(in srgb, var(--color-sky) 50%, transparent); }
  .t4 { color: var(--color-mint); border-color: color-mix(in srgb, var(--color-mint) 50%, transparent); }
  h1 {
    margin: 0;
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.055em;
    font-weight: 550;
    padding-left: var(--inset);
  }
  h1 span { display: block; }
  .l3 { padding-bottom: 0.08em; }
  .hero-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 0;
    margin-top: 2.6rem;
    align-items: start;
  }
  .hero-row > * { padding-inline: var(--inset); }
  .sub { grid-column: 1 / span 2; margin: 0; font-size: 1.25rem; line-height: 1.5; color: var(--color-ink-2); max-width: 40ch; }
  .sub strong { color: var(--color-ink); font-weight: 550; }
  .hero-act { grid-column: 3 / span 2; display: grid; gap: 14px; }
  .hint { margin: 0; font-size: 13.5px; color: var(--color-ink-2); max-width: 46ch; }
  .chartwrap { margin-top: 5.5rem; padding-bottom: 6rem; }

  .belief {
    margin: 0 0 1.4rem;
    padding-left: var(--inset);
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 450;
    color: var(--color-ink);
  }
  .sub-2 { margin: 1rem 0 0; font-size: 15.5px; line-height: 1.55; color: var(--color-ink-2); }
  .sub p:first-child { margin: 0; }
  .hint a { color: var(--color-accent-hi); text-decoration: none; }
  .hint a:hover { text-decoration: underline; text-underline-offset: 3px; }

