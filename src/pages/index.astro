---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Shot from "../components/Shot.astro";
import Icon from "../components/Icon.astro";
import Receipt from "../components/Receipt.astro";
import Meter from "../components/Meter.astro";
import AutonomyDial from "../components/AutonomyDial.astro";
import { SITE, REPO_URL, SHOW_COMPARE } from "../site.config.mjs";
import manifest from "../content/manifest.json";
import runtimes from "../content/runtimes.json";

import teamLight from "../assets/brand/screens/team-light.png";
import teamDark from "../assets/brand/screens/team-dark.png";
import homeLight from "../assets/brand/screens/home-light.png";
import homeDark from "../assets/brand/screens/home-dark.png";
import chatLight from "../assets/brand/screens/chat-light.png";
import chatDark from "../assets/brand/screens/chat-dark.png";
import resultsLight from "../assets/brand/screens/results-light.png";
import resultsDark from "../assets/brand/screens/results-dark.png";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const challengers = roles.filter((r) => r.data.category === "challenge").length;
const tests = manifest.tests.toLocaleString("en-US");

const providers = runtimes.providers.map((p) => p.label.replace(/ \(.*\)$/, ""));
const harnesses = runtimes.harnesses.map((h) => h.label.replace(/ \(.*\)$/, ""));

/** A seat is a real role from the library; fail the build if one is renamed away. */
const role = async (slug: string) => {
  const r = await getEntry("roles", slug);
  if (!r) throw new Error(`home: no role “${slug}” in the library`);
  return r.data.name;
};
const [ceoRole, researchRole, buildRole, criticRole] = await Promise.all(["ceo", "researcher", "engineer", "adversary"].map(role));

/** The four rules. `proof` is the mono line: a count from the sync, or the refusal itself. */
const RULES = [
  {
    icon: "verified",
    k: "Done means verified",
    v: "Nothing counts as finished until yaaf checks it. The platform runs the test itself. An agent saying so isn't enough.",
    proof: `${tests} tests · “done” alone is refused`,
  },
  {
    icon: "budget-wall",
    k: "A budget that stops itself",
    v: "Every run is metered, killed ones included. At the wall you set, the company pauses and tells you.",
    proof: "at the wall · the project pauses",
  },
  {
    icon: "honest-date",
    k: "An honest date",
    v: "The finish date comes from measured pace. If it slips, you know, and new scope waits until you decide.",
    proof: "date slips · new scope frozen",
  },
  {
    icon: "veto",
    k: "Critics with a veto",
    v: "Risk and review seats can veto the work they check. The CEO can't fire the last one.",
    proof: `${challengers} critic roles · the last one stays`,
  },
];

/** The evidence trail behind every result. */
const TRAIL = [
  { k: "Source", q: "Where did it come from?", v: "External evidence is fetched, hashed and snapshotted by the server, never taken at the agent's word." },
  { k: "Work", q: "How was it used?", v: "Nothing closes without observed evidence. “Done” on its own is refused." },
  { k: "Review", q: "Was it challenged?", v: "Critic seats can veto. A random sample of finished work is dealt to you to check." },
  { k: "Decision", q: "What can we defend?", v: "Every decision, yours or the CEO's, is on the record with its reason and can be reversed." },
];

/** Seats, by role. No names, no faces. `rule` is what the server enforces on the seat. */
const SEATS = [
  { tag: "Chair", name: "You", duty: "Set the goal, the budget and the date. Own the rules.", rule: "pause · stop · veto · amend", chair: true },
  { tag: "CEO", name: "CEO", duty: "Plans the work, hires the teams, and kills what the evidence kills.", rule: "can't edit the rules or invent a date", role: ceoRole },
  { tag: "Seat", name: "Research", duty: "Answers the question its task states, from what it actually read.", rule: "a claim needs fetched evidence", role: researchRole },
  { tag: "Seat", name: "Build", duty: "Builds the smallest thing that makes the success test pass.", rule: "done when the platform ran the test", role: buildRole },
  { tag: "Critic", name: "Red team", duty: "Tries to break the team's work before anyone outside does.", rule: "veto · the CEO can't fire the last critic", role: criticRole },
  { tag: "Critic", name: "Review", duty: "Reads the work before it ships, and can say no.", rule: "veto on the work it checks" },
];

const FOUND = [
  { k: "Describe it", v: `Tell the Founder what you want. It interviews you until nothing is assumed, then drafts the goal, the teams, the budget and the date, hiring from ${roles.length} job descriptions.` },
  { k: "Get argued with", v: "The goal is graded against the ten things a goal needs to work: a finish line, who it's for, what doesn't count. Before anything exists." },
  { k: "Rehearse it for $0", v: "The whole company runs on scripted agents first: where it would stall, what it would cost, how often it would stop and wait for you." },
  { k: "Hire it", v: "A CEO, its teams, a budget, a delivery date and a Slack channel each. Then it works for weeks." },
];

const TOUR = [
  {
    k: "Results, with the receipts.",
    v: "Every deliverable says who made it and who checked it. Verified by yaaf, not graded by the agent that wrote it, with the chain from your goal down to the task.",
    src: resultsLight,
    dark: resultsDark,
    alt: "The Results page of a demo project: two published files, each marked as judged, and for the selected one why you can trust it — the requirement it met, that Maya produced it in one run for $0.36, and the goal it serves",
  },
  {
    k: "What waits on you, first.",
    v: "The app opens on what needs you, soonest consequence first. Each item says what happens if you do nothing. Decide in one click, snooze it, or undo it.",
    src: homeLight,
    dark: homeDark,
    alt: "The Home page: four decisions that need the chair, each with what happens if nothing is done and a button to decide, beside a summary of what every project did since the last visit",
  },
  {
    k: "Your company, live.",
    v: "The org chart shows who reports to whom, what each seat is doing right now, the model it runs on and what it has cost this month.",
    src: teamLight,
    dark: teamDark,
    alt: "A project's Team page: you at the top as owner, the CIO beneath with its model and month's cost, then a Research team and a Review team, each seat showing whether it is working or idle",
  },
  {
    k: "One seat to talk to: the CEO.",
    v: "Ask why the date moved. Tell it to stop buying data and find the free route. Every answer shows what the team did to get there.",
    src: chatLight,
    dark: chatDark,
    alt: "Chat with the project's CEO seat: it asks which fiscal year should be the baseline, lists the options and its recommendation, and says what it will do if there is no answer; a side panel shows the open question and a spend decision",
  },
];

const LAYERS = [
  { k: "yaaf, the team harness", v: "Drives the company: who's hired, what's next, what it costs, when it's due, and whether it's really done. The rules live in the server, not the prompt." },
  { k: "The agent harness", v: `Drives one model: its loop, its tools, its context. ${harnesses.join(", ")}. Every seat on the chart runs in one.` },
  { k: "The model", v: `The weights. Claude, GPT, Gemini, DeepSeek, Mistral, Kimi, a local model. ${providers.length} providers.` },
];

const HORIZON = [
  { k: "A task", v: "A project that delivers one result and stops: a question answered with sources, a fix, a report.", when: "Today" },
  { k: "An operation", v: "A project that keeps running: woken by the world at 3am, a standup each morning, a register that stays current.", when: "Today" },
  { k: "A business", v: "Today a crew can test one idea for thirty days. Organizations that run a business with extensive autonomy, inside the boundaries their owner sets, are where this is going. We aren't there yet.", when: "The long view" },
];

const USES = [
  { k: "Fix your code overnight", v: "Each night, a crew picks the most useful fix in your repo and opens a pull request." },
  { k: "Research you can defend", v: "Analysts read a company's filings and write the report. Every claim links to its source." },
  { k: "Test a business idea", v: "Thirty days to prove real people want it, or a clear reason to stop." },
  { k: "Run a content engine", v: "Writers and an editor publish on your topic and learn what readers respond to." },
  { k: "Build a small app or game", v: "A developer, a designer and a tester build it together. You can read how they decided." },
  { k: "Get a weekly briefing", v: "What changed in the things you depend on. Nothing you already know." },
];

const OPEN = [
  { tag: "Open source", k: "Apache-2.0. Read every line.", v: "Fork it. Change anything. No account to make, no hosted version, no telemetry." },
  { tag: "Your machine", k: "Your laptop or your server.", v: "One command starts it on your laptop; one script puts it on a server. Projects, files and keys stay with you, and agents pay your provider directly." },
  { tag: "Honest about cost", k: "Rehearse a project for $0 first.", v: "Scripted agents show where it would stall and what it would cost. It is not for quick tasks." },
];

const VS = [
  { who: "A chatbot", v: "You ask, it answers, you check. Great for one question. You're the project manager." },
  { who: "An agent harness", v: "Claude Code or Codex drives one agent well. You're still its manager, and the loop." },
  { who: "An agent framework", v: "You write the code that runs the agents. Great if you're building a product." },
  { who: "yaaf", v: "You found a company. A CEO runs the team; the platform checks the work, the money and the date.", us: true },
];

const since = new Date(manifest.history.firstCommit).toLocaleDateString("en-US", { month: "long", day: "numeric", timeZone: "UTC" });
---
<BaseLayout title={`yaaf — ${SITE.tagline}`} bare={true} description={SITE.description} install={true}>
  <!-- ============ 1. HERO: the answer, then the receipt ============ -->
  <section class="hero">
    <div class="shell">
      <div class="hero-grid">
        <div class="hero-l">
          <p class="eyebrow">Open source · Apache-2.0 · your machine · your keys</p>
          <h1>Nothing counts until it’s <em class="signed">checked.</em></h1>
          <p class="sub">
            yaaf runs a team of AI agents like a company you chair. The platform runs the tests, meters every dollar
            and holds the date. The rules live in the server, not the prompt, so you can close the laptop.
          </p>
          <div class="btns">
            <Button href="#start" primary>Rehearse a company for $0</Button>
            <Button href="#rules">Read the rules</Button>
          </div>
        </div>
        <div class="hero-r">
          <Receipt
            title="restatements.csv"
            rows={[
              { k: "for", v: "R-02" },
              { k: "cost", v: "$0.36 · 1 run" },
            ]}
            madeBy="Research · Maya"
            checkedBy="Compliance · Juno"
          />
          <Meter label="Budget" value={412} max={500} />
          <p class="eg">Example receipt and budget, drawn the way the app shows them.</p>
        </div>
      </div>
      <hr class="double-rule" />
    </div>
  </section>

  <!-- ============ 2. THE RULES ============ -->
  <section class="sec first" id="rules">
    <span id="trust" class="anchor"></span>
    <div class="shell">
      <div class="sec-in split">
        <header class="split-h">
          <p class="eyebrow sect-mark">§ The rules</p>
          <h2>Four rules agents <em>can’t</em> talk around.</h2>
          <p class="lede">
            A confident answer is not a correct one, and one agent agreeing with another proves nothing. Each rule is a
            refusal enforced by the server. Break one and an agent gets a 403, not a stern reminder.
          </p>
        </header>
        <ol class="rules">
          {RULES.map((r, i) => (
            <li class="rule ruled">
              <p class="rule-top"><Icon name={r.icon} /><span class="sect">§ 0{i + 1}</span></p>
              <h3>{r.k}</h3>
              <p>{r.v}</p>
              <p class="proof mono">{r.proof}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="trail">
        <p class="eyebrow">The record behind every result</p>
        <ol>
          {TRAIL.map((t, i) => (
            <li>
              <span class="sect">0{i + 1} · {t.k}</span>
              <h3>{t.q}</h3>
              <p>{t.v}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 3. THE COMPANY ============ -->
  <section class="sec raised" id="company">
    <div class="shell">
      <div class="sec-in split even">
        <header class="split-h">
          <p class="eyebrow sect-mark">§ The company</p>
          <h2>You chair. <em>They work.</em></h2>
          <p class="lede">
            Describe the goal. yaaf argues with it until it’s testable, then hires a CEO and the seats it needs, each on
            its own model and harness. No single seat needs to know everything.
          </p>
          <p class="counts mono">
            <span>{roles.length} roles</span><span>{crews.length} ready-made teams</span><span>{manifest.harnesses} harnesses</span><span>{manifest.providers} providers</span>
          </p>
          <p class="note"><a href="/org/">The role library</a> · <a href="/runtimes/">Every harness and provider</a> · <a href="/manifesto/">Why we built it</a></p>
        </header>
        <ul class="seats">
          {SEATS.map((s) => (
            <li class:list={["seat", { chair: s.chair }]}>
              <p class="eyebrow">{s.tag}</p>
              <h3>{s.name}</h3>
              <p class="duty">{s.duty}</p>
              <p class="bound mono">{s.rule}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 4. HOW IT WORKS ============ -->
  <Section id="how" class="first" eyebrow="How it works" title="From one paragraph to a staffed company."
    lede="Say it in the dashboard, or in the Claude window you already have open.">
    <ol class="steps">
      {FOUND.map((s, i) => (
        <li class="ruled">
          <span class="sect">§ 0{i + 1}</span>
          <h3>{s.k}</h3>
          <p>{s.v}</p>
        </li>
      ))}
    </ol>
    <p class="note"><a href="/how-it-works/">How it works, in detail</a></p>
  </Section>

  <!-- ============ 5. AUTHORITY ============ -->
  <Section id="control" eyebrow="Your authority" title="You decide how much authority to <em>delegate.</em>"
    lede="Some chairs approve every important decision. Others set a goal and a budget and let the CEO run. Both belong in yaaf.">
    <AutonomyDial />
    <p class="note">These are five real switches in the project's constitution, which no agent can edit. <a href="/how-it-works/#dial">How the switches work</a></p>
  </Section>

  <!-- ============ 6. THE REAL THING ============ -->
  <Section id="tour" eyebrow="The real thing" title="Every result says who made it, who <em>checked it,</em> and what it cost."
    lede="Check in when you want. The company keeps working when you don't.">
    <div class="tour">
      {TOUR.map((t, i) => (
        <article class="shot-row">
          <div class="copy">
            <span class="sect">§ 0{i + 1}</span>
            <h3>{t.k}</h3>
            <p>{t.v}</p>
          </div>
          <Shot src={t.src} dark={t.dark} ratio="16 / 10" alt={t.alt} />
        </article>
      ))}
    </div>
    <p class="note">The real product, on demo data. Check in from the app, the terminal (<code>yaaf status</code>), Slack, a daily letter, or <a href="/docs/install/#after-you-install">Claude over MCP</a>.</p>
  </Section>

  <!-- ============ 7. THE HARNESS, ONE LEVEL UP ============ -->
  <Section id="harness" eyebrow="The harness, one level up" title="A harness drives one agent. yaaf harnesses the <em>team.</em>"
    lede="Claude Code, Codex, Gemini CLI and OpenCode give one model a loop and tools. yaaf is what's around them: <strong>the company they work for.</strong>">
    <div class="harness">
      <div class="nest n0">
        <p class="nl"><span class="sect">§ 03</span><b>{LAYERS[0].k}</b><span class="nv">{LAYERS[0].v}</span></p>
        <div class="nest n1">
          <p class="nl"><span class="sect">§ 02</span><b>{LAYERS[1].k}</b><span class="nv">{LAYERS[1].v}</span></p>
          <div class="nest n2">
            <p class="nl"><span class="sect">§ 01</span><b>{LAYERS[2].k}</b><span class="nv">{LAYERS[2].v}</span></p>
          </div>
        </div>
      </div>
      <div class="quote">
        <blockquote>
          <p>“A harness is transport. It decides how a model is driven, never what the model may do.”</p>
        </blockquote>
        <p class="qr">
          That line is from yaaf's own design. What a model may do is decided in one place, the server, and every rule
          is a refusal. <a class="link" href="/runtimes/">Every harness and provider</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- ============ 8. WHAT BECOMES POSSIBLE ============ -->
  <Section id="possible" eyebrow="What becomes possible" title="From a task, to an operation, to one day a business."
    lede="Some companies exist for an afternoon. Others run continuously. The last column is a direction, not a feature.">
    <ol class="horizon">
      {HORIZON.map((h, i) => (
        <li class:list={["ruled", { far: i === HORIZON.length - 1 }]}>
          <span class="pill">{h.when}</span>
          <h3>{h.k}</h3>
          <p>{h.v}</p>
        </li>
      ))}
    </ol>
    <h3 class="uses-h">What will your company do? Start from one of <span class="mono">{crews.length}</span> ready-made teams, or describe your own.</h3>
    <ul class="uses">
      {USES.map((u) => (
        <li>
          <h4>{u.k}</h4>
          <p>{u.v}</p>
        </li>
      ))}
    </ul>
    <p class="note"><a href="/org/"><span class="mono">{roles.length}</span> roles to hire from</a></p>
  </Section>

  <!-- ============ COMPARE (hidden while SHOW_COMPARE is off) ============ -->
  {SHOW_COMPARE && <Section eyebrow="Compared" title="Why not just use Claude Code?">
    <div class="cells vsg">
      {VS.map((x) => (
        <div class:list={["cell", { us: x.us }]}>
          <span class="eyebrow">{x.who}</span>
          <p class="vs">{x.v}</p>
        </div>
      ))}
    </div>
    <p class="note">yaaf runs Claude Code and Codex. It doesn't replace them; it gives them a company. <a href="/compare/">Full comparison, including Paperclip</a></p>
  </Section>}

  <!-- ============ 9. OPEN SOURCE · YOUR MACHINE · HONEST ABOUT COST ============ -->
  <section class="sec" id="open">
    <div class="shell">
      <div class="sec-in">
        <ul class="open">
          {OPEN.map((k) => (
            <li>
              <p class="eyebrow">{k.tag}</p>
              <h3>{k.k}</h3>
              <p>{k.v}</p>
            </li>
          ))}
        </ul>
        <p class="note">
          Early days: pre-1.0, <span class="mono">{manifest.history.commits}</span> commits since {since}, built in the open with Claude Code.{" "}
          <a href={REPO_URL}>Source on GitHub</a> · <a href="/docs/providers/">Models and keys</a>
        </p>
      </div>
    </div>
  </section>
  <!-- 10. Install (#start) and 11. the footer are drawn by the layout. -->
</BaseLayout>

<style>
  /* ---------- 1. hero ---------- */
  .hero { padding-top: var(--yaaf-space-11); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px 64px; align-items: end; padding-bottom: var(--yaaf-space-10); }
  .hero .eyebrow { margin: 0; }
  h1 {
    margin: var(--yaaf-space-5) 0 0;
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    max-width: 11ch;
  }
  /* The one headline word set in Seal: the check itself. */
  h1 .signed { font-weight: 600; }
  .sub { margin: var(--yaaf-space-7) 0 0; font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3125rem); line-height: 1.55; color: var(--yaaf-ink-2); max-width: 32em; }
  .hero .btns { margin-top: var(--yaaf-space-7); }
  .hero-r { display: grid; gap: 28px; padding-bottom: 6px; }
  .eg { margin: -8px 0 0; font-family: var(--font-mono); font-size: 12px; color: var(--yaaf-muted); }

  /* ---------- the split section: headline left, evidence right ---------- */
  .split { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 48px 72px; align-items: start; }
  .split.even { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .split-h .eyebrow { margin: 0 0 var(--yaaf-space-4); text-transform: none; letter-spacing: 0.04em; }
  .split-h h2 { margin: 0; font-size: var(--text-h2); line-height: 1.08; text-wrap: balance; }
  .split-h .lede { margin: var(--yaaf-space-5) 0 0; font-size: 17px; line-height: 1.6; color: var(--yaaf-ink-2); max-width: 46ch; }

  /* ---------- 2. the rules ---------- */
  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 48px 44px; }
  .rule-top { margin: 0; display: flex; justify-content: space-between; align-items: center; color: var(--yaaf-ink); }
  .rule h3 { margin: 18px 0 0; font-size: 1.625rem; line-height: 1.2; }
  .rule p { margin: 10px 0 0; color: var(--yaaf-ink-2); max-width: 44ch; }
  .rule .proof { margin-top: 16px; font-size: 13px; color: var(--yaaf-muted); }

  .trail { padding-bottom: var(--yaaf-space-11); }
  .trail > .eyebrow { margin: 0 0 var(--yaaf-space-5); padding-top: var(--yaaf-space-6); border-top: 1px solid var(--yaaf-border-strong); }
  .trail ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 32px; }
  .trail h3 { margin: 8px 0 0; font-family: var(--font-sans); font-size: 17px; font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  .trail li p { margin: 6px 0 0; font-size: 15px; color: var(--yaaf-ink-2); }

  /* ---------- 3. the company ---------- */
  .counts { margin: var(--yaaf-space-6) 0 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-size: 14px; color: var(--yaaf-ink-2); }
  .counts span:not(:last-child)::after { content: "·"; margin-inline: 12px; color: var(--yaaf-muted); }
  .seats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .seat { background: var(--yaaf-page); border: 1px solid var(--yaaf-border); padding: 18px 18px 16px; display: flex; flex-direction: column; }
  .seat.chair { border-color: var(--yaaf-ink); }
  .seat .eyebrow { margin: 0; }
  .seat h3 { margin: 10px 0 0; font-size: 1.5rem; line-height: 1.15; }
  .duty { margin: 6px 0 0; font-size: 15px; line-height: 1.5; color: var(--yaaf-ink-2); }
  .bound { margin: auto 0 0; padding-top: 14px; font-size: 12.5px; line-height: 1.5; color: var(--yaaf-muted); }

  /* ---------- 4. how it works ---------- */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 32px; }
  .steps h3 { margin: 14px 0 0; font-size: 1.5rem; line-height: 1.2; }
  .steps p { margin: 10px 0 0; font-size: 15.5px; color: var(--yaaf-ink-2); }

  /* ---------- 6. the real thing ---------- */
  :global(#tour .head > h2) { max-width: 30ch; }
  .tour { display: grid; gap: var(--yaaf-space-10); }
  .shot-row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 24px 48px; align-items: start; }
  .copy { border-top: 2px solid var(--yaaf-ink); padding-top: var(--yaaf-space-5); }
  .copy h3 { margin: 14px 0 0; font-size: 1.625rem; line-height: 1.18; }
  .copy p { margin: 10px 0 0; color: var(--yaaf-ink-2); font-size: 15.5px; }

  /* ---------- 7. the harness: three nested boxes in ink ---------- */
  .nest { border: 1.5px solid var(--yaaf-ink); padding: 20px 24px 24px; }
  .n0 { border-width: 2px; }
