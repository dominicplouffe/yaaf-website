---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Drill from "../components/Drill.astro";
import manifest from "../content/manifest.json";
import supervised from "../content/drills/supervised.txt?raw";

const WHO = [
  { door: "/admin", k: "You", v: "Sign in with a password. Each project has a chair, co-chairs and observers." },
  { door: "/mcp", k: "Claude", v: "Its own scoped key. Never your login. Every write is marked as Claude's." },
  { door: "/agent/*", k: "An agent", v: "A key that lives for one run. Too many refusals and it's revoked." },
  { door: "—", k: "Everything agents read", v: "Web pages, docs, other agents' output. Treated as data, never as orders.", warm: true },
];

const STEPS = [
  ["Describe", "Write a paragraph. yaaf drafts the goal, team, budget and rules."],
  ["Review", "The goal is graded against ten things it needs. Missing a key one means not ready."],
  ["Rehearse", "Run the whole project free on scripted agents. See where it breaks."],
  ["Hire", "Create it for real: a CEO, teams, a budget and a deadline."],
  ["Plan", "No work starts until the plan is staged, estimated and fits the budget."],
  ["Work", "Every task must serve a goal and carry a test that can fail."],
  ["Prove", "The platform runs the tests and checks the evidence. Only it marks work done."],
  ["Keep pace", "The date re-projects itself. If it slips, new scope freezes."],
];

const RUN = [
  ["Wake", "An assignment, a message from you, a schedule or the CEO's heartbeat.", "6 wakes per agent per hour"],
  ["Lease", "yaaf picks the model, provider and harness for the seat, and checks it can pay.", "7 seat rules"],
  ["Sandbox", "A fresh container with only this role's secrets and a one-run key.", "Gone when the run ends"],
  ["Brief", "The goal, the plan, the task and any rule changes you made.", "Agents can't change rules"],
  ["Work", "The model works. Every call is metered as it happens.", "$2 per run by default"],
  ["Act", "Every action is an API call. Breaking a rule returns a refusal.", "Key revoked past 5 refusals"],
  ["Record", "Cost, trace, refusals and the exact context are saved.", "Everything is kept"],
];

const SWITCHES = [
  ["Accept the plan", "You", "The CEO"],
  ["Change scope", "You", "The CEO, on the record"],
  ["Set the deadline", "You sign it", "The platform's projection"],
  ["Judge uncheckable work", "You", "The CEO, and you see every call"],
  ["Grant credentials", "You", "The CEO, within what it already has"],
];

const MONEY = [
  ["A budget is a plan", "Warned at 80%. Going over means explaining why, not stopping."],
  ["A wall stops runaways", "At 3× the budget by default, the project pauses itself."],
  ["Every run is metered", "Including failed and killed runs."],
  ["One meter per project", "Mix providers freely. One budget covers all of them."],
  ["Real-world spending is separate", "Purchases have their own limit. No approval overrides it."],
  ["A receipt at the end", "What it cost, next to what the platform verified."],
];
---
<BaseLayout title="How it works" description="How yaaf works: who can do what, the steps from a paragraph to a running team, one agent run, the autonomy dial, money and containment.">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h1>The server makes the rules. Agents follow them.</h1>
      <p class="lede">Agents can only act through yaaf's API. Every rule is a refusal they can't talk their way past.</p>
      <nav class="toc" aria-label="On this page">
        <a href="#who">Who can do what</a>
        <a href="#steps">The steps</a>
        <a href="#run">One run</a>
        <a href="#dial">Autonomy</a>
        <a href="#money">Money</a>
        <a href="#safety">Safety</a>
      </nav>
    </div>
  </section>

  <Section id="who" eyebrow="Who can do what" title="Four kinds of caller. One set of rules.">
    <div class="cells">
      {WHO.map((w) => (
        <div class:list={["cell", { warm: w.warm }]}>
          <span class="eyebrow">{w.door}</span>
          <h3>{w.k}</h3>
          <p>{w.v}</p>
        </div>
      ))}
      <div class="cell span4 engine">
        <span class="eyebrow">The policy engine</span>
        <h3>Every rule is a refusal or an automatic change.</h3>
        <p>Around two hundred of them, each with a test that attacks it over HTTP.</p>
      </div>
      <div class="cell span4">
        <span class="eyebrow">The record</span>
        <p>Every message, run, dollar, decision and refusal, stored in Postgres.</p>
      </div>
    </div>
  </Section>

  <Section id="steps" eyebrow="The steps" title="From a paragraph to a working team." lede="The first three steps are free.">
    <div class="cells">
      {STEPS.map(([k, v], i) => (
        <div class:list={["cell", { free: i < 3 }]}>
          <span class="eyebrow">{String(i + 1).padStart(2, "0")}{i < 3 && " · free"}</span>
          <h3>{k}</h3>
          <p>{v}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="run" eyebrow="One run" title="What happens when an agent wakes up.">
    <div class="kit-table stack">
      <table>
        <thead><tr><th>Step</th><th>What happens</th><th>Limit</th></tr></thead>
        <tbody>
          {RUN.map(([k, v, l], i) => (
            <tr>
              <th scope="row"><span class="n">{i + 1}</span>{k}</th>
              <td data-label="What happens">{v}</td>
              <td class="mono" data-label="Limit">{l}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="dial" eyebrow="Autonomy" title="You choose how much to decide."
    lede="Five switches decide who holds each call. The checks never change.">
    <div class="kit-table stack">
      <table>
        <thead><tr><th>Decision</th><th>Supervised</th><th class="me">Autonomous</th></tr></thead>
        <tbody>
          {SWITCHES.map(([k, a, b]) => (
            <tr><th scope="row">{k}</th><td data-label="Supervised">{a}</td><td class="me" data-label="Autonomous">{b}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="cells c2 waits">
      <div class="cell"><p class="num">0</p><p>Times it waited for you, <strong>autonomous</strong></p></div>
      <div class="cell warm"><p class="num">7</p><p>Times it waited for you, <strong>supervised</strong></p></div>
    </div>
    <Drill report={supervised} only={["It stopped"]} label="Supervised · real output" />
    <p class="note">Same team, rehearsed twice. Spending over your limit, legal questions and anything only a human can do always come to you. <a href="/docs/autonomy/">Autonomy docs →</a></p>
  </Section>

  <Section id="money" eyebrow="Money" title="A budget you plan with. A wall you can't pass.">
    <div class="cells c3">
      {MONEY.map(([k, v]) => (
        <div class="cell">
          <h3>{k}</h3>
          <p>{v}</p>
        </div>
      ))}
    </div>
    <p class="note"><a href="/docs/governance/#budgets">Every limit and its default →</a></p>
  </Section>

  <Section id="safety" eyebrow="Safety" title="What contains an agent, and what doesn't.">
    <div class="cells c2">
      <div class="cell">
        <h3>Contains it</h3>
        <ul>
          <li>A fresh container per run, with no privileges</li>
          <li>Only the secrets its role needs</li>
          <li>A metered budget that pauses the project</li>
          <li>An API where every rule is a refusal</li>
        </ul>
      </div>
      <div class="cell warm">
        <h3>Doesn't contain it</h3>
        <ul>
          <li>The network. Agents can reach the internet.</li>
          <li>Prompts. Telling an agent to behave is not a control.</li>
          <li>So an agent tricked by a web page can leak what its role holds.</li>
        </ul>
      </div>
    </div>
    <p class="note">No outside security review yet. <a href="/docs/security/">Read the security model →</a></p>
  </Section>

  <Section eyebrow="What you run" title="One machine. Docker. Postgres.">
    <div class="cells">
      <div class="cell"><span class="eyebrow">api</span><h3>Control plane</h3><p>Python and FastAPI. The rules, the dashboard API and the MCP server.</p></div>
      <div class="cell"><span class="eyebrow">runner</span><h3>Runner</h3><p>Starts a sandbox container for each run.</p></div>
      <div class="cell"><span class="eyebrow">sandbox</span><h3>Sandbox image</h3><p>Python, Node, Chromium and each agent harness.</p></div>
      <div class="cell"><span class="eyebrow">db</span><h3>Postgres 16</h3><p>The record. Tests run on SQLite: {manifest.tests.toLocaleString("en-US")} of them.</p></div>
    </div>
  </Section>
</BaseLayout>

<style>
  .engine { background: var(--color-surface) !important; }
  .engine h3 { font-size: 1.4rem !important; }
  .free .eyebrow { color: var(--color-good); }
  .n { display: inline-block; width: 1.6rem; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); font-weight: 400; }
  .waits { margin-top: 24px; }
  .waits + :global(.drill) { border-top: 0; }
</style>
