---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { slug: doc.data.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const description = doc.data.subtitle
  ? `${doc.data.title} — ${doc.data.subtitle}. Part of the yaaf documentation.`
  : `${doc.data.title} — part of the yaaf documentation.`;
---
<DocsLayout
  title={doc.data.title}
  subtitle={doc.data.subtitle}
  description={description}
  sourceFile={doc.data.sourceFile}
  slug={doc.data.slug}
>
  <Content />
</DocsLayout>
