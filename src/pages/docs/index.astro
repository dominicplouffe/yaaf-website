---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOCS_GROUPS } from "../../site.config.mjs";

const all = await getCollection("docs");
const bySlug = new Map(all.map((d) => [d.data.slug, d]));

/** One line each, written for someone deciding what to open. */
const BLURB: Record<string, string> = {
  plan: "What yaaf is betting on, what would prove it wrong, and what's built.",
  features: "Every feature, grouped by the problem it solves.",
  "creating-a-project": "Your first project, step by step.",
  governance: "Every rule and its default.",
  autonomy: "How much the CEO decides without you.",
  "goal-grammar": "The ten things a good goal needs.",
  "mcp-server": "Run yaaf from Claude or any MCP client.",
  dashboard: "Every screen and what it's for.",
  cli: "Every yaaf command.",
  "agent-api": "What agents can do, and how to write a role.",
  deployment: "Install, configure, back up and upgrade.",
  integrations: "Billing, Slack, GitHub, data sources, webhooks and storage.",
  runtimes: "Any harness, any provider, the same rules: the design.",
  providers: "Model classes, every provider's own API, prices and failover.",
  auth: "Accounts, co-chairs, observers and permissions.",
  security: "What contains an agent, and what doesn't.",
};

const groups = DOCS_GROUPS.map((g) => ({
  title: g.title,
  items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean),
}));
---
<DocsLayout
  title="Documentation"
  subtitle="Synced from the yaaf repository."
  description="yaaf documentation: the plan, the feature reference, the constitution, the autonomy dial, the MCP server, runtimes and providers, people and roles, the CLI and the agent API."
>
  <p>
    New here? Start with{" "}
    <a href="/docs/creating-a-project/">Creating a project</a>.
  </p>

  {groups.map((g) => (
    <section class="grp">
      <h2>{g.title}</h2>
      <div class="cards">
        {g.items.map((d: any) => (
          <a class="c" href={`/docs/${d.data.slug}/`}>
            <span class="t">{d.data.title}</span>
            <span class="b">{BLURB[d.data.slug] ?? d.data.subtitle}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>

<style>
  .grp h2 { font-size: 1.2rem; }
  .cards { display: grid; gap: 10px; margin-top: 16px; }
  .c {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .c:hover { border-color: color-mix(in srgb, var(--color-accent) 55%, transparent); background: var(--color-surface-2); }
  .t { display: block; color: var(--color-ink); font-weight: 600; font-size: 15px; }
  .b { display: block; color: var(--color-muted); font-size: 13.5px; margin-top: 4px; line-height: 1.55; }
</style>
