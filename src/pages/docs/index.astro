---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOCS_GROUPS } from "../../site.config.mjs";

const all = await getCollection("docs");
const bySlug = new Map(all.map((d) => [d.data.slug, d]));

/** One line each, written for someone deciding what to open. */
const BLURB: Record<string, string> = {
  install: "Get yaaf running: Docker, native, or from source.",
  configuration: "Every environment variable, and which ones you must set.",
  deployment: "Run it on a server: access, updates, backups, scaling.",
  architecture: "How the server, runner, database and sandboxes fit together.",
  providers: "Which models it runs on: keys, subscriptions, prices, local models.",
  cli: "Every yaaf command, by task.",
  security: "What contains an agent, and what doesn't.",
}

const groups = DOCS_GROUPS.map((g) => ({
  title: g.title,
  items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean),
}));
---
<DocsLayout
  title="Documentation"
  subtitle="Synced from the yaaf repository."
  description="yaaf documentation: install it with Docker or natively, configure it, deploy it to a server, how it is built, model providers, the CLI and the security model."
>
  <p>
    New here? Start with{" "}
    <a href="/docs/install/">Install</a>.
  </p>

  {groups.map((g) => (
    <section class="grp">
      <h2>{g.title}</h2>
      <div class="cards">
        {g.items.map((d: any) => (
          <a class="c" href={`/docs/${d.data.slug}/`}>
            <span class="t">{d.data.title}</span>
            <span class="b">{BLURB[d.data.slug] ?? d.data.subtitle}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>

<style>
  .grp h2 { font-size: 1.2rem; }
  .cards { display: grid; gap: 10px; margin-top: 16px; }
  .c {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 14px 16px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .c:hover { border-color: color-mix(in srgb, var(--color-accent) 55%, transparent); background: var(--color-surface-2); }
  .t { display: block; color: var(--color-ink); font-weight: 600; font-size: 15px; }
  .b { display: block; color: var(--color-muted); font-size: 13.5px; margin-top: 4px; line-height: 1.55; }
</style>
