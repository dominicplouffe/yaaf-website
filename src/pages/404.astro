---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---
<BaseLayout title="Not found" description="That page does not exist." cta={false}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>Request refused.</h1>
      <p class="lede">That page doesn't exist. In yaaf, a request that doesn't match a rule gets a refusal, not a guess.</p>
      <div class="btns">
        <Button href="/" primary>Home</Button>
        <Button href="/docs/">Docs</Button>
      </div>
    </div>
  </section>
</BaseLayout>
