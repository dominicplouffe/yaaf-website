---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Cmd from "../../components/Cmd.astro";

const examples = (await getCollection("examples")).sort((a, b) => a.data.number.localeCompare(b.data.number));
const basics = examples.filter((e) => Number(e.data.number) <= 2);
const rest = examples.filter((e) => Number(e.data.number) > 2);

const MODES = [
  ["deliver", "Ship one thing, then stop."],
  ["operate", "Repeat on a schedule, learning from the last three runs."],
  ["explore", "Chase a goal with no fixed end."],
];
---
<BaseLayout title="Examples" description={`${examples.length} ready-to-run yaaf projects. Rehearse any of them for free before spending anything.`}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Examples</p>
      <h1>{examples.length} projects, ready to run.</h1>
      <p class="lede">Each is a real spec file. Rehearse it for free, then import it.</p>
      <div class="try"><Cmd cmd="yaaf rehearse examples/01-your-first-hour.json" /></div>
    </div>
  </section>

  <Section first={true} eyebrow="Start here" title="Two to learn the basics.">
    <div class="cells">
      {basics.map((e) => (
        <a class="cell ex" href={`/examples/${e.id}/`}>
          <span class="eyebrow">{e.data.number}</span>
          <h3>{e.data.title}</h3>
          <div class="pills">
            <span class:list={["pill", `m-${e.data.mode}`]}>{e.data.mode}</span>
            {e.data.cap && <span class="pill dim">${e.data.cap} cap</span>}
            {e.data.solo && <span class="pill dim">solo</span>}
          </div>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Real work" title={`${rest.length} that need the platform.`} lede="Each one breaks without it: a claim nobody checks, a retry that posts twice, a budget that burns overnight.">
    <div class="cells">
      {rest.map((e) => (
        <a class="cell ex" href={`/examples/${e.id}/`}>
          <span class="eyebrow">{e.data.number}</span>
          <h3>{e.data.title}</h3>
          <div class="pills">
            <span class:list={["pill", `m-${e.data.mode}`]}>{e.data.mode}</span>
            {e.data.cap && <span class="pill dim">${e.data.cap} cap</span>}
            <span class="pill dim">{e.data.teams.length} {e.data.teams.length === 1 ? "team" : "teams"}</span>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <Section eyebrow="Project shapes" title="Every project picks one.">
    <div class="cells c3">
      {MODES.map(([k, v]) => (
        <div class="cell">
          <span class:list={["pill", `m-${k}`]}>{k}</span>
          <p>{v}</p>
        </div>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .try { margin-top: 2rem; max-width: 560px; }
  .ex { display: flex; flex-direction: column; gap: 0; min-height: 210px; }
  .ex h3 { margin-bottom: 1.4rem; }
  .ex .pills { margin-top: auto; }
  .cell > .pill + p { margin-top: 1rem; }
  .m-deliver { color: var(--color-accent-hi); border-color: color-mix(in srgb, var(--color-accent) 50%, transparent); }
  .m-operate { color: var(--color-good); border-color: color-mix(in srgb, var(--color-good) 45%, transparent); }
  .m-explore { color: var(--color-warning); border-color: color-mix(in srgb, var(--color-warning) 45%, transparent); }
</style>
