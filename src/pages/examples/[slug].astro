---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrgChart from "../../components/OrgChart.astro";
import { REPO_URL, SOURCE_IS_PUBLIC } from "../../site.config.mjs";

export async function getStaticPaths() {
  const examples = await getCollection("examples");
  const roles = await getCollection("roles");
  const sorted = examples.sort((a, b) => a.data.number.localeCompare(b.data.number));
  return sorted.map((ex, i) => ({
    params: { slug: ex.id },
    props: {
      ex,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
      roleName: Object.fromEntries(roles.map((r) => [r.data.slug, r.data.name])),
    },
  }));
}

const { ex, prev, next, roleName } = Astro.props;
const { Content } = await render(ex);
const d = ex.data;
---
<BaseLayout title={`${d.number} — ${d.title}`} description={d.whatYouGet}>
  <div class="shell top">
    <p class="crumb"><a href="/examples/">Examples</a> <span>/</span> {d.number}</p>
    <h1 class="balance">{d.title}</h1>
    <p class="lede pretty">{d.whatYouGet}</p>
    <p class="chips">
      <span class={`m-${d.mode}`}>{d.mode}</span>
      {d.cap && <span>${d.cap} cap</span>}
      {d.solo && <span>solo</span>}
      <span>{d.teams.length} {d.teams.length === 1 ? "team" : "teams"}</span>
    </p>
  </div>

  <div class="shell cols">
    <article class="prose"><Content /></article>

    <aside class="rail">
      <div class="card box">
        <p class="eyebrow">Run it for $0 first</p>
        <pre>yaaf rehearse {d.spec}</pre>
        <p class="fine">The whole project on scripted agents — every rule, every refusal — before a dollar moves.</p>
      </div>

      {d.teams.length > 0 && (
        <div class="card box">
          <p class="eyebrow">Who gets hired</p>
          <div class="chart">
            <OrgChart
              chairman={false}
              ceo="CEO"
              teams={d.teams.map((t) => ({
                name: t.name,
                role: roleName[t.role] ?? t.role,
                employees: t.employees,
                lead: t.lead,
              }))}
            />
          </div>
        </div>
      )}

      <div class="card box">
        <p class="eyebrow">What you need</p>
        <p class="fine lg" set:html={d.whatYouNeed} />
        <p class="eyebrow mt">What it costs</p>
        <p class="fine lg" set:html={d.whatItCosts} />
      </div>

      <div class="card box">
        <p class="eyebrow">The spec</p>
        <p class="fine">Every example is a real importable bundle: the goal, the crew, the budget cap and the constitution it runs under.</p>
        <p class="specs">
          <a href={`/setups/${ex.id}.json`} download>Download JSON</a>
          {SOURCE_IS_PUBLIC && <a href={`${REPO_URL}/blob/main/${d.spec}`}>View in repo ↗</a>}
        </p>
      </div>
    </aside>
  </div>

  <nav class="shell pager" aria-label="Examples">
    {prev ? <a href={`/examples/${prev.id}/`}>← {prev.data.number} {prev.data.title}</a> : <span></span>}
    {next && <a class="r" href={`/examples/${next.id}/`}>{next.data.number} {next.data.title} →</a>}
  </nav>
</BaseLayout>

<style>
  .top { padding-block: 40px 28px; max-width: 820px; }
  .crumb { margin: 0 0 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; color: var(--color-muted); }
  .crumb a { color: var(--color-ink-2); text-decoration: none; }
  .crumb a:hover { color: var(--color-accent-hi); }
  .crumb span { opacity: 0.5; margin: 0 4px; }
  h1 { font-size: var(--text-h1); line-height: 1.08; letter-spacing: -0.03em; font-weight: 640; margin: 0; }
  .lede { color: var(--color-ink-2); font-size: 1.0625rem; margin: 14px 0 0; max-width: 60ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 18px 0 0; }
  .chips span {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 3px 9px;
  }
  .m-deliver { color: var(--color-accent-hi); border-color: color-mix(in srgb, var(--color-accent) 40%, transparent); }
  .m-operate { color: var(--color-good); border-color: color-mix(in srgb, var(--color-good) 40%, transparent); }
  .m-explore { color: var(--color-warning); border-color: color-mix(in srgb, var(--color-warning) 40%, transparent); }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 44px; align-items: start; padding-block: 12px; }
  .rail { min-width: 0; }
  .rail { position: sticky; top: 76px; display: flex; flex-direction: column; gap: 10px; }
  .box { padding: 14px 15px; }
  .box pre {
    margin: 9px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-2);
    background: var(--color-page);
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-control);
    padding: 9px 10px;
    overflow-x: auto;
  }
  .fine { margin: 8px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--color-muted); }
  .fine.lg { color: var(--color-ink-2); font-size: 13px; }
  .mt { margin-top: 16px; }
  .specs { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }
  .specs a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--color-ink-2);
    text-decoration: none;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: 6px 10px;
  }
  .specs a:hover { color: var(--color-ink); border-color: color-mix(in srgb, var(--color-accent) 55%, transparent); background: color-mix(in srgb, var(--color-accent) 10%, transparent); }
  .chart { margin-top: 12px; font-size: 12px; }

  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--color-line); }
  .pager a { color: var(--color-ink-2); text-decoration: none; font-size: 14px; }
  .pager a:hover { color: var(--color-accent-hi); }
  .pager .r { margin-left: auto; text-align: right; }

  @media (max-width: 980px) {
    .cols { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .rail { position: static; }
  }
</style>
