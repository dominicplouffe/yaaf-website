---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import runtimes from "../content/runtimes.json";

const { harnesses, providers, models } = runtimes;
const harnessLabel = new Map(harnesses.map((h) => [h.name, h.label.replace(/ \(.*\)$/, "")]));

const TYPE: Record<string, string> = { sdk: "SDK", cli: "CLI", loop: "API loop" };
const short = (bills: string) => bills.replace(/, (billed|metered|priced) .*$/, "");
const kinds = (accepts: string[]) =>
  accepts.map((k) => {
    const [prov, mode] = k.split(":");
    const kind = providers.find((p) => p.name === prov)?.kinds.find((x) => x.mode === mode);
    return kind ? short(kind.bills) : k;
  });

const RULES = [
  ["R1", "The seat's harness must accept the credential."],
  ["R2", "The harness must honour the role's tool permissions."],
  ["R3", "If yaaf prices the run, the model needs a price."],
  ["R4", "One project, one unit: dollars or tokens, never both."],
  ["R5", "The project needs a credential for the seat's provider."],
  ["R6", "The model must support the effort level asked for."],
  ["R7", "The CEO's harness must be able to hold a conversation."],
  ["R8", "A seat that names a class needs a model for that class on its provider."],
];

const CLASSES = [
  ["Frontier", "The most capable model the provider sells. For the CEO and the hardest seats.", "rose"],
  ["Balanced", "The workhorse. Most of a team runs here.", "violet"],
  ["Fast", "Cheap and quick, for the seats that read and sort.", "sky"],
];

const priced = models.filter((m) => m.price).length;
const pricedBy = providers.filter((p) => p.priced.length).map((p) => p.label).join(" and ");
---
<BaseLayout title="Harnesses and models" description={`yaaf is the harness around your agent harnesses: run each seat on any of ${harnesses.length} harnesses — Claude Code, Codex, Gemini CLI, OpenCode, the Agent SDK or yaaf's own loop — and ${providers.length} providers, under one budget and the same rules.`}>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Harnesses and models</p>
      <h1>Every harness. Every model. One company.</h1>
      <p class="lede">An agent harness drives one model. yaaf is <strong>the harness around the harnesses</strong>: put each person on the chart on the harness and model that suits the job, and the whole team still answers to one budget and one set of rules.</p>
    </div>
  </section>

  <Section first={true}>
    <div class="cells hued">
      <div class="cell"><p class="num">{harnesses.length}</p><p>Harnesses</p></div>
      <div class="cell"><p class="num">{providers.length}</p><p>Providers</p></div>
      <div class="cell"><p class="num">{models.length}</p><p>Models in the catalog</p></div>
      <div class="cell"><p class="num">1</p><p>Budget per project</p></div>
    </div>
  </Section>

  <Section eyebrow="Two levels" title="A harness is transport. yaaf is the rules."
    lede="Claude Code, Codex and the rest decide how a model is driven. They never decide what it may do. That lives in yaaf's server, the same for every harness.">
    <div class="cells c2 hued">
      <div class="cell">
        <span class="eyebrow">The agent harness decides</span>
        <ul>
          <li>How the model is called, and its loop</li>
          <li>The tools it offers the model</li>
          <li>How a long run is compacted to fit</li>
        </ul>
      </div>
      <div class="cell">
        <span class="eyebrow">yaaf decides, for every harness</span>
        <ul>
          <li>Who is hired, and who they report to</li>
          <li>What may be worked on, and when it's done</li>
          <li>What it costs, metered live against one cap</li>
          <li>When it's due, and what's on the record</li>
        </ul>
      </div>
    </div>
    <p class="note">A harness that can't report what it spent while it's spending it isn't let in. Every one runs inside yaaf's sandbox, on yaaf's meter.</p>
  </Section>

  <Section eyebrow="Model classes" title="Roles name a class, not a vendor."
    lede="A role asks for frontier, balanced or fast. Each provider says which of its models that means, so the same team runs on whichever provider you pay.">
    <div class="cells c3">
      {CLASSES.map(([k, v, hue]) => (
        <div class={`cell h-${hue} cls`}>
          <h3>{k}</h3>
          <p>{v}</p>
        </div>
      ))}
    </div>
    <p class="note">Pin a seat to an exact model whenever you want. If a provider keeps failing, a project can name a fallback credential: its class seats move there until the provider recovers, and back. Pinned seats never move.</p>
  </Section>

  <Section eyebrow="Why" title="Two agents on one model share its blind spots.">
    <div class="cells c2">
      <div class="cell warm"><h3>Critics on a different model</h3><p>Put your researcher on Claude and its critic on GPT. Disagreement gets real.</p></div>
      <div class="cell"><h3>Not tied to one vendor</h3><p>The rules never depended on the model. Now the metering doesn't either.</p></div>
    </div>
  </Section>

  <Section id="harnesses" eyebrow="Harnesses" title="What drives the model.">
    <div class="kit-table stack">
      <table>
        <thead><tr><th>Harness</th><th>Type</th><th>Pays with</th><th>Version</th></tr></thead>
        <tbody>
          {harnesses.map((h) => (
            <tr>
              <th scope="row">{h.label.replace(/ \(.*\)$/, "")}</th>
              <td data-label="Type">{TYPE[h.family]}</td>
              <td data-label="Pays with">{kinds(h.accepts).join(" · ")}</td>
              <td class="mono" data-label="Version">{h.pinned ?? (h.package ? "latest" : "—")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">Every person on the org chart runs in one of these. Mix them freely on one team.</p>
  </Section>

  <Section id="providers" eyebrow="Providers" title="Who sells the tokens.">
    <div class="kit-table stack">
      <table>
        <thead><tr><th>Provider</th><th>Credentials</th><th>Through</th></tr></thead>
        <tbody>
          {providers.map((p) => (
            <tr>
              <th scope="row">{p.label}</th>
              <td data-label="Credentials">{p.kinds.map((k) => short(k.bills)).join(" · ")}</td>
              <td data-label="Through">{p.served_by.map((h) => harnessLabel.get(h) ?? h).join(" · ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">{priced} models ship with prices, all from {pricedBy}. Price any other model in Settings. Zero is fine for your own server.</p>
  </Section>

  <Section id="rules" eyebrow={`${RULES.length} rules`} title="Checked when a seat is hired, and again before every run.">
    <div class="cells hued">
      {RULES.map(([n, v]) => (
        <div class="cell">
          <span class="eyebrow">{n}</span>
          <p class="rule">{v}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Status" title="Built and tested. Not yet proven live.">
    <div class="cells c2">
      <div class="cell">
        <h3>Done</h3>
        <ul>
          <li>Every harness passes its contract tests, offline</li>
          <li>Every part of yaaf runs on any provider: the seats, the CEO chat, the Founder and the goal grader</li>
          <li>Roles name a class, and prices import from a feed</li>
          <li>Mixed providers on one budget is a test, not a promise</li>
        </ul>
      </div>
      <div class="cell warm">
        <h3>Not yet</h3>
        <ul>
          <li>A live seat on each provider, which only a deployment with real keys can prove. <code>yaaf smoke</code> checks one on yours.</li>
          <li>A Cursor CLI driver</li>
        </ul>
      </div>
    </div>
    <p class="note"><a href="/docs/runtimes/">The full design, and what each harness taught us →</a></p>
  </Section>
</BaseLayout>

<style>
  .rule { color: var(--color-ink) !important; font-size: 1.05rem !important; }
  .cls { border-top: 3px solid var(--hue) !important; background: color-mix(in srgb, var(--hue) 8%, var(--color-page)) !important; }
  .cls h3 { color: var(--hue); font-size: 1.5rem !important; }
</style>
