---
/**
 * The yaaf manifesto, as a page you scroll rather than a PDF you download.
 *
 * The chapter text is the manifesto's own (the "Professional Edition", October
 * 2026), word for word: edit the document, then this. What the page adds is
 * the "In yaaf today" line under each chapter, which says which part of the
 * belief the code already enforces and which part it does not yet. Those lines
 * follow the site's rule that every claim maps to a mechanism; the manifesto
 * itself is allowed to say what it hopes.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import AutonomyDial from "../components/AutonomyDial.astro";

const roles = await getCollection("roles");
const challengers = roles.filter((r) => r.data.category === "challenge").length;

const PDF = "/yaaf-manifesto.pdf";

const CHAPTERS = [
  {
    id: "conviction",
    kicker: "The conviction",
    title: ["Great ideas", "deserve great teams."],
    body: [
      "The world is full of people with ideas they cannot pursue.",
      "Not because their ideas aren’t good enough. But because bringing an idea to life takes more than ambition.",
      "It takes knowledge. Experience. Specialists. Leadership. Coordination. And often, money.",
      "Building a capable team has always been one of the greatest barriers between having an idea and making it real.",
      "We believe that barrier is about to change.",
    ],
    figure: "flow",
    flowLabel: "From possibility to progress",
    flow: [
      { k: "The idea", v: "Someone sees a possibility", hue: "sky" },
      { k: "The team", v: "Specialists work together", hue: "mint" },
      { k: "The result", v: "A meaningful outcome", hue: "sun" },
    ],
    today: { v: "yaaf is Apache-2.0 and runs on your own machine. There is no account and no hosted tier; your agents pay your model provider directly.", href: "/#start", go: "Open source" },
  },
  {
    id: "belief",
    kicker: "The belief",
    title: ["Intelligence is not enough.", "Organization makes it useful."],
    body: [
      "Artificial intelligence has given us remarkable capabilities.",
      "First, models could answer questions. Then, agents could perform tasks.",
      "But giving someone an intelligent agent is not the same as giving them a capable team.",
      "Real work rarely happens in isolation. It requires different skills, competing perspectives, shared knowledge, clear responsibilities, and someone accountable for the outcome.",
      "A software engineer builds. A marketer understands customers. An analyst examines evidence. A critic challenges assumptions. A leader brings everything together.",
      "No single role needs to know everything. The organization makes their combined knowledge useful.",
    ],
    figure: "shift",
    flowLabel: "From individual intelligence to organized work",
    flow: [
      { k: "Models", v: "Answer questions", hue: "old" },
      { k: "Agents", v: "Complete tasks", hue: "sun" },
      { k: "Teams", v: "Pursue outcomes", hue: "dawn" },
    ],
    pull: ["We believe the next great advancement in AI won’t simply be a smarter model.", "It will be how we organize intelligence to work together."],
    today: { v: `The role library holds ${roles.length} job descriptions, each with its own instructions, model class and tools. ${challengers} of them exist to disagree.`, href: "/org/", go: "The team" },
  },
  {
    id: "method",
    kicker: "The method",
    title: ["Build a company.", "Hire a CEO. Let the team work."],
    body: [
      "Yaaf brings the structure of an organization to artificial intelligence.",
      "You start with a goal. It might be finding the right printer for your office, building a software product, operating a marketing department, or creating an entirely new business.",
      "You decide what success means. You are the chairman.",
      "You can assemble your own team, define its roles, establish its rules, and direct its work. Or you can delegate those responsibilities to an AI CEO.",
      "Your CEO coordinates specialists, breaks objectives into manageable work, evaluates results, and determines what should happen next.",
      "The team works toward the goal.",
    ],
    figure: "org",
    pull: ["You don’t need to know how to hire every specialist.", "You need to know what you’re trying to accomplish."],
    today: { v: "Describe the project in a paragraph and the Founder drafts the goal, the teams, the budget and the date, then argues with you until nothing is assumed.", href: "/how-it-works/", go: "How it works" },
  },
  {
    id: "authority",
    kicker: "The authority",
    title: ["Authority belongs", "to the chairman."],
    body: [
      "Autonomy should never mean surrendering control.",
      "Some people want to approve every important decision. Others want to define a goal, establish a budget, and let their CEO operate independently.",
      "Both approaches belong in yaaf.",
      "The chairman decides how much authority to delegate.",
      "The CEO operates within those boundaries, adjusting plans, assigning responsibilities, and pursuing alternatives as circumstances change.",
      "Delegation changes who makes decisions. It does not remove accountability.",
      "The organization works for you, not the other way around.",
    ],
    figure: "dial",
    today: { v: "The dial above is the real one: five switches in a constitution no agent can edit. Budgets, verification and the record bind the same at every setting.", href: "/docs/autonomy/", go: "Autonomy" },
  },
  {
    id: "standard",
    kicker: "The standard",
    title: ["Trust is earned", "through evidence."],
    body: [
      "A confident answer is not necessarily a correct answer.",
      "A completed task is not necessarily a successful task.",
      "And an AI agent agreeing with another AI agent is not proof that either is right.",
      "We believe intelligent organizations need more than intelligence. They need checks and balances.",
      "Work should be evaluated against objectives. Important conclusions should have supporting evidence. Decisions should be open to challenge.",
      "Independent reviewers should be able to disagree. Assumptions should be tested. Information should be traceable to its source.",
      "When necessary, the CEO should seek external validation rather than simply trusting the team’s conclusions.",
      "Yaaf is designed around the principle that decisions should be explainable, evidence should be inspectable, and authority should be enforceable.",
    ],
    figure: "flow",
    flowLabel: "The evidence trail",
    flow: [
      { k: "Source", v: "Where did it come from?", hue: "violet" },
      { k: "Work", v: "How was it used?", hue: "mint" },
      { k: "Review", v: "Was it challenged?", hue: "rose" },
      { k: "Decision", v: "What can we defend?", hue: "gold" },
    ],
    pull: ["Trust should never require blind faith."],
    today: { v: "Nothing closes without observed evidence. External evidence is fetched, hashed and snapshotted by the server, and a random sample of finished work is dealt to you to check.", href: "/docs/features/", go: "Features" },
  },
  {
    id: "challenge",
    kicker: "The challenge",
    title: ["A good CEO knows", "when to disagree."],
    body: [
      "A leader’s job is not to say yes.",
      "Ask a CEO to build a business generating $100 million in twelve months with an unrealistic budget, and a good CEO should challenge the request.",
      "It should question the assumptions, explain the risks, and help establish an achievable objective.",
      "The same principle applies throughout the organization.",
      "A specialist should be able to challenge a plan. A critic should identify weaknesses. A CEO should question its own conclusions.",
      "We don’t want AI teams that simply agree with one another.",
      "We want teams capable of finding better answers.",
    ],
    figure: "flow",
    flowLabel: "What honest leadership looks like",
    flow: [
      { k: "The ask", v: "An ambitious goal", hue: "sun" },
      { k: "The challenge", v: "Test the assumptions", hue: "sky" },
      { k: "The plan", v: "A credible next step", hue: "mint" },
    ],
    pull: ["The CEO should question its own conclusions, too."],
    today: { v: "Before anything exists, the Founder grades your goal against a written ten-point standard and argues with you. Critic seats can veto the work they check, and the CEO cannot remove the last one.", href: "/docs/goal-grammar/", go: "The goal standard" },
  },
  {
    id: "process",
    kicker: "The process",
    title: ["Learning is part", "of the work."],
    body: [
      "Not every project succeeds.",
      "A product might fail to find customers. A marketing campaign might miss its target. A promising strategy might turn out to be wrong.",
      "That doesn’t mean the work was worthless.",
      "A campaign targeting 100 sales that delivers 50 may reveal something important about the product, pricing, market, or original expectations.",
      "An intelligent organization should recognize these lessons.",
      "It should preserve what it learns, reconsider its assumptions, explore alternatives, and improve its methods.",
      "AI agents offer an extraordinary opportunity to experiment, evaluate, and revise approaches at a speed and cost that would be difficult for many traditional organizations.",
      "But learning requires memory. Improvement requires evidence. And progress requires the willingness to admit when something isn’t working.",
    ],
    figure: "gap",
    today: { v: "Work hangs off bets with kill dates. An expired bet dies on schedule unless you extend it with a reason, and every killed bet stays on the record.", href: "/docs/features/", go: "Features" },
  },
  {
    id: "advantage",
    kicker: "The advantage",
    title: ["The company", "remembers."],
    body: [
      "In a traditional organization, knowledge is often scattered across people, conversations, documents, and systems.",
      "When someone leaves, valuable knowledge can disappear with them.",
      "We believe an AI organization should build lasting institutional knowledge.",
      "Its decisions, discoveries, operating procedures, evidence, and lessons should remain available for future work.",
      "That knowledge belongs to the chairman.",
      "Over time, a team can become increasingly specialized in its industry, customers, responsibilities, and ways of working.",
      "The organization should not have to start from zero every time it begins a new task.",
    ],
    figure: "memory",
    today: { v: "Each project keeps a memory the CEO curates and each team one its lead curates, searchable by agents and readable by you. Memory that carries from one project to the next is not built yet.", href: "/docs/features/", go: "Features" },
  },
  {
    id: "future",
    kicker: "The future",
    title: ["The future is bigger", "than a single team."],
    body: [
      "Today, people assemble teams to solve problems.",
      "Tomorrow, we believe they will assemble organizations of AI specialists capable of tackling increasingly ambitious challenges.",
      "Some will exist for an afternoon. Others will operate continuously.",
      "Some will work alongside people. Others will operate with extensive autonomy, governed by the objectives and boundaries their owners establish.",
      "We envision a future where these organizations become as productive, capable, and reliable as well-run human organizations.",
      "Not because AI is infallible.",
      "But because intelligence, when organized with leadership, evidence, accountability, and the ability to learn, can accomplish things that isolated intelligence cannot.",
      "We aren’t there yet.",
      "Building trustworthy autonomous organizations is difficult. There are limits to what AI can do, and important questions still need answers.",
      "But we believe this is a future worth building.",
    ],
    figure: "flow",
    flowLabel: "Many forms of meaningful work",
    flow: [
      { k: "A task", v: "Find the right printer", hue: "violet" },
      { k: "An operation", v: "Run a virtual assistant", hue: "mint" },
      { k: "A business", v: "Build and operate a product", hue: "sun" },
    ],
    today: { v: "A project can deliver a result and stop, or operate continuously, woken by the world. A company that runs a business on its own is the direction, not a feature.", href: "/examples/", go: "Use cases" },
  },
];

const PRINCIPLES = [
  { k: "Teams for everyone", v: "Expertise should not depend on hiring power.", hue: "sky" },
  { k: "Chairman in control", v: "Goals, authority and knowledge stay yours.", hue: "sun" },
  { k: "CEO owns execution", v: "The leader organizes work and pursues results.", hue: "mint" },
  { k: "Evidence over confidence", v: "Claims should withstand scrutiny.", hue: "violet" },
  { k: "Structural accountability", v: "Budgets, reviews and approvals are enforced.", hue: "sky" },
  { k: "Learning is work", v: "Preserve lessons; improve the next attempt.", hue: "mint" },
];
const LAST = { k: "Truth matters more than agreement", v: "A trustworthy CEO has to be willing to disagree with its chairman." };

const pad = (n: number) => String(n).padStart(2, "0");
---
<BaseLayout
  title="The manifesto"
  description="Great ideas deserve great teams. Why yaaf exists: intelligence is not enough, organization makes it useful. The yaaf manifesto, in ten chapters and seven principles."
>
  <section class="page-hero mf-hero">
    <div class="shell">
      <p class="eyebrow">The manifesto · October 2026</p>
      <h1>Great ideas deserve <span class="dawn-text">great teams.</span></h1>
      <p class="lede"><strong>Intelligence is not enough. Organization makes it useful.</strong> Why yaaf exists, what it believes, and where it is going, in ten chapters and seven principles.</p>
      <div class="btns">
        <Button href="#conviction" primary>Read the manifesto</Button>
        <Button href={PDF} external={false}>Download the PDF</Button>
      </div>
      <nav class="toc" aria-label="Chapters">
        {CHAPTERS.map((c, i) => <a href={`#${c.id}`}>{pad(i + 1)} {c.kicker.replace(/^The (.)/, (_, ch) => ch.toUpperCase())}</a>)}
        <a href="#principles">10 Commitments</a>
      </nav>
    </div>
  </section>

  {CHAPTERS.map((c, i) => (
    <section id={c.id} class="ch">
      <div class="shell">
        <div class="ch-in">
          <header class="ch-head">
            <p class="eyebrow">{pad(i + 1)} / {c.kicker}</p>
            <h2>{c.title[0]}<br />{c.title[1]}</h2>
          </header>
          <div class="ch-body">
            {c.body.map((p) => <p>{p}</p>)}
          </div>

          <div class="fig">
            {(c.figure === "flow" || c.figure === "shift") && (
              <div class:list={["flow", { shift: c.figure === "shift" }]} style={`--n:${c.flow!.length}`}>
                <p class="fig-label">{c.flowLabel}</p>
                <div class="flow-row">
                  {c.flow!.map((f) => (
                    <div class={`fl fl-${f.hue}`}>
                      <span class="dot"></span>
                      <b>{f.k}</b>
                      <span>{f.v}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {c.figure === "org" && (
              <div class="org" role="img" aria-label="An organization of specialist roles: the chairman, the CEO beneath, and four specialists — research, build, marketing and a critic — beneath the CEO.">
                <p class="fig-label">An organization of specialist roles</p>
                <span class="o chair">Chairman</span>
                <span class="o-stem"></span>
                <span class="o ceo">CEO</span>
                <span class="o-stem"></span>
                <span class="o-rail"></span>
                <div class="o-row">
                  <span class="o h-sky">Research</span>
                  <span class="o h-mint">Build</span>
                  <span class="o h-sun">Marketing</span>
                  <span class="o h-violet">Critic</span>
                </div>
                <a class="o-more" href="/#why">Click through each seat on the home page →</a>
              </div>
            )}

            {c.figure === "dial" && (
              <div>
                <p class="fig-label">You choose the degree of delegation</p>
                <AutonomyDial id="mf-dial" />
              </div>
            )}

            {c.figure === "gap" && (
              <div class="gap">
                <p class="fig-label">Illustrative example / a marketing target</p>
                <div class="gap-nums">
                  <div><span class="gn">100</span><span class="gl">Target</span></div>
                  <div><span class="gn actual">50</span><span class="gl">Actual</span></div>
                </div>
                <p class="gap-line">The gap is not the conclusion. It is the start of an investigation.</p>
                <ol class="loop">
                  <li>Test</li><li>Measure</li><li>Learn</li><li>Adapt</li>
                </ol>
              </div>
            )}

            {c.figure === "memory" && (
              <div class="mem">
                <p class="fig-label">Knowledge remains with the organization</p>
                <div class="mem-row">
                  <div class="fl fl-sky"><span class="dot"></span><b>Project A</b><span>Decision + evidence</span></div>
                  <div class="fl fl-sun"><span class="dot"></span><b>Project B</b><span>Process + lesson</span></div>
                  <div class="fl fl-mint"><span class="dot"></span><b>Project C</b><span>Result + reflection</span></div>
                </div>
                <div class="mem-rail" aria-hidden="true"><i></i><i></i></div>
                <p class="mem-core">Chairman-owned memory</p>
              </div>
            )}

            {c.pull && (
              <p class="pull">{c.pull.length > 1 ? <>{c.pull[0]} <strong>{c.pull[1]}</strong></> : <strong>{c.pull[0]}</strong>}</p>
            )}
          </div>

          <p class="today"><span>In yaaf today</span>{c.today.v} <a href={c.today.href}>{c.today.go} →</a></p>
        </div>
      </div>
    </section>
  ))}

  <section id="principles" class="ch">
    <div class="shell">
      <div class="ch-in">
        <header class="ch-head">
          <p class="eyebrow">10 / The commitments</p>
          <h2>Seven principles.<br />One standard.</h2>
        </header>
        <div class="ch-body">
          <p>The ideas behind yaaf become meaningful only when they change how an organization behaves.</p>
        </div>
        <div class="principles">
          {PRINCIPLES.map((p, i) => (
            <div class={`pr h-${p.hue}`}>
              <span class="pn">{pad(i + 1)}</span>
              <h3>{p.k}</h3>
              <p>{p.v}</p>
            </div>
          ))}
          <div class="pr last">
            <span class="pn">07</span>
            <h3>{LAST.k}</h3>
            <p>{LAST.v}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="promise" class="promise">
    <div class="sky" aria-hidden="true"></div>
    <div class="shell">
      <div class="pm-in">
        <p class="eyebrow">The promise</p>
        <h2>Great ideas deserve <span class="dawn-text">great teams.</span></h2>
        <div class="pm-body">
          <p>You shouldn’t have to abandon an idea because you cannot hire the people needed to pursue it.</p>
          <p>You shouldn’t need expertise in every discipline before attempting something ambitious.</p>
          <p>And you shouldn’t have to manage every individual task when your real responsibility is deciding what matters.</p>
          <p>We want to make capable teams accessible to everyone.</p>
          <p>Teams that can work independently, challenge assumptions, explain decisions, adapt to setbacks, and build on what they learn.</p>
          <p>Organizations that remain accountable to the people who create them.</p>
        </div>
        <p class="pm-close">Because the future of AI isn’t just about what a model can do. <strong>It’s about what we can accomplish when intelligence works together.</strong></p>
        <p class="pm-sign">Build a company. Hire a CEO. Let the team work.</p>
        <div class="btns">
          <Button href="/how-it-works/" primary>See how it works</Button>
          <Button href={PDF} external={false}>Download the PDF</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mf-hero h1 { max-width: 14ch; font-size: var(--text-hero); }
  .mf-hero .lede { max-width: 52ch; }

  /* ---------- a chapter ---------- */
  .ch-in {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-line);
    padding-block: 6rem;
  }
  .ch-head { grid-column: 1 / span 2; padding-inline: var(--inset); }
  .ch-head .eyebrow { margin: 0 0 1.4rem; width: fit-content; background: var(--dawn); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ch-head h2 { margin: 0; font-size: var(--text-h2); line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
  .ch-head { position: sticky; top: 100px; align-self: start; }
  .ch-body { grid-column: 3 / span 2; padding-inline: var(--inset); }
  .ch-body p { margin: 0 0 0.9rem; font-size: 1.15rem; line-height: 1.55; color: var(--color-ink-2); text-wrap: pretty; }
  .ch-body p:last-child { margin-bottom: 0; color: var(--color-ink); }
  .fig { grid-column: 1 / -1; margin-top: 3.4rem; }
  .fig-label { margin: 0 0 1rem; padding-inline: var(--inset); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent-hi); }
  .pull { margin: 1.6rem 0 0; padding-inline: var(--inset); font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem); line-height: 1.3; letter-spacing: -0.025em; color: var(--color-ink-2); max-width: 48ch; }
  .pull strong { color: var(--color-ink); font-weight: 500; }
  .today {
    grid-column: 1 / -1;
    margin: 2.4rem 0 0;
    padding: 1.1rem var(--inset);
    border-left: 3px solid var(--color-mint);
    background: color-mix(in srgb, var(--color-mint) 6%, var(--color-page));
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .today span { display: block; margin-bottom: 4px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-mint); }
  .today a { color: var(--color-accent-hi); text-decoration: none; white-space: nowrap; }
  .today a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- figures ---------- */
  .flow-row, .mem-row { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); border: 1px solid var(--color-line); }
  .mem-row { --n: 3; }
  .fl { position: relative; padding: 1.4rem var(--inset) 1.6rem; border-right: 1px solid var(--color-line); background: color-mix(in srgb, var(--hue) 7%, var(--color-page)); }
  .fl:last-child { border-right: 0; }
  .flow-row .fl:not(:last-child)::after { content: "→"; position: absolute; right: -0.65em; top: 1.3rem; z-index: 1; color: var(--color-ink-2); background: var(--color-page); padding: 4px 2px; line-height: 1; }
  .fl .dot { display: block; width: 14px; height: 14px; border-radius: 50%; background: var(--hue); margin-bottom: 0.9rem; }
  .fl b { display: block; font-weight: 550; font-size: 1.15rem; letter-spacing: -0.02em; color: var(--color-ink); }
  .fl > span:last-child { display: block; margin-top: 4px; font-size: 15px; color: var(--color-ink-2); }
  .fl-sky { --hue: var(--color-sky); }
  .fl-mint { --hue: var(--color-mint); }
  .fl-sun { --hue: var(--color-sun); }
  .fl-rose { --hue: var(--color-rose); }
  .fl-gold { --hue: var(--color-gold); }
  .fl-violet { --hue: var(--color-violet); }
  .fl-old { --hue: var(--color-old); background: var(--color-old-bg); }
  .fl-old b { color: #b0b0b0; }
  .fl-old > span:last-child { color: #8a8a8a; }
  .fl-dawn { --hue: #fff; background: linear-gradient(125deg, var(--color-gold) 0%, var(--color-sun) 32%, var(--color-rose) 66%, var(--color-violet) 100%); }
  .fl-dawn b, .fl-dawn > span:last-child { color: #14051f; }
  .fl-dawn .dot { background: #fff; box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.35); }

  .org { display: flex; flex-direction: column; align-items: center; padding: 2rem var(--inset) 1.6rem; border: 1px solid var(--color-line); background: radial-gradient(80% 60% at 50% 0%, color-mix(in srgb, var(--color-violet) 14%, transparent), transparent 70%); }
  .org .fig-label { align-self: flex-start; padding-inline: 0; }
  .o { display: block; width: min(100%, 260px); padding: 12px; text-align: center; font-weight: 550; letter-spacing: -0.01em; border: 1px solid color-mix(in srgb, var(--hue, var(--color-line-strong)) 55%, transparent); background: color-mix(in srgb, var(--hue, transparent) 9%, var(--color-page)); color: var(--hue, var(--color-ink)); }
  .o.chair { --hue: var(--color-gold); }
  .o.ceo { --hue: var(--color-rose); }
  .o-stem { width: 1px; height: 22px; background: var(--color-line-strong); }
  .o-rail { width: 75%; height: 1px; background: var(--color-line-strong); }
  .o-row { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .o-row .o { width: 100%; position: relative; margin-top: 22px; }
  .o-row .o::before { content: ""; position: absolute; left: 50%; top: -23px; width: 1px; height: 22px; background: var(--color-line-strong); }
  .o-more { margin-top: 1.2rem; font-size: 14px; color: var(--color-accent-hi); text-decoration: none; }
  .o-more:hover { text-decoration: underline; text-underline-offset: 3px; }

  .gap { border: 1px solid var(--color-line); padding: 1.8rem var(--inset); background: color-mix(in srgb, var(--color-sky) 4%, var(--color-page)); }
  .gap .fig-label { padding-inline: 0; }
  .gap-nums { display: flex; gap: 0; }
  .gap-nums > div { display: flex; align-items: baseline; gap: 14px; padding-right: 2.4rem; }
  .gap-nums > div + div { padding-left: 2.4rem; border-left: 1px solid var(--color-line); }
  .gn { font-size: clamp(3rem, 2rem + 3vw, 5rem); line-height: 1; letter-spacing: -0.05em; font-weight: 500; }
  .gn.actual { color: var(--color-mint); }
