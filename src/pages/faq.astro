---
import BaseLayout from "../layouts/BaseLayout.astro";
import { REPO_URL } from "../site.config.mjs";
import manifest from "../content/manifest.json";

const h = manifest.history;
const firstCommit = new Date(h.firstCommit).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });

interface QA { id: string; q: string; a: string }
const GROUPS: { title: string; items: QA[] }[] = [
  {
    title: "Basics",
    items: [
      { id: "what", q: "What is yaaf?", a: "Open-source software for building a company of AI agents. You describe the goal and hire a CEO; the CEO runs a team for weeks, and yaaf's server enforces the rules, not the prompt." },
      { id: "harness", q: "What does “a harness for teams of harnesses” mean?", a: `Claude Code, Codex, Gemini CLI and OpenCode are agent harnesses: each drives one model with a loop and tools. yaaf puts each of them in a seat on an org chart and is the harness around the whole team: who is hired, what's next, what it costs, when it's due and whether it's really done. <a href="/runtimes/">Harnesses and models →</a>` },
      { id: "hosted", q: "Is there a hosted version or a paid plan?", a: "No, and there isn't going to be one to upsell you. yaaf is Apache-2.0 software you run yourself. Your agents pay your model provider directly. No account, no telemetry." },
      { id: "who", q: "Who is it for?", a: "Anyone handing off work that runs unattended for weeks and must be checked. Not for quick tasks; use a skill for those." },
      { id: "paperclip", q: "How is it different from Paperclip?", a: `Paperclip coordinates agents wherever they run. yaaf runs them itself, so only the platform marks work done. <a href="/compare/#paperclip">Full comparison →</a>` },
    ],
  },
  {
    title: "How it works",
    items: [
      { id: "done", q: "How does it know work is really done?", a: "Every task has a test. The platform runs it, or fetches and checks the evidence. Agents can't mark anything done." },
      { id: "how-often", q: "How often will it need me?", a: `Your choice. Five switches decide what you approve. An example team needed you 0 times, or 7 with approvals on. <a href="/how-it-works/#dial">See both →</a>` },
      { id: "runaway", q: "What stops a runaway bill?", a: "Every run is metered live. Runs have a cap, loops are braked, and the project pauses at a hard limit." },
      { id: "date", q: "Can the CEO move the deadline?", a: "No. The date comes from measured pace. If it slips, new work freezes until scope is cut or the date is reset." },
    ],
  },
  {
    title: "Models and cost",
    items: [
      { id: "models", q: "Which models does it run?", a: `Claude, GPT, Gemini, Bedrock, Vertex, Azure, DeepSeek, Mistral, Kimi, Qwen, Grok, Groq, OpenRouter, a local Ollama or LM Studio, or any OpenAI-compatible server: ${manifest.providers} providers through ${manifest.harnesses} harnesses. Roles name a class (frontier, balanced, fast), so a team runs on whichever provider you pay. <a href="/runtimes/">Harnesses and models →</a>` },
      { id: "subscription", q: "Can I use my Claude subscription?", a: "For personal tinkering only. Anthropic's terms don't allow running fleets on a personal plan. Use an API key." },
      { id: "cost", q: "How much does it cost?", a: "yaaf itself costs nothing. The models cost what your provider charges. Nobody has published a real month's bill yet; the $0 rehearsal tells you the most a run can cost and still fit your budget, and every run is metered against a cap you set." },
      { id: "local", q: "Can it run on local models?", a: "Yes: Ollama, LM Studio or any OpenAI-compatible server. The prompts were tuned on Claude, so quality may vary." },
    ],
  },
  {
    title: "Running it",
    items: [
      { id: "try", q: "Can I see a company run before I pay for any model?", a: "Yes. Clone the repo, <code>pip install -e .</code> and run <code>yaaf rehearse examples/01-your-first-hour.json</code>. A whole project runs on scripted agents: no key, no Docker, $0." },
      { id: "install", q: "What do I need to install it?", a: `On your own machine, a checkout and <code>yaaf up</code>, which starts everything and prints the address. On a server, a Linux box with Docker; one script does the rest. <a href="/docs/deployment/">Install guide →</a>` },
      { id: "claude", q: "Can I run it from Claude?", a: "Yes. yaaf is an MCP server. Claude Code, Claude Desktop and Cursor connect with a token. claude.ai needs a public address." },
      { id: "secure", q: "Is it secure?", a: `Agents run in sandboxes with limited secrets, but they can reach the internet. No outside review yet. <a href="/docs/security/">Security model →</a>` },
    ],
  },
  {
    title: "The project",
    items: [
      { id: "mature", q: "How mature is it?", a: `Pre-1.0. First commit ${firstCommit}. ${manifest.tests.toLocaleString("en-US")} tests. One maintainer.` },
      { id: "ai-built", q: "Was it built with AI?", a: `Yes, openly, with Claude Code. About ${h.claudeShare}% of commits say so.` },
      { id: "contribute", q: "How can I help?", a: `Try to break a rule. Every rule has a test, and a failing one is the best contribution. <a href="${REPO_URL}/blob/main/CONTRIBUTING.md" rel="noopener">Contributing →</a>` },
    ],
  },
];

const strip = (html: string) => html.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: GROUPS.flatMap((g) => g.items).map((it) => ({
    "@type": "Question",
    name: it.q,
    acceptedAnswer: { "@type": "Answer", text: strip(it.a) },
  })),
};
---
<BaseLayout title="FAQ" description="Short answers about yaaf: what it is, how it differs from Paperclip, how it checks work, which models it runs, what it costs and how safe it is.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">FAQ</p>
      <h1>Questions, answered.</h1>
      <p class="lede">Short answers. Where the answer is “not yet”, we say so.</p>
    </div>
  </section>

  <div class="shell">
    {GROUPS.map((g) => (
      <section class="grp">
        <h2 class="eyebrow">{g.title}</h2>
        {g.items.map((it) => (
          <article class="qa anchor" id={it.id}>
            <h3><a href={`#${it.id}`}>{it.q}</a></h3>
            <p set:html={it.a} />
          </article>
        ))}
      </section>
    ))}
    <p class="note more">Question not here? <a href={`${REPO_URL}/issues`} rel="noopener">Ask on GitHub →</a></p>
  </div>
</BaseLayout>

<style>
  .grp { border-top: 1px solid var(--color-line); padding: 3rem 0 1rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .grp > h2 { grid-column: 1 / -1; margin: 0 0 1.5rem; padding-inline: var(--inset); }
  .qa { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; padding-block: 1.4rem; border-top: 1px solid var(--color-line-2); }
  .qa h3, .qa p { padding-inline: var(--inset); }
  .qa h3 { grid-column: 1 / span 2; margin: 0; font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.025em; }
  .qa h3 a { color: var(--color-ink); text-decoration: none; }
  .qa h3 a:hover { color: var(--color-accent-hi); }
  .qa p { grid-column: 3 / span 2; margin: 0; font-size: 16px; line-height: 1.6; color: var(--color-ink-2); }
  .qa p :global(a) { color: var(--color-accent-hi); text-decoration: none; white-space: nowrap; }
  .qa p :global(a:hover) { text-decoration: underline; text-underline-offset: 3px; }
  .qa p :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-surface-2); border: 1px solid var(--color-line); padding: 0.05em 0.35em; }
  .more { padding-bottom: 5rem; }
  @media (max-width: 900px) {
    .qa h3, .qa p { grid-column: 1 / -1; }
    .qa p { margin-top: 0.6rem; }
  }
</style>
