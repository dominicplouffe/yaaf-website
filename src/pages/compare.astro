---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Term from "../components/Term.astro";
import { REPO_URL } from "../site.config.mjs";
import manifest from "../content/manifest.json";

const roles = await getCollection("roles");
const crews = await getCollection("crews");
const challengers = roles.filter((r) => r.data.category === "challenge");

const KILL = `<i># docs/PLAN.md</i>
If the org arm does not beat the single-agent arm on the
pre-registered rubric — blind-judged quality, verified external
evidence, cost, wall-clock — then yaaf-as-an-org-framework
is <b>shelved</b>.`;

/** Paperclip's column is from its own README (paperclipai/paperclip), read in October 2026. */
const PAPERCLIP = [
  ["The idea", "“If OpenClaw is an employee, Paperclip is the company.” A task manager and control plane for a company of agents.", "An org with a constitution: a CEO, teams and critics, under rules the server enforces rather than prompts."],
  ["Where agents run", "Wherever they already run. Adapters wake Claude Code, Codex, Cursor, Gemini CLI, OpenClaw, HTTP bots and more — “if it can receive a heartbeat, it's hired.”", "Inside yaaf: a fresh container per run, on a per-run token, under yaaf's meter. A harness that can't report what it spends while it spends it is not admitted."],
  ["What “done” means", "Configurable review and approval stages; verify from diffs, screenshots and tests.", "Only the platform writes “met”. It runs command tests itself in a sandbox, fetches and hashes external evidence, and deals you random closes to spot-check."],
  ["Budget enforcement", "Company, agent and project budgets with alerts and hard stops. Its README: “Enforcement uses recorded spend; usage reporting and in-flight work can delay a stop.”", "Usage streams in as it is spent; a per-run governor stops a run mid-attempt. The monthly budget is a plan you may overrun with an account; the wall pauses the project and revokes live runs."],
  ["Before you spend", "test-drive: a real instance with a CEO agent, on your API key.", "A $0 fire drill of your exact spec on scripted agents against the real policy engine: where it stalls, what paces it, how often it will wait for you."],
  ["Goals", "Goals in a hierarchy; tasks carry goal ancestry so agents see the why.", "A goal is graded against ten elements before a project exists — a finish line and the record that settles it, anti-metrics, a failure deliverable."],
  ["Delivery dates", "Not described in its README.", "A commitment the platform stamps from measured pace and re-projects every tick. Past the promise, new scope freezes."],
  ["Disagreement", "Roles, reporting lines and review stages.", `Structural: ${challengers.length} of ${roles.length} library roles exist to attack the others' work, a risk seat can veto, and the CEO cannot remove its own last critic.`],
  ["Chairing from a model", "A mobile-ready UI; experimental Agent Chat and chat/email connectors (Slack, Discord, Telegram).", "An MCP server — 32 tools, four scopes. Claude gets its own credential; nothing irreversible in one call; agent text arrives labelled untrusted."],
  ["Breadth", "Plugins, a skill studio and store, evals, company templates, multiple companies per deployment, cloud sandbox providers.", `A role library (${roles.length} roles, ${crews.length} crews), project export and clone, many projects per box. No plugin system.`],
  ["Telemetry", "Anonymous usage telemetry, on by default; opt out with an environment variable.", "None. The sandbox switches off every harness's own telemetry, too."],
  ["Stack and setup", "MIT. Node.js and React with an embedded Postgres; one npx command, no Docker.", "Apache-2.0. Python and React on Postgres 16, under Docker Compose; one script, one box."],
  ["Maturity", "Public since early 2026, tens of thousands of GitHub stars, a team and a company, 2,700+ merged pull requests.", `First commit ${new Date(manifest.history.firstCommit).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}. One maintainer, pre-1.0, no outside security review.`],
];

const AHEAD = [
  "Adoption, a community and a team behind it. That matters more than any row above for a project you plan to depend on.",
  "Breadth of agents: Cursor, OpenClaw, Hermes, Pi, HTTP endpoints and external adapter packages, plus cloud sandbox providers.",
  "Extensibility: an out-of-process plugin system, a skill studio with versioning and saved test inputs, agent evals.",
  "Several companies per deployment, a phone-friendly UI, OpenTelemetry and Sentry hooks.",
  "Setup: one npx command with an embedded database and no Docker.",
];

const FURTHER = [
  "Verification as structure: there is no agent verb that marks work done.",
  "A free rehearsal of your exact configuration before any money moves.",
  "A written standard for goals, graded before a project exists.",
  "Metering as an admission rule, and a per-run governor rather than a stop that waits on reporting.",
  "A delivery date that is arithmetic, and a scope freeze when it slips.",
  "Disagreement the CEO cannot fire, and seats on different vendors' models under one cap.",
  `${manifest.tests.toLocaleString("en-US")} offline tests that attack the rules over HTTP, and no telemetry.`,
];

const GRADED = [
  ["finish_line", "weak", "$1M MRR is a number, but nothing names the record that settles it — whose ledger? “#1” has no record at all."],
  ["beneficiary", "missing", "Who the app has to be right for is unsaid, so the only reader an agent ever hears from is the chairman."],
  ["standard", "missing", "No body of practice to be judged against, so the brief becomes the ceiling."],
  ["anti_metrics", "missing", "Signups, waitlists, downloads and stars are the nearest things a stalled project can reach and report instead."],
  ["quality_bar", "missing", "Done and good are different things for a consumer app; nothing says which wins."],
  ["failure_deliverable", "missing", "If it reaches $40k MRR in a year, what is owed? A goal that cannot speak about failure gets documents instead of a post-mortem."],
];

const ROWS = [
  ["Shape", "One assistant", "One agent", "A library you wire up", "A control plane for agents you run", "An org"],
  ["Weight", "A daemon", "A daemon", "An import, nothing to deploy", "A Node server, embedded Postgres", "Postgres and two containers"],
  ["Optimises for", "Reach", "Continuity", "Composition", "Coordination", "Accountability"],
  ["Time horizon", "A session", "An ongoing chat", "A run", "Ongoing", "Weeks"],
  ["Who picks the next task", "You", "You", "Your code", "A CEO agent and the org chart", "A CEO, inside a plan the platform gates"],
  ["“Done” means", "You say so", "You say so", "The graph returned", "A review stage passed", "The platform verified it"],
  ["Cost control", "Your own", "Your own", "Your own", "Budgets with alerts and stops", "A plan, a per-run governor, and a wall"],
  ["Disagreement", "—", "—", "Whatever you author", "Review stages you configure", "Roles that can veto"],
  ["The record", "Chat history", "Its memory", "Traces, if you wired them", "Activity log and run history", "Every message, run, dollar, decision, refusal"],
];
---
<BaseLayout
  title="Compare"
  description="How yaaf compares to Paperclip, to agent frameworks like LangGraph and CrewAI, to personal agents like OpenClaw and Hermes, and to a good skill — honestly, including where the others are ahead."
>
  <section class="page-hero">
    <div class="blueprint bp" aria-hidden="true"></div>
    <div class="shell">
      <p class="eyebrow">Compare</p>
      <h1>What yaaf is, next to what you'd otherwise reach for.</h1>
      <p class="lede">
        Fair answers, because an honest comparison is more useful than a flattering one. This page
        is written by yaaf, so read every row as a claim — and hold the heaviest one against it:{" "}
        <strong>yaaf is a server you run, and on a task that fits in one sitting that trade is simply bad.</strong>
      </p>
      <nav class="toc" aria-label="On this page">
        <a href="#paperclip">Paperclip</a>
        <a href="#frameworks">Agent frameworks</a>
        <a href="#assistants">OpenClaw &amp; Hermes</a>
        <a href="#skill">A good skill</a>
        <a href="#table">Everything in one table</a>
        <a href="#honest">The open question</a>
      </nav>
    </div>
  </section>

  <!-- ------------------------------------------------------------------ -->
  <Section id="paperclip" eyebrow="yaaf and Paperclip" title="Both put an org chart around AI agents. They disagree about where the rules live."
    lede="Paperclip is the best-known open-source control plane for teams of agents: a Node.js server and React UI with org charts, budgets, approvals, routines, plugins and adapters for nearly every coding agent. It is a much bigger project than yaaf. If what you want is a task manager for the agents you already run, it is a strong choice.">
    <div class="tiles c2 crux">
      <div class="tile">
        <span class="eyebrow">Paperclip's bet</span>
        <h3>Coordinate the agents you already have.</h3>
        <p>
          Agents run wherever they run and are woken by a heartbeat. Paperclip keeps the tasks, the org
          chart, the budgets and the approvals in one place, and verification is a review stage you
          configure — by a person or by another agent.
        </p>
      </div>
      <div class="tile hi">
        <span class="eyebrow">yaaf's bet</span>
        <h3>Don't trust what an agent says about its own work.</h3>
        <p>
          Every agent runs inside yaaf's container, on yaaf's token and meter, and the parts that make the
          work trustworthy — “met”, the bill, the date — are written by the platform, never by the party
          being graded. That costs breadth. It is the whole point.
        </p>
      </div>
    </div>

    <div class="kit-table cmp stack">
      <table>
        <thead><tr><th></th><th>Paperclip</th><th class="me">yaaf</th></tr></thead>
        <tbody>
          {PAPERCLIP.map(([k, a, b]) => (
            <tr><th scope="row">{k}</th><td data-label="Paperclip">{a}</td><td class="me" data-label="yaaf">{b}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Paperclip's column is taken from <a href="https://github.com/paperclipai/paperclip" rel="noopener">its own README</a>,
      read in October 2026; “not described” means exactly that, not “absent”. Corrections are welcome as an issue
      on <a href={REPO_URL} rel="noopener">yaaf's repository</a>.
    </p>

    <div class="tiles c2 sides">
      <div class="tile">
        <h3>Where Paperclip is ahead</h3>
        <ul>{AHEAD.map((a) => <li>{a}</li>)}</ul>
      </div>
      <div class="tile hi">
        <h3>Where yaaf goes further</h3>
        <ul>{FURTHER.map((a) => <li>{a}</li>)}</ul>
      </div>
    </div>

    <div class="graded">
      <div class="gh">
        <p class="eyebrow">One example, graded</p>
        <h3>“Build the #1 AI note-taking app to $1M MRR.”</h3>
        <p>
          That is the example goal in Paperclip's quickstart. It is not a criticism of a line in a README —
          nobody writes their real goal in a table cell. It is here because it is the most common shape of
          goal on the internet, and the shape is the problem: read against yaaf's <a href="/docs/goal-grammar/">goal
          grammar</a> the way its grader reads one, none of its five load-bearing elements is present: one is weak and four are missing.
        </p>
      </div>
      <div class="kit-table stack">
        <table>
          <thead><tr><th>Element</th><th>Grade</th><th>Why</th></tr></thead>
          <tbody>
            {GRADED.map(([k, g, v]) => (
              <tr>
                <th scope="row"><code>{k}</code></th>
                <td><span class:list={["pill", g === "weak" ? "warm" : "dim"]}>{g}</span></td>
                <td data-label="Why">{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Graded by hand against the rubric rather than by yaaf's grader, which is a model call. A goal that
        misses these does not fail loudly — it produces a project that hits every requirement it was given and
        is quietly the wrong work. <a href="/docs/goal-grammar/">The ten elements, and why each earns its place →</a>
      </p>
    </div>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section eyebrow="Agent frameworks" title="A framework composes agents. yaaf governs them." id="frameworks" grid={true}
    lede="LangGraph, CrewAI, AutoGen and friends solve a real problem: getting several models to pass work between each other. That problem is upstream of the one yaaf is about.">
    <div class="two">
      <div class="col">
        <p class="eyebrow">A framework gives you</p>
        <ul class="plain">
          <li>A way to wire agents into a graph</li>
          <li>Coordination you write as code</li>
          <li>Rules expressed as prompts</li>
          <li>“Done” when the graph returns</li>
          <li>Whatever it cost, after it cost it</li>
          <li>Traces, if you instrumented them</li>
        </ul>
      </div>
      <div class="col hi">
        <p class="eyebrow">yaaf adds the part underneath</p>
        <ul class="plain">
          <li>Agents act only through an authenticated API, on per-run tokens</li>
          <li>Every rule is an HTTP refusal or an automatic state change, never a sentence in a prompt</li>
          <li>Work that makes nothing true is refused: every task must serve a requirement that carries its own test</li>
          <li>Only the platform can write “met”. There is no agent verb for it</li>
          <li>A budget that warns, a governor on every run, and a wall that pauses the project</li>
          <li>A delivery date the platform stamps from measured pace and re-projects every tick</li>
        </ul>
      </div>
    </div>

    <div class="quote">
      <p>A prompt is a suggestion, and a clever model talks itself around one. So the rules live in the server, not the prompt. Break one and an agent doesn't get a stern reminder — it gets a 403.</p>
    </div>

    <p class="after">
      Use a framework when you are building the flow. Reach for yaaf when the flow has to survive six
      weeks without you and be defensible afterwards to a client, an auditor, or yourself. They are not
      the same tool, and yaaf is the slower, heavier one on purpose.
    </p>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section eyebrow="Personal agents" title="OpenClaw and Hermes make one agent better. yaaf makes many agents accountable." id="assistants"
    lede="Both are excellent, MIT-licensed and self-hosted, and neither is trying to do what yaaf is trying to do. The axes are different.">
    <div class="three">
      <article class="who">
        <p class="eyebrow">OpenClaw · MIT</p>
        <h3>Reach</h3>
        <p class="tl">“The AI that really does things.”</p>
        <p>A local-first assistant that meets you in the channels you already use: Discord, Slack, iMessage, Telegram, WhatsApp and more — on any OS. One gateway, one assistant, everywhere you are.</p>
        <a href="https://github.com/openclaw/openclaw" rel="noopener">github.com/openclaw/openclaw ↗</a>
      </article>
      <article class="who">
        <p class="eyebrow">Hermes Agent · MIT</p>
        <h3>Continuity</h3>
        <p class="tl">“The agent that grows with you.”</p>
        <p>One self-hosted agent with persistent memory and a closed learning loop: after a hard task it writes itself a reusable skill, so it is more capable the longer you use it.</p>
        <a href="https://github.com/NousResearch/hermes-agent" rel="noopener">github.com/NousResearch/hermes-agent ↗</a>
      </article>
      <article class="who me">
        <p class="eyebrow">yaaf · Apache-2.0</p>
        <h3>Accountability</h3>
        <p class="tl">“Stop prompting, start delegating.”</p>
        <p>An org: roles with their own charters, a CEO that picks the next piece of work, a budget that stops itself, a date the platform owns, and a record of every dollar and every refusal.</p>
        <a href={REPO_URL} rel="noopener">the repository ↗</a>
      </article>
    </div>

    <p class="mid">
      The compressed version: <strong>they are one agent, in a conversation, with you present.</strong>{" "}
      yaaf is <strong>many agents, accountable to each other, over weeks, with you absent.</strong>
    </p>

    <div class="callout">
      <p>
        <strong>These are not competitors.</strong> yaaf is an MCP server with thirty-two tools across four
        scopes, so anything that speaks MCP is a front end for it, including a personal assistant. Chair a yaaf
        project from wherever you already talk to an agent; yaaf is the floor underneath, not the window.
      </p>
    </div>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section eyebrow="A good skill" title="Isn't this just a skill?" id="skill" grid={true}
    lede="yaaf runs your skills: a role's skill list is an allowlist handed to the harness. A skill is a capability. yaaf decides which capability to point at what, checks it got done, pays for it from a capped budget, and keeps the receipt.">
    <div class="two">
      <div class="col">
        <p class="eyebrow">Use a skill when</p>
        <ul class="plain">
          <li>You're watching</li>
          <li>It finishes in one sitting</li>
          <li>Nothing irreversible happens</li>
          <li>Nobody asks in six weeks how you know</li>
        </ul>
      </div>
      <div class="col hi">
        <p class="eyebrow">Reach for yaaf when</p>
        <ul class="plain">
          <li>It has to run unattended for weeks</li>
          <li>“Done” can't be self-graded</li>
          <li>Money has to stop by itself</li>
          <li>You'll have to reconstruct it later for a client or an auditor</li>
          <li>You want agents to disagree, because one agent checking its own work has the same blind spots in both seats</li>
        </ul>
      </div>
    </div>
    <p class="after">
      A good model with a good skill out-writes yaaf's agents on any single task.{" "}
      <strong>The difference isn't capability. It's governance and duration.</strong>
    </p>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section id="table" eyebrow="Everything in one table" title="Five tools, five different jobs.">
    <p class="tnote">
      Written by yaaf, so read the rows as claims rather than findings, and the second one is the one to hold
      against it. On a task that fits in one sitting yaaf's trade is simply bad, and no row below buys it back.
    </p>
    <div class="kit-table stack">
      <table class="wide">
        <thead>
          <tr><th></th><th>OpenClaw</th><th>Hermes Agent</th><th>Frameworks</th><th>Paperclip</th><th class="me">yaaf</th></tr>
        </thead>
        <tbody>
          {ROWS.map(([label, a, b, c, d, e]) => (
            <tr>
              <th scope="row">{label}</th>
              <td data-label="OpenClaw">{a}</td><td data-label="Hermes Agent">{b}</td><td data-label="Frameworks">{c}</td><td data-label="Paperclip">{d}</td><td class="me" data-label="yaaf">{e}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section id="honest" grid={true} eyebrow="The honest part" title="Nobody has proven the org beats one good agent.">
    <div class="honest">
      <p>
        And yaaf doesn't claim to have. Hierarchy's main product is lossy summarisation at each boundary;
        the CEO's judgement — what to queue, kill and prioritise — is the actual bet, and everything else is
        transport. That question is open, and nothing in the repository settles it.
      </p>
      <p>
        What the repository does give you is a fair way to settle it yourself. <strong>Solo mode</strong> runs a
        single agent under byte-identical governance, so you can hand the same goal to a hierarchy and to one
        brain and compare the bills.
      </p>
      <Term label="The kill condition, in the repo, in public" code={KILL} />
      <p>
        The salvage path is already built and already usable: yaaf as a governance harness for a single agent —
        queues, requirements, verification, budgets, approvals and audit. And since October, on any of{" "}
        {manifest.providers} providers. <a href="/docs/plan/">The whole plan, including what is deliberately not built.</a>
      </p>
    </div>
  </Section>

  <!-- ------------------------------------------------------------------ -->
  <Section eyebrow="Colophon" title="Who's behind this">
    <div class="bio">
      <p>
        yaaf is one person's answer to a question that kept coming up while building startups: the thing
        that made a team work was never a smarter individual. It was the roles. Who owns what, who checks it,
        who is allowed to say no.
      </p>
      <p>
        The code was written fast, with Claude Code. The design wasn't. It is years of running teams,
        compiled, and then held honest by a test suite that attacks every rule over HTTP the way an agent
        would, with forged tokens, wrong roles and rephrased requests.
      </p>
      <p>
        It is open source and only that: no hosted version, no paid tier, no account to create, nothing that
        phones home. Pre-1.0, actively developed, Apache-2.0. Issues and pull requests welcome.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .crux { margin-bottom: 18px; }
  .cmp table { min-width: 760px; }
  .cmp tbody th { width: 150px; font-weight: 600; color: var(--color-ink); }
  .sides { margin-top: 22px; }

  .graded { margin-top: 40px; padding-top: 30px; border-top: 1px solid var(--color-line); }
  .gh { max-width: 72ch; margin-bottom: 18px; }
  .gh h3 { margin: 8px 0 0; font-size: 1.35rem; font-weight: 620; letter-spacing: -0.02em; }
  .gh p:last-child { margin: 10px 0 0; font-size: 15px; line-height: 1.65; color: var(--color-ink-2); }
  .gh a { color: var(--color-accent-hi); }
  .graded table { min-width: 620px; }
  .graded code { font-family: var(--font-mono); font-size: 12px; }

  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .col { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 18px; }
  .col.hi { border-color: color-mix(in srgb, var(--color-accent) 45%, transparent); background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface)); }
  ul.plain { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 9px; }
  ul.plain li { font-size: 14px; line-height: 1.55; color: var(--color-ink-2); padding-left: 18px; position: relative; }
  ul.plain li::before { content: "▸"; position: absolute; left: 0; color: var(--color-muted); font-size: 10px; top: 4px; }
  .col.hi ul.plain li::before { color: var(--color-accent); }

  .quote {
    margin-top: 22px;
    border-left: 2px solid var(--color-accent-2);
    background: color-mix(in srgb, var(--color-accent-2) 8%, transparent);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    padding: 16px 20px;
  }
  .quote p { margin: 0; font-size: 1.0625rem; line-height: 1.6; color: var(--color-ink); max-width: 64ch; }
  .after { margin: 22px 0 0; color: var(--color-ink-2); font-size: 15px; max-width: 64ch; line-height: 1.65; }

  .three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .who { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 18px; display: flex; flex-direction: column; gap: 8px; }
  .who h3 { margin: 6px 0 0; font-size: 1.35rem; font-weight: 640; letter-spacing: -0.02em; }
  .who .tl { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); }
  .who p { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--color-ink-2); }
  .who a { margin-top: auto; padding-top: 10px; font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); text-decoration: none; }
  .who a:hover { color: var(--color-accent-hi); }
  .who.me { border-color: color-mix(in srgb, var(--color-accent) 55%, transparent); background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface)); }
  .who.me h3 { color: var(--color-accent-hi); }

  .mid { margin: 26px 0; font-size: 1.125rem; line-height: 1.6; color: var(--color-ink-2); max-width: 62ch; }
  .mid strong { color: var(--color-ink); font-weight: 620; }

  .tnote { margin: 0 0 14px; font-size: 13.5px; line-height: 1.6; color: var(--color-muted); max-width: 70ch; }
  .wide { min-width: 900px; }
  .wide tbody th { white-space: nowrap; }

  .honest { max-width: 66ch; display: grid; gap: 16px; }
  .honest p { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--color-ink-2); }
  .honest strong { color: var(--color-ink); }
  .honest a { color: var(--color-accent-hi); }

  .bio { max-width: 62ch; display: grid; gap: 14px; }
  .bio p { margin: 0; font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-2); }

  @media (max-width: 860px) {
    .two, .three { grid-template-columns: minmax(0, 1fr); }
  }
</style>
