---
import BaseLayout from "./BaseLayout.astro";
import { DOCS_GROUPS, REPO_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  sourceFile?: string;
  slug?: string;
}
const { title, subtitle, description, sourceFile, slug } = Astro.props;

const all = await getCollection("docs");
const bySlug = new Map(all.map((d) => [d.data.slug, d]));
const grouped = DOCS_GROUPS.map((g) => ({
  title: g.title,
  items: g.slugs.map((s) => bySlug.get(s)).filter(Boolean),
}));
const listed = new Set(DOCS_GROUPS.flatMap((g) => g.slugs));
const rest = all.filter((d) => !listed.has(d.data.slug));
if (rest.length) grouped.push({ title: "More", items: rest });
---
<BaseLayout title={title} description={description ?? subtitle} cta={false}>
  <div class="shell wrap">
    <aside class="side" aria-label="Documentation">
      <a href="/docs/" class:list={["home", { on: !slug }]}>All documentation</a>
      {grouped.map((g) => (
        <div class="group">
          <p class="eyebrow gt">{g.title}</p>
          <ul>
            {g.items.map((d: any) => (
              <li>
                <a href={`/docs/${d.data.slug}/`} class:list={{ on: slug === d.data.slug }}>{d.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <article class="body">
      <header class="doc-head">
        <p class="eyebrow">Documentation</p>
        <h1>{title}</h1>
        {subtitle && <p class="sub">{subtitle}</p>}
        {sourceFile && SOURCE_IS_PUBLIC && (
          <p class="src">
            <a href={`${REPO_URL}/blob/main/${sourceFile}`}>{sourceFile} ↗</a>
          </p>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /* Docs stay fast and plain: a mono-labelled sidebar, a Brygada title, prose. */
  .wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 64px; align-items: start; padding-block: 56px 80px; }
  .side { position: sticky; top: 88px; max-height: calc(100vh - 104px); overflow-y: auto; padding-right: 4px; }
  .home { display: block; font-size: 14px; color: var(--yaaf-ink-2); text-decoration: none; padding: 6px 10px; border-left: 2px solid transparent; }
  .home:hover, .side li a:hover { color: var(--yaaf-accent); text-decoration: underline; text-underline-offset: 3px; }
  .home.on { color: var(--yaaf-ink); font-weight: 600; border-left-color: var(--yaaf-ink); }
  .group { margin-top: 22px; }
  .gt { margin: 0 0 6px 12px; }
  .side ul { list-style: none; margin: 0; padding: 0; }
  .side li a { display: block; font-size: 14.5px; color: var(--yaaf-ink-2); text-decoration: none; padding: 6px 10px; border-left: 2px solid transparent; }
  .side li a.on { color: var(--yaaf-ink); font-weight: 600; border-left-color: var(--yaaf-ink); }
  .doc-head { margin-bottom: 36px; padding-bottom: 24px; border-bottom: 2px solid var(--yaaf-ink); max-width: 46rem; }
  .doc-head .eyebrow { margin: 0; }
  .doc-head h1 { font-size: var(--text-h1); line-height: 1.06; margin: 14px 0 0; text-wrap: balance; }
  .sub { color: var(--yaaf-ink-2); font-size: 18px; margin: 12px 0 0; max-width: var(--measure); }
  .src { margin: 14px 0 0; font-family: var(--font-mono); font-size: 12.5px; overflow-wrap: anywhere; }
  .src a { color: var(--yaaf-accent); text-decoration: none; }
  .src a:hover { color: var(--yaaf-accent-hover); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .wrap { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 32px 64px; }
    .side { position: static; max-height: none; border: 1px solid var(--yaaf-border-strong); padding: 12px; background: var(--yaaf-surface); }
    .group { margin-top: 12px; }
    .side ul { display: flex; flex-wrap: wrap; gap: 2px 4px; }
  }
</style>
