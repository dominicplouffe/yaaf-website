---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
import { SITE, SITE_URL, REPO_URL, LICENSE } from "../site.config.mjs";

interface Props {
  title: string;
  description?: string;
  /** Set on pages that should not carry the site name suffix. */
  bare?: boolean;
  ogImage?: string;
  /** The closing call to action above the footer. Off on reference pages. */
  cta?: boolean;
  /** Home page only: the closing band is the install section and owns #start. */
  install?: boolean;
}

const { title, description = SITE.description, bare = false, ogImage = "/og.png", cta = true, install = false } = Astro.props;
const fullTitle = bare ? title : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const og = new URL(ogImage, SITE_URL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "yaaf",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  description: SITE.description,
  url: SITE_URL,
  codeRepository: REPO_URL,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- The two faces above the fold. Everything else waits for first use. -->
    <link rel="preload" href="/fonts/brygada-1918/brygada-1918-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="yaaf" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="license" content={LICENSE} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Foot cta={cta} install={install} />
    <script is:inline>
      // Copy buttons on command lines. Inline and tiny: the site loads no scripts.
      document.addEventListener("click", function (e) {
        var b = e.target.closest && e.target.closest("[data-copy]");
        if (!b || !navigator.clipboard) return;
        navigator.clipboard.writeText(b.getAttribute("data-copy")).then(function () {
          b.setAttribute("data-done", "");
          setTimeout(function () { b.removeAttribute("data-done"); }, 1400);
        });
      });
    </script>
    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 8px;
        background: var(--yaaf-ink);
        color: var(--yaaf-page);
        padding: 10px 16px;
        z-index: 100;
        font-size: 15px;
        font-weight: 600;
      }
      .skip:focus { left: 12px; }
      main:focus { outline: none; }
    </style>
  </body>
</html>
