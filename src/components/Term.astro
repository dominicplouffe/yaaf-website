---
/**
 * A terminal block.
 *
 * Takes `code` as a string rather than a slot: the Astro compiler collapses
 * the whitespace between elements in a slot, which is fatal inside <pre>.
 * Markup allowed: <b> prompt, <i> comment, <u> highlight.
 */
interface Props { label?: string; note?: string; code: string; class?: string }
const { label, note, code, class: cls = "" } = Astro.props;

const html = code
  .trim()
  .replace(/<b>/g, '<span class="p">')
  .replace(/<i>/g, '<span class="c">')
  .replace(/<u>/g, '<span class="ok">')
  .replace(/<\/[biu]>/g, "</span>");
---
<div class:list={["term", cls]}>
  {label && <div class="bar"><span class="eyebrow">{label}</span></div>}
  <pre><code set:html={html} /></pre>
  {note && <p class="note">{note}</p>}
</div>

<style>
  .term {
    margin: 0;
    background: var(--yaaf-sunken);
    border: 1px solid var(--yaaf-border-strong);
    overflow: hidden;
    min-width: 0;
  }
  .bar { padding: 9px 16px; border-bottom: 1px solid var(--yaaf-border-strong); }
  pre { margin: 0; padding: 14px 16px; overflow-x: auto; font-size: 13px; line-height: 1.75; color: var(--yaaf-ink-2); }
  .note { margin: 0; padding: 10px 16px; border-top: 1px solid var(--yaaf-border-strong); font-size: 13px; line-height: 1.6; color: var(--yaaf-muted); }
  pre :global(.c) { color: var(--yaaf-muted); }
  pre :global(.p) { color: var(--yaaf-ink); font-weight: 500; }
  pre :global(.ok) { color: var(--yaaf-good); }
</style>
