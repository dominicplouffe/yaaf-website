---
import { NAV, MORE, REPO_URL, LICENSE, LICENSE_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import Wordmark from "./Wordmark.astro";
import Button from "./Button.astro";
import Cmd from "./Cmd.astro";
import manifest from "../content/manifest.json";

interface Props { cta?: boolean }
const { cta = true } = Astro.props;
---
<footer class="foot">
  {cta && (
    <div class="shell">
      <div class="cta" id="try">
        <h2><span class="was">Yesterday you prompted.</span><br /><span class="dawn-text">Today you chair the board.</span></h2>
        <div class="cta-r">
          <p>Clone it, rehearse a whole company on scripted agents for $0, then hire one for real on your own machine.</p>
          <Cmd cmd="yaaf rehearse examples/01-your-first-hour.json" />
          <div class="btns">
            {SOURCE_IS_PUBLIC && <Button href={REPO_URL} primary>Get yaaf on GitHub</Button>}
            <Button href="/docs/creating-a-project/">Your first project</Button>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="shell">
    <div class="grid">
      <div class="about">
        <Wordmark size="1.25rem" />
        <p>The open-source harness for teams of harnesses. Build a company of AI agents and chair it from your own machine.</p>
      </div>
      <nav aria-label="Footer">
        <p class="eyebrow">Product</p>
        <ul>{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Reference">
        <p class="eyebrow">Reference</p>
        <ul>{MORE.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <div>
        <p class="eyebrow">Source</p>
        <ul>
          {SOURCE_IS_PUBLIC && <li><a href={REPO_URL}>Repository ↗</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Contributing ↗</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/issues`}>Issues ↗</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/security/advisories/new`}>Report a vulnerability ↗</a></li>}
          <li><a href={LICENSE_URL}>{LICENSE} ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="bottom">
      <span>Pre-1.0. Synced from the yaaf repository on {manifest.syncedAt}.</span>
      <span>{manifest.roles} roles · {manifest.crews} crews · {manifest.harnesses} harnesses · {manifest.providers} providers · {manifest.tests.toLocaleString("en-US")} tests</span>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: 0; }
  .cta {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 0;
    border-top: 1px solid var(--color-line);
    padding-block: 6.5rem;
  }
  .cta > * { padding-inline: var(--inset); }
  .cta h2 {
    grid-column: 1 / span 2;
    margin: 0;
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .cta h2 .was { color: var(--color-old); text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: color-mix(in srgb, var(--color-rose) 70%, transparent); }
  .cta h2 .dawn-text { display: inline-block; padding-bottom: 0.08em; }
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 70% at 85% 100%, color-mix(in srgb, var(--color-rose) 22%, transparent), transparent 70%),
      radial-gradient(40% 60% at 60% 100%, color-mix(in srgb, var(--color-gold) 16%, transparent), transparent 70%);
  }
  .cta > * { position: relative; }
  .cta-r { grid-column: 3 / span 2; display: grid; gap: 18px; align-content: start; }
  .cta-r p { margin: 0; color: var(--color-ink-2); font-size: 1.1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 0;
    border-top: 1px solid var(--color-line);
    padding-block: 3.5rem 3rem;
  }
  .grid > * { padding-inline: var(--inset); }
  .about p { margin: 14px 0 0; color: var(--color-muted); font-size: 14.5px; max-width: 30ch; }
  .eyebrow { margin: 0; }
  ul { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  a { color: var(--color-ink-2); text-decoration: none; font-size: 14.5px; }
  a:hover { color: var(--color-ink); }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px var(--inset) 28px;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-muted);
  }
  @media (max-width: 1024px) {
    .cta h2, .cta-r { grid-column: 1 / -1; }
    .grid { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) { .cta { padding-block: 4rem; } }
</style>
