---
import { NAV, MORE, REPO_URL, LICENSE, LICENSE_URL, SOURCE_IS_PUBLIC, SITE } from "../site.config.mjs";
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import manifest from "../content/manifest.json";

interface Props {
  /** The closing band above the footer. Off on reference pages. */
  cta?: boolean;
  /** The home page's band is the install section itself, and owns #start. */
  install?: boolean;
}
const { cta = true, install = false } = Astro.props;

const LINES = [
  { cmd: `git clone ${REPO_URL} && cd yaaf` },
  { cmd: "python3 -m venv .venv && .venv/bin/pip install -e ." },
  { cmd: ".venv/bin/yaaf rehearse examples/01-your-first-hour.json", note: "$0", last: true },
];
const shown = install ? LINES : LINES.slice(-1).map((l) => ({ ...l, cmd: "yaaf rehearse examples/01-your-first-hour.json" }));
const copy = shown.map((l) => l.cmd).join("\n");
---
<footer class="foot">
  {cta && (
    <section class="band carbon" id={install ? "start" : "try"} aria-labelledby="band-h">
      <div class="shell">
        <p class="eyebrow">Install</p>
        <h2 id="band-h">Yesterday you prompted. <em>Today you chair.</em></h2>
        <div class="code">
          <div class="lines" role="group" aria-label="Commands">
            {shown.map((l) => (
              <code class:list={["ln", { last: l.last }]}><span class="p" aria-hidden="true">$ </span>{l.cmd}{l.note && <span class="c">  # {l.note}</span>}</code>
            ))}
          </div>
          <button type="button" data-copy={copy} aria-label={install ? "Copy the three commands" : "Copy command"}>
            <span class="i-copy">Copy</span><span class="i-ok">Copied</span>
          </button>
        </div>
        <p class="after">
          {install
            ? <>The last line rehearses an example project end to end on scripted agents. No key, no Docker, <span class="mono">$0</span>. When you're ready for real agents, <code>yaaf up</code> starts everything and prints the address.</>
            : <>Clone it, rehearse a whole company on scripted agents for <span class="mono">$0</span>, then hire one for real on your own machine.</>}
        </p>
        <div class="btns">
          <Button href="/docs/install/" primary>Install guide</Button>
          {SOURCE_IS_PUBLIC && <Button href={REPO_URL}>Get yaaf on GitHub</Button>}
        </div>
      </div>
    </section>
  )}

  <div class="shell">
    <div class="grid">
      <div class="about">
        <a href="/" aria-label="yaaf home" class="sig"><Logo variant="signature" height={52} /></a>
        <p>{SITE.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <p class="eyebrow">Product</p>
        <ul>{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Reference">
        <p class="eyebrow">Reference</p>
        <ul>{MORE.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Source">
        <p class="eyebrow">Source</p>
        <ul>
          {SOURCE_IS_PUBLIC && <li><a href={REPO_URL}>Repository</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Contributing</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/issues`}>Issues</a></li>}
          {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/security/advisories/new`}>Report a vulnerability</a></li>}
          <li><a href={LICENSE_URL}>{LICENSE}</a></li>
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <span>{LICENSE} · pre-1.0 · synced from the yaaf repository {manifest.syncedAt}</span>
      <span>{manifest.roles} roles · {manifest.crews} crews · {manifest.harnesses} harnesses · {manifest.providers} providers · {manifest.tests.toLocaleString("en-US")} tests</span>
    </div>
  </div>
</footer>

<style>
  /* The closing band: Carbon in both themes, with the dark tokens in force. */
  .band { background: var(--yaaf-page); color: var(--yaaf-ink); padding-block: var(--yaaf-space-11); }
  .band .eyebrow { margin: 0; }
  .band h2 {
    margin: var(--yaaf-space-5) 0 0;
    font-size: clamp(2.4rem, 1.2rem + 4.6vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .band h2 em { display: block; }
  .code {
    position: relative;
    margin-top: var(--yaaf-space-8);
    max-width: 860px;
    background: var(--yaaf-surface);
    border: 1px solid var(--yaaf-border);
  }
  .lines { padding: 26px 28px; overflow-x: auto; font-size: 15px; line-height: 2; }
  .ln { display: block; white-space: pre; color: var(--yaaf-ink-2); }
  .ln.last { color: var(--yaaf-ink); }
  .p, .c { color: var(--yaaf-muted); user-select: none; }
  .code button {
    position: absolute;
    top: 10px;
    right: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    color: var(--yaaf-ink-2);
    background: var(--yaaf-surface);
    border: 1px solid var(--yaaf-border-strong);
    cursor: pointer;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }
  .code button:hover { color: var(--yaaf-ink); border-color: var(--yaaf-ink); }
  .i-ok { display: none; }
  button[data-done] .i-copy { display: none; }
  button[data-done] .i-ok { display: inline; }
  .after { margin: var(--yaaf-space-6) 0 0; max-width: 62ch; color: var(--yaaf-ink-2); }
  .after code { font-size: 0.9em; color: var(--yaaf-ink); }
  .band .btns { margin-top: var(--yaaf-space-7); }
  @media (max-width: 760px) {
    .band { padding-block: var(--yaaf-space-10); }
    .lines { padding: 48px 18px 20px; font-size: 13.5px; }
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px 32px;
    padding-block: var(--yaaf-space-10) var(--yaaf-space-9);
  }
  .sig { display: inline-block; }
  .about p { margin: 18px 0 0; color: var(--yaaf-ink-2); font-size: 15px; max-width: 26ch; }
  .eyebrow { margin: 0; }
  ul { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 4px; }
  li a { display: inline-block; padding: 4px 0; color: var(--yaaf-ink-2); text-decoration: none; font-size: 15px; transition: color var(--fast) var(--ease); }
  li a:hover { color: var(--yaaf-accent); text-decoration: underline; text-underline-offset: 3px; }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding-block: 18px 32px;
    border-top: 1px solid var(--yaaf-border-strong);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--yaaf-muted);
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
</style>
