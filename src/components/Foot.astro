---
import { NAV, REPO_URL, LICENSE, LICENSE_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import Wordmark from "./Wordmark.astro";
import manifest from "../content/manifest.json";
---
<footer class="foot">
  <div class="shell grid">
    <div>
      <Wordmark size="1.1rem" />
      <p class="tag">Yet another agent framework? No — the org chart, the boardroom and the accounting department around the agents you already have.</p>
      <p class="meta">
        <span class="chip"><span class="dot" aria-hidden="true"></span>Pre-1.0 · actively developed</span>
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow">Site</p>
      <ul>
        <li><a href="/">Home</a></li>
        {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="eyebrow">Source</p>
      <ul>
        {SOURCE_IS_PUBLIC && <li><a href={REPO_URL}>Repository ↗</a></li>}
        {SOURCE_IS_PUBLIC && <li><a href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Contributing ↗</a></li>}
        <li><a href={LICENSE_URL}>{LICENSE} ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="shell bottom">
    <span>Content synced from the yaaf repository on {manifest.syncedAt}.</span>
    <span>{manifest.roles} roles · {manifest.crews} crews · {manifest.examples} examples</span>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--color-line); margin-top: 96px; padding-block: 48px 28px; }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }
  .tag { color: var(--color-muted); font-size: 14px; margin: 12px 0 16px; max-width: 44ch; }
  .meta { margin: 0; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--color-ink-2);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 5px 11px;
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-warning); }
  ul { list-style: none; margin: 12px 0 0; padding: 0; }
  li + li { margin-top: 7px; }
  a { color: var(--color-ink-2); text-decoration: none; font-size: 14px; }
  a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
  }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .grid > :first-child { grid-column: 1 / -1; }
  }
</style>
