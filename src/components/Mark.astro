---
/** The app tile, inline so it can sit next to the wordmark without a request. */
interface Props { size?: number; class?: string }
const { size = 24, class: cls = "" } = Astro.props;
const id = `m${Math.random().toString(36).slice(2, 8)}`;
---
<svg width={size} height={size} viewBox="0 0 64 64" class={cls} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a93ea"></stop>
      <stop offset="1" stop-color="#2f78d4"></stop>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="14" fill={`url(#${id})`}></rect>
  <g fill="none" stroke="#fff" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 15 L33 37"></path>
    <path d="M46 15 L26 49"></path>
  </g>
</svg>
