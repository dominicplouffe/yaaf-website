---
/** One listing in a grid: what it is, what it does, what it can touch. */
import { canDo, hrefOf, latest, type Listing } from "../lib/marketplace";
interface Props { listing: Listing }
const { listing } = Astro.props;
const v = latest(listing);
const runs = v.can_do.includes("bash");
---
<a class="lcard" href={hrefOf(listing)} data-kind={listing.kind} data-category={listing.category}
  data-text={`${listing.name} ${listing.summary} ${listing.id} ${listing.domains.join(" ")}`.toLowerCase()}>
  <p class="top">
    <span class="kind">{listing.kind === "project" ? "Project" : "Role"}</span>
    {listing.tier === "official" && <span class="tag off">official</span>}
    {v.has_receipt && <span class="tag ran">ran for real</span>}
  </p>
  <h3>{listing.name}</h3>
  <p class="id">{listing.id}</p>
  <p class="sum">{listing.summary}</p>
  <p class="meta">
    {listing.kind === "project" && <span>{v.roles.length} roles</span>}
    <span class:list={{ warn: runs }}>{canDo(v.can_do).join(" · ")}</span>
    {v.keys.length > 0 && <span>Needs {v.keys.join(", ")}</span>}
    {v.inputs.length > 0 && <span>Asks {v.inputs.length} {v.inputs.length === 1 ? "question" : "questions"}</span>}
  </p>
</a>

<style>
  .lcard { display: flex; flex-direction: column; gap: 8px; padding: 18px; background: var(--color-surface); border: 1px solid var(--color-line); color: inherit; text-decoration: none; transition: border-color 0.2s var(--ease); min-width: 0; }
  .lcard:hover, .lcard:focus-visible { border-color: var(--color-line-strong); }
  .lcard[hidden] { display: none; }
  .top { display: flex; gap: 6px; flex-wrap: wrap; margin: 0; }
  .kind, .tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; border: 1px solid var(--color-line); padding: 2px 7px; color: var(--color-muted); }
  .tag.off { color: var(--color-gold); border-color: color-mix(in srgb, var(--color-gold) 40%, transparent); }
  .tag.ran { color: var(--color-mint); border-color: color-mix(in srgb, var(--color-mint) 40%, transparent); }
  h3 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; color: var(--color-ink); }
  .id { margin: -4px 0 0; font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); }
  .sum { margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--color-ink-2); }
  .meta { margin: auto 0 0; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: var(--color-muted); }
  .meta .warn { color: var(--color-warning); }
</style>
