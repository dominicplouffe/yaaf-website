---
import { NAV, REPO_URL, SOURCE_IS_PUBLIC } from "../site.config.mjs";
import Logo from "./Logo.astro";

const here = Astro.url.pathname;
const isOn = (href: string) => here === href || (href !== "/" && here.startsWith(href));
---
<header class="hdr">
  <div class="shell inner">
    <a href="/" class="brand" aria-label="yaaf home"><Logo height={30} /></a>

    <nav class="links" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} class:list={{ on: isOn(item.href) }} aria-current={isOn(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
      {SOURCE_IS_PUBLIC && <a href={REPO_URL} rel="noopener">GitHub</a>}
    </nav>

    <a class="btn small cta" href="/#start">Rehearse for <span class="mono">$0</span></a>

    <details class="menu">
      <summary aria-label="Menu"><span></span><span></span></summary>
      <nav class="panel" aria-label="Mobile">
        {NAV.map((item) => <a href={item.href} class:list={{ on: isOn(item.href) }} aria-current={isOn(item.href) ? "page" : undefined}>{item.label}</a>)}
        {SOURCE_IS_PUBLIC && <a href={REPO_URL} rel="noopener">GitHub</a>}
        <a href="/#start">Rehearse for $0</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--yaaf-page);
    border-bottom: 1px solid var(--yaaf-border);
  }
  .inner { display: flex; align-items: center; gap: 32px; height: 72px; }
  .brand { display: flex; align-items: center; flex: none; padding: 4px 0; }
  .links { display: flex; align-items: center; gap: 4px; margin-inline: auto; }
  .links a {
    color: var(--yaaf-ink-2);
    text-decoration: none;
    font-size: 15px;
    font-weight: 400;
    padding: 8px 12px;
    transition: color var(--fast) var(--ease);
  }
  .links a:hover, .links a.on { color: var(--yaaf-ink); }
  .links a.on { text-decoration: underline; text-underline-offset: 8px; text-decoration-thickness: 2px; text-decoration-color: var(--yaaf-ink); }
  .cta { flex: none; }
  .cta .mono { font-weight: 500; }

  .menu { display: none; margin-left: auto; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--yaaf-ink);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 18px; height: 1.5px; background: var(--yaaf-ink); transition: transform var(--base) var(--ease); }
  .menu[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .menu:not([open]) .panel { display: none; }
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 72px;
    background: var(--yaaf-page);
    border-bottom: 2px solid var(--yaaf-ink);
    display: grid;
    padding: 4px var(--gutter) 20px;
  }
  .panel a {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--yaaf-ink);
    text-decoration: none;
    font-size: 1.5rem;
    padding: 12px 0;
    border-bottom: 1px solid var(--yaaf-border);
  }
  .panel a.on { font-style: italic; }

  @media (max-width: 1140px) {
    .links, .cta { display: none; }
    .menu { display: block; }
  }
</style>
