---
/**
 * The thesis, drawn. The chair on top, CEO under them, desks under the CEO.
 * CSS connectors rather than SVG so the boxes can hold real, variable-length
 * role names without anything overflowing.
 */
interface Team {
  name: string;
  role: string;
  employees: string[];
  lead?: string | null;
  challenge?: boolean;
  /** What the seat runs on — model and harness — when the chart is making that point. */
  runsOn?: string;
}
interface Props {
  ceo: string;
  ceoRole?: string;
  teams: Team[];
  chairman?: string | false;
  compact?: boolean;
  ceoRunsOn?: string;
}
const { ceo, ceoRole, teams, chairman = "You, the chair", compact = false, ceoRunsOn } = Astro.props;
---
<div class:list={["org", { compact }]}>
  {chairman && (
    <>
      <div class="row">
        <div class="node chair">
          <span class="eyebrow">Human</span>
          <strong>{chairman}</strong>
        </div>
      </div>
      <div class="stem" aria-hidden="true"></div>
    </>
  )}

  <div class="row">
    <div class="node ceo">
      <span class="eyebrow">Executive</span>
      <strong>{ceo}</strong>
      {ceoRole && <span class="sub">{ceoRole}</span>}
      {ceoRunsOn && <span class="on">{ceoRunsOn}</span>}
    </div>
  </div>

  {teams.length > 0 && (
    <>
      <div class="stem" aria-hidden="true"></div>
      {/* A rail only makes sense when it forks. One desk gets the stem alone. */}
      {teams.length > 1 && (
        <div class="branch" aria-hidden="true" style={`--n:${teams.length}`}>
          {teams.map(() => <span></span>)}
        </div>
      )}
      <div class="teams" style={`--n:${teams.length}`}>
        {teams.map((t) => (
          <div class:list={["node team", { challenge: t.challenge }]}>
            <span class="eyebrow">{t.name}</span>
            <strong>{t.role}</strong>
            {t.runsOn && <span class="on">{t.runsOn}</span>}
            {t.employees.length > 0 && (
              <span class="people">
                {t.employees.map((e, i) => (
                  <>
                    {i > 0 && <span class="sep">·</span>}
                    <span class:list={{ lead: e === t.lead }}>{e}</span>
                  </>
                ))}
              </span>
            )}
          </div>
        ))}
      </div>
    </>
  )}
</div>

<style>
  /* Seats by role, joined with ink lines. No faces. */
  .org { display: flex; flex-direction: column; align-items: center; width: 100%; }
  .row { display: flex; justify-content: center; width: 100%; }

  .node {
    background: var(--yaaf-surface);
    border: 1px solid var(--yaaf-ink);
    padding: 12px 14px;
    text-align: center;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .node strong { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; line-height: 1.2; color: var(--yaaf-ink); }
  .node .sub { font-family: var(--font-mono); font-size: 12px; color: var(--yaaf-muted); }
  .node .on { align-self: center; font-family: var(--font-mono); font-size: 12px; color: var(--yaaf-ink-2); border: 1px solid var(--yaaf-border-strong); padding: 0 7px; margin-top: 3px; max-width: 100%; }

  .chair { border-width: 2px; }
  .ceo { min-width: min(100%, 220px); }
  /* A critic's seat is drawn dashed: it sits on the team and answers past it. */
  .team.challenge { border-style: dashed; }

  .people { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; font-size: 13px; color: var(--yaaf-muted); margin-top: 2px; }
  .people .lead { color: var(--yaaf-ink-2); font-weight: 600; }

  .stem { width: 1px; height: 20px; background: var(--yaaf-ink); }

  /* One horizontal rail with a drop into each team box. */
  .branch { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); width: 100%; height: 20px; }
  .branch span { position: relative; }
  .branch span::before { content: ""; position: absolute; top: 0; left: 50%; width: 1px; height: 100%; background: var(--yaaf-ink); }
  .branch span::after { content: ""; position: absolute; top: 0; height: 1px; background: var(--yaaf-ink); left: 50%; right: 0; }
  .branch span:last-child::after { right: 50%; left: 0; }
  .branch span:not(:first-child):not(:last-child)::after { left: 0; right: 0; }
  .branch span:first-child::after { left: 50%; right: 0; }

  .teams { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 10px; width: 100%; }

  @media (max-width: 700px) {
    .branch { display: none; }
    .teams { grid-template-columns: 1fr 1fr; gap: 8px; }
    .org > .stem:last-of-type { height: 14px; }
  }
  @media (max-width: 420px) {
    .teams { grid-template-columns: 1fr; }
  }
</style>
