---
/**
 * A block of a page: a hairline across the shell, then a section mark
 * ("§ The rules"), a headline and at most one short intro. Content goes in
 * the slot. A title may carry <em> for the one ink-italic word.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  id?: string;
  first?: boolean;
  class?: string;
}
const { eyebrow, title, lede, id, first = false, class: cls = "" } = Astro.props;
---
<section id={id} class:list={["sec", cls, { first }]}>
  <div class="shell">
    <div class="sec-in">
      {(eyebrow || title) && (
        <header class="head">
          {eyebrow && <p class="eyebrow">§ {eyebrow}</p>}
          {title && <h2 set:html={title} />}
          {lede && <p class="lede" set:html={lede} />}
        </header>
      )}
      <slot />
    </div>
  </div>
</section>
