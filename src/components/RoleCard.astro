---
interface Props {
  role: {
    slug: string;
    name: string;
    category: string;
    domains: string[];
    description: string;
    model: string;
    effort: string;
    is_ceo_role: boolean;
    tool_permissions: Record<string, boolean>;
    secret_scopes: string[];
    system_prompt: string;
  };
  open?: boolean;
}
const { role, open = false } = Astro.props;
const tools = Object.entries(role.tool_permissions)
  .filter(([, on]) => on)
  .map(([k]) => k.replace(/_/g, " "));
const model = role.model.replace(/^claude-/, "").replace(/-\d{8}$/, "");
---
<article class="role" data-category={role.category} data-domains={role.domains.join(" ")}>
  <header>
    <div class="top">
      <h3>{role.name}</h3>
      {role.is_ceo_role && <span class="exec">executive</span>}
    </div>
    <p class="slug">{role.slug}</p>
  </header>

  <p class="desc">{role.description}</p>

  <dl class="specs">
    <div><dt>Category</dt><dd class={`cat c-${role.category}`}>{role.category}</dd></div>
    <div><dt>Model</dt><dd>{model}</dd></div>
    <div><dt>Effort</dt><dd>{role.effort}</dd></div>
  </dl>

  <p class="tools">
    {tools.map((t) => <span class="tool">{t}</span>)}
    {role.secret_scopes.map((s) => <span class="tool sec">{s}</span>)}
  </p>

  <details open={open}>
    <summary>System prompt</summary>
    <pre>{role.system_prompt}</pre>
  </details>
</article>

<style>
  .role {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .top { display: flex; align-items: baseline; gap: 8px; justify-content: space-between; }
  h3 { margin: 0; font-size: 15.5px; font-weight: 640; letter-spacing: -0.01em; }
  .exec {
    flex: none;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-accent-hi);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-radius: 999px;
    padding: 3px 8px;
  }
  .slug { margin: 3px 0 0; font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); }
  .desc { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--color-ink-2); }

  .specs { display: flex; flex-wrap: wrap; gap: 14px; margin: 0; }
  .specs div { display: flex; flex-direction: column; gap: 2px; }
  dt {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  dd { margin: 0; font-size: 12.5px; font-family: var(--font-mono); color: var(--color-ink-2); }
  .cat { text-transform: capitalize; }
  .c-challenge { color: var(--color-accent-2); }
  .c-leadership { color: var(--color-accent-hi); }

  .tools { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; }
  .tool {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 2px 8px;
  }
  .tool.sec { color: var(--color-warning); border-color: color-mix(in srgb, var(--color-warning) 35%, transparent); }

  details { margin-top: auto; border-top: 1px solid var(--color-line-2); padding-top: 10px; }
  summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-muted);
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "▸ "; color: var(--color-accent); }
  details[open] summary::before { content: "▾ "; }
  summary:hover { color: var(--color-ink-2); }
  pre {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.65;
    color: var(--color-ink-2);
    white-space: pre-wrap;
    max-height: 340px;
    overflow-y: auto;
    background: var(--color-page);
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-control);
    padding: 11px 12px;
  }
</style>
