---
interface Props {
  role: {
    slug: string;
    name: string;
    category: string;
    domains: string[];
    description: string;
    model?: string;
    effort: string;
    is_ceo_role: boolean;
    tool_permissions: Record<string, boolean>;
    secret_scopes: string[];
    system_prompt: string;
  };
  open?: boolean;
}
const { role, open = false } = Astro.props;
const tools = Object.entries(role.tool_permissions)
  .filter(([, on]) => on)
  .map(([k]) => k.replace(/_/g, " "));
// Since yaaf#79 a role carries no model: the install picks the model and the
// harness for each seat. A role synced from before that still shows its own.
const CLASS: Record<string, string> = { "@frontier": "Frontier", "@balanced": "Balanced", "@fast": "Fast" };
const model = role.model ? (CLASS[role.model] ?? role.model.replace(/^claude-/, "").replace(/-\d{8}$/, "")) : null;
---
<article class="role" data-category={role.category} data-domains={role.domains.join(" ")}>
  <header>
    <div class="top">
      <h3>{role.name}</h3>
      {role.is_ceo_role && <span class="exec">executive</span>}
    </div>
    <p class="slug">{role.slug}</p>
  </header>

  <p class="desc">{role.description}</p>

  <dl class="specs">
    <div><dt>Category</dt><dd class="cat">{role.category}</dd></div>
    {model && <div><dt>{role.model! in CLASS ? "Model class" : "Model"}</dt><dd>{model}</dd></div>}
    <div><dt>Effort</dt><dd>{role.effort}</dd></div>
  </dl>

  <p class="tools">
    {tools.map((t) => <span class="tool">{t}</span>)}
    {role.secret_scopes.map((s) => <span class="tool sec">{s}</span>)}
  </p>

  <details open={open}>
    <summary>System prompt</summary>
    <pre tabindex="0">{role.system_prompt}</pre>
  </details>
</article>

<style>
  /* A role, by name. Name in Brygada, duties in Public Sans, and everything the
     server binds it to (class, effort, tools, secret scopes) in mono. No avatar. */
  .role {
    background: var(--yaaf-surface);
    border: 1px solid var(--yaaf-border);
    border-top: 2px solid var(--yaaf-ink);
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .top { display: flex; align-items: baseline; gap: 8px; justify-content: space-between; }
  h3 { margin: 0; font-size: 1.375rem; line-height: 1.2; }
  .exec {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--yaaf-surface);
    background: var(--yaaf-ink);
    padding: 1px 7px;
  }
  .slug { margin: 4px 0 0; font-family: var(--font-mono); font-size: 12.5px; color: var(--yaaf-muted); }
  .desc { margin: 0; font-size: 15px; line-height: 1.55; color: var(--yaaf-ink-2); }

  .specs { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding-top: 12px; border-top: 1px solid var(--yaaf-border); }
  .specs div { display: flex; flex-direction: column; gap: 1px; }
  dt { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yaaf-muted); }
  dd { margin: 0; font-size: 13px; font-family: var(--font-mono); color: var(--yaaf-ink); }
  .cat { text-transform: capitalize; }

  .tools { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; }
  .tool { font-family: var(--font-mono); font-size: 12px; color: var(--yaaf-ink-2); border: 1px solid var(--yaaf-border-strong); padding: 1px 7px; }
  /* A secret scope is a warning-level grant, and says so in words as well as colour. */
  .tool.sec { color: var(--yaaf-warning); border-color: var(--yaaf-warning); }
  .tool.sec::before { content: "secret: "; }

  details { margin-top: auto; border-top: 1px solid var(--yaaf-border); padding-top: 10px; }
  summary { cursor: pointer; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yaaf-accent); list-style: none; padding: 4px 0; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "+ "; }
  details[open] summary::before { content: "− "; }
  summary:hover { color: var(--yaaf-accent-hover); }
  pre {
    margin: 10px 0 0;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--yaaf-ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: 340px;
    overflow-y: auto;
    background: var(--yaaf-sunken);
    padding: 12px 14px;
  }
</style>
