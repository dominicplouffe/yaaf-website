---
import { Image } from "astro:assets";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Crop to the top of a tall full-page capture instead of showing all of it. */
  crop?: number;
  /** Crop to an aspect ratio from the top instead, e.g. "16 / 10". Scales with the width. */
  ratio?: string;
  priority?: boolean;
}
const { src, alt, caption, crop, ratio, priority = false } = Astro.props;
const style = [crop && `--crop:${crop}px`, ratio && `aspect-ratio:${ratio}`].filter(Boolean).join(";") || undefined;
---
<figure class="shot">
  <div class="frame" style={style}>
    <Image src={src} alt={alt} widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 900px" loading={priority ? "eager" : "lazy"} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { margin: 0; }
  .frame {
    position: relative;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-page);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), 0 40px 120px -40px color-mix(in srgb, var(--color-accent) 35%, transparent);
    max-height: var(--crop, none);
  }
  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  figcaption { color: var(--color-muted); font-size: 14px; margin-top: 14px; line-height: 1.55; max-width: 64ch; }
</style>
