---
/**
 * A product screenshot in a plain ruled frame: no device chrome, no tilt, no
 * glow. Pass `dark` to show a second capture when the reader's scheme is
 * dark; only the one that is displayed is fetched.
 */
import { Image } from "astro:assets";
interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  caption?: string;
  /** Crop to an aspect ratio from the top, e.g. "16 / 10". */
  ratio?: string;
  priority?: boolean;
  sizes?: string;
}
const { src, dark, alt, caption, ratio, priority = false, sizes = "(max-width: 1100px) 100vw, 1040px" } = Astro.props;
const common = { alt, widths: [640, 960, 1280, 1600], sizes, loading: priority ? ("eager" as const) : ("lazy" as const) };
---
<figure class="shot">
  <div class:list={["frame", { paired: !!dark }]} style={ratio ? `aspect-ratio:${ratio}` : undefined}>
    <Image src={src} class="on-light" {...common} />
    {dark && <Image src={dark} class="on-dark" {...common} />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot { margin: 0; }
  .frame { border: 1px solid var(--yaaf-border-strong); overflow: hidden; background: var(--yaaf-surface); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  .frame :global(.on-dark) { display: none; }
  @media (prefers-color-scheme: dark) {
    .frame.paired :global(.on-light) { display: none; }
    .frame.paired :global(.on-dark) { display: block; }
  }
  figcaption { color: var(--yaaf-muted); font-family: var(--font-mono); font-size: 12.5px; margin-top: 12px; line-height: 1.55; max-width: 46em; }
</style>
