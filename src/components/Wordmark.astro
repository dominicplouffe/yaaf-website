---
/** The product sets the brand as y<span>aa</span>f. Keep it exactly. */
interface Props { size?: string; class?: string }
const { size = "1.25rem", class: cls = "" } = Astro.props;
---
<span class={`wordmark ${cls}`} style={`font-size:${size}`}>y<span>aa</span>f</span>
<style>
  .wordmark {
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    line-height: 1;
  }
  .wordmark > span { color: var(--color-accent-hi); }
</style>
