---
/**
 * One of the brand's twelve line icons (src/assets/brand/icons): 1.75 stroke
 * on a 24px grid, square caps, drawn in the current text colour. Decorative
 * by default; pass `label` when the icon is the only thing saying it.
 */
const files = import.meta.glob<string>("../assets/brand/icons/*.svg", { query: "?raw", import: "default", eager: true });
const ICONS = Object.fromEntries(Object.entries(files).map(([p, s]) => [p.split("/").pop()!.replace(".svg", ""), s]));

interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 24, label, class: cls = "" } = Astro.props;
const src = ICONS[name];
if (!src) throw new Error(`no brand icon named "${name}" (have: ${Object.keys(ICONS).join(", ")})`);
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"';
const svg = src
  .replace(/ width="24" height="24"/, ` width="${size}" height="${size}" class="icon ${cls}" focusable="false" ${a11y}`)
  .replace(/ color="#[0-9A-Fa-f]{6}"/, "");
---
<Fragment set:html={svg} />
