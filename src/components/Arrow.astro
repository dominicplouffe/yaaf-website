---
/** The arrow every button and card link ends on. */
interface Props { external?: boolean }
const { external = false } = Astro.props;
---
{external ? (
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 11L11 5M6 5h5v5" /></svg>
) : (
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4" /></svg>
)}
