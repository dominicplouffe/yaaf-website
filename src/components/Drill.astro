---
/**
 * A real fire-drill report, as `yaaf rehearse` printed it on the last sync.
 *
 * The text is the drill's own, never edited here: this component only colours
 * it, and can leave out whole sections so a page shows the part it is about.
 * A section is a line that starts in column zero; everything indented under it
 * belongs to it. Pass `only` with the leading words of the headings to keep.
 */
interface Props {
  report: string;
  only?: string[];
  label?: string;
  note?: string;
  class?: string;
}
const { report, only, label, note, class: cls = "" } = Astro.props;

const lines = report.replace(/\s+$/, "").split("\n");
const title = lines[0] ?? "";
// Skip the title and its rule; the rest is blocks headed by a column-zero line.
const blocks: { head: string; body: string[] }[] = [];
for (const line of lines.slice(2)) {
  if (line && !/^\s/.test(line)) blocks.push({ head: line, body: [] });
  else if (blocks.length) blocks[blocks.length - 1].body.push(line);
}
const kept = only ? blocks.filter((b) => only.some((o) => b.head.startsWith(o))) : blocks;

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const paint = (line: string) => {
  const e = esc(line);
  if (/^\s*✓/.test(line)) return e.replace("✓", '<span class="ok">✓</span>').replace(/(beat \d+)$/, '<span class="c">$1</span>');
  if (/^\s*!/.test(line)) return e.replace("!", '<span class="warn">!</span>');
  if (/^\s*[–·]/.test(line)) return `<span class="c">${e}</span>`;
  return e;
};
/**
 * One block per line, with a hanging indent as deep as the line's own text
 * starts — its leading spaces, plus the marker when it has one — so a long
 * line that wraps on a narrow screen continues under itself, not at the margin.
 */
const line = (raw: string, html: string) => {
  const lead = raw.match(/^ */)![0].length;
  const ind = lead + (/^ *[✓!–·] /.test(raw) ? 2 : 0);
  return `<span class="ln" style="--i:${ind}">${html || " "}</span>`;
};
const html = kept
  .map((b) => [line(b.head, `<span class="h">${esc(b.head)}</span>`), ...b.body.map((l) => line(l, paint(l)))])
  .map((ls) => { while (ls.length && ls[ls.length - 1].endsWith('"> </span>')) ls.pop(); return ls.join(""); })
  .join(line("", ""));
---
<figure class:list={["drill", cls]}>
  <div class="bar">
    <span class="eyebrow">{label ?? "yaaf rehearse"}</span>
    <span class="t">{title.replace(/^Fire drill — /, "")}</span>
  </div>
  <pre><code set:html={html} /></pre>
  {note && <figcaption>{note}</figcaption>}
</figure>

<style>
  .drill {
    margin: 0;
    background: #0a0a0a;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 9px 14px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .t { font-family: var(--font-mono); font-size: 11px; color: var(--color-muted); }
  pre {
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.75;
    color: var(--color-ink-2);
    /* Wrap rather than scroll: a refusal's sentence is the part worth reading,
       and it is the line most likely to run past the box. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  pre :global(.ln) { display: block; padding-left: calc(var(--i, 0) * 1ch); text-indent: calc(var(--i, 0) * -1ch); }
  pre :global(.h) { color: var(--color-ink); font-weight: 700; }
  pre :global(.ok) { color: var(--color-good); }
  pre :global(.warn) { color: var(--color-warning); font-weight: 700; }
  pre :global(.c) { color: var(--color-muted); }
  figcaption {
    padding: 10px 16px;
    border-top: 1px solid var(--color-line-2);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-muted);
  }
</style>
